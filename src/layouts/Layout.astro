---
import '~/styles/global.css';
import Header from '~/components/header.astro';
import Footer from '~/components/footer.astro';
import KeyboardNav from '~/components/keyboard.astro';
import VimIndicator from '~/components/vim-indicator.astro';
import Branches from '~/components/branches.astro';
import BreadcrumbPill from '~/components/breadcrumb-pill.astro';
import CatCursor from '~/components/cat-cursor.astro';
import CursorEffects from '~/components/cursor-effects.astro';
import SelectionBloom from '~/components/selection-bloom.astro';

export interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const ogImage = new URL(image ?? `/og/${ogSlug}.png`, Astro.site).href;
const pageTitle = `${title} · pwn`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="mask-icon" href="/favicon-transparent.svg" color="#191724" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="pwnwriter" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${title} — pwnwriter.me`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap" rel="stylesheet" />

		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
		/>

		<script is:inline>
			var theme = localStorage.getItem('theme');
			if (theme && theme !== 'system') {
				document.documentElement.classList.add(theme);
			}
		</script>

		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="ba6c60e5-68de-45c5-b4a9-6520b565d5f7"
		></script>
	</head>
	<body class="flex min-h-screen flex-col">
		<Header title={title} />
		<div class="h-xl"></div>

		<main class="relative flex-1">
			<slot />
		</main>

		<div class="h-xl"></div>
		<Footer />

		<div class="edge-blur edge-blur--top" aria-hidden="true">
			<div></div>
			<div></div>
			<div></div>
		</div>
		<div class="edge-blur edge-blur--bottom" aria-hidden="true">
			<div></div>
			<div></div>
			<div></div>
		</div>

		<BreadcrumbPill />
		<KeyboardNav />
		<VimIndicator />
		<Branches />
		<CatCursor />
		<CursorEffects />
		<SelectionBloom />
	</body>
</html>

<style>
	/* progressive edge blur: content softly blurs + fades toward the top and
	   bottom of the viewport. three stacked layers give a graduated falloff
	   (light blur across the whole band, heavier blur concentrated at the edge). */
	.edge-blur {
		position: fixed;
		left: 0;
		right: 0;
		z-index: 10;
		height: 160px;
		pointer-events: none;
	}

	.edge-blur > div {
		position: absolute;
		inset: 0;
	}

	.edge-blur--top {
		top: 0;
	}

	.edge-blur--bottom {
		bottom: 0;
		height: 120px;
	}

	/* --- top edge: strongest at the very top, easing to sharp below --- */
	.edge-blur--top > div:nth-child(1) {
		backdrop-filter: blur(2.5px);
		-webkit-backdrop-filter: blur(2.5px);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
	}

	.edge-blur--top > div:nth-child(2) {
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 58%);
		mask-image: linear-gradient(to bottom, #000 0%, transparent 58%);
	}

	.edge-blur--top > div:nth-child(3) {
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 32%);
		mask-image: linear-gradient(to bottom, #000 0%, transparent 32%);
	}

	/* --- bottom edge: mirror of the top --- */
	.edge-blur--bottom > div:nth-child(1) {
		backdrop-filter: blur(2.5px);
		-webkit-backdrop-filter: blur(2.5px);
		-webkit-mask-image: linear-gradient(to top, #000 0%, transparent 100%);
		mask-image: linear-gradient(to top, #000 0%, transparent 100%);
	}

	.edge-blur--bottom > div:nth-child(2) {
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		-webkit-mask-image: linear-gradient(to top, #000 0%, transparent 58%);
		mask-image: linear-gradient(to top, #000 0%, transparent 58%);
	}

	.edge-blur--bottom > div:nth-child(3) {
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		-webkit-mask-image: linear-gradient(to top, #000 0%, transparent 32%);
		mask-image: linear-gradient(to top, #000 0%, transparent 32%);
	}

	@media (max-width: 640px) {
		.edge-blur--top {
			height: 110px;
		}

		.edge-blur--bottom {
			height: 88px;
		}
	}
</style>
