---
import Layout from '~/layouts/Layout.astro';
import '~/styles/writing.css';
import Wrapper from '~/components/wrapper.astro';
import Prose from '~/components/prose.astro';
import { Image } from 'astro:assets';
import type { Post } from '~/content/config';
import { formatDate } from '~/lib/utils';

type Props = {
	frontmatter: Post;
	body?: string;
};

const { title, pubDate, modDate, description, cover, tags } =
	Astro.props.frontmatter;

const words = Astro.props.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));

const formattedPubDate = formatDate(pubDate);
const formattedModDate = formatDate(modDate);
---

<Layout {title} {description}>
	<Wrapper>
		<article class="writing-note">
			<header class="writing-head">
				<h1>{title}</h1>
				<p class="writing-meta meta">
					<time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
					{
						formattedModDate !== formattedPubDate && (
							<span>· edited {formattedModDate}</span>
						)
					}
					<span>· {readingTime} min read</span>
					{
						tags.map((tag: string, i: number) => (
							<span>
								{i === 0 && '· '}
								<a href={`/notes/tags/${tag}`}>#{tag}</a>
							</span>
						))
					}
				</p>
				{
					cover && cover.src && (
						<figure class="writing-cover">
							<Image src={cover.src} alt={cover.alt} />
						</figure>
					)
				}
			</header>

			<div class="writing-copy">
				<Prose>
					<slot />
				</Prose>
			</div>
		</article>
	</Wrapper>
</Layout>
