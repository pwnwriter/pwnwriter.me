---
import Layout from "~/layouts/Layout.astro";
import { projects } from "~/data/projects";
import { recognition } from "~/data/recognition";
import { photos } from "~/data/photos";
import { highlights, nixpkgs } from "~/data/oss";
---

<Layout
  title="Work"
  description="Projects, open-source contributions, and recognition."
  ><div class="shell">
    <header class="page-head">
      <p class="eyebrow">Selected work / 2022 , now</p><h1>
        Built out of curiosity.
      </h1><p class="page-lede">
        Tools, interfaces, and experiments. Some shipped, some retired. All
        taught me something.
      </p>
    </header>
    <div class="project-grid">
      {
        projects.map((project, i) => {
          const cover = project.cover ?? project.media[0];
          return (
            <article class="project" id={project.slug}>
              <>
                <div class="project-media">
                  {cover ? (
                    cover.kind === "video" ? (
                      <video
                        controls
                        preload="none"
                        poster={cover.poster}
                        aria-label={`${project.name} demo`}
                      >
                        <source src={cover.src} type="video/mp4" />
                      </video>
                    ) : (
                      <img
                        src={cover.src}
                        alt={cover.alt ?? project.name}
                        loading="lazy"
                      />
                    )
                  ) : (
                    <div class="project-placeholder">
                      <span>∑</span>
                      <p>{project.name}</p>
                    </div>
                  )}
                </div>
                <div class="project-top">
                  <>
                    <h2>{project.name}</h2>
                    <span class="meta">{project.status ?? project.year}</span>
                  </>
                </div>
                <p>{project.summary}</p>
                <details class="project-details">
                  <summary>Inside the project <span aria-hidden="true">+</span></summary>
                  <p>{project.blurb}</p>
                  {project.highlights && (
                    <ul>
                      {project.highlights.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}
                  {project.tech.length > 0 && (
                    <p class="tech">{project.tech.join(" / ")}</p>
                  )}
                  <div class="project-links">
                    {project.repo && <a href={project.repo}>Source ↗</a>}
                    {project.demo && <a href={project.demo}>Visit ↗</a>}
                    {project.readMore && (
                      <a href={project.readMore}>Write-up →</a>
                    )}
                    {project.reddit && (
                      <a href={project.reddit}>Discussion ↗</a>
                    )}
                  </div>
                  {project.media.slice(1).map((media) =>
                    media.kind === "image" ? (
                      <img
                        class="extra-media"
                        src={media.src}
                        alt={media.alt ?? project.name}
                        loading="lazy"
                      />
                    ) : (
                      <video
                        class="extra-media"
                        controls
                        preload="none"
                        poster={media.poster}
                      >
                        <source src={media.src} type="video/mp4" />
                      </video>
                    ),
                  )}
                </details>
              </>
            </article>
          );
        })
      }
    </div>
    <section class="section-block">
      <div class="section-head">
        <h2>Open source / a shared effort</h2><a
          href="https://github.com/pulls?q=is%3Apr+author%3Apwnwriter"
          >All contributions ↗</a>
      </div><div class="contributions">
        {
          highlights.map((item) => (
            <a href={item.url}>
              <>
                <span class="contribution-title">
                  {item.repo}
                  <span>↗</span>
                </span>
                <p>{item.what}</p>
                <span class="meta">
                  {item.lang}
                  {item.count ? ` / ${item.count} merged PRs` : ""}
                </span>
              </>
            </a>
          ))
        }
      </div><p class="nixpkgs">
        Also in nixpkgs: {
          nixpkgs.map((pkg, i) => (
            <span>
              {i > 0 ? " · " : ""}
              <a href={pkg.url}>{pkg.name}</a>
            </span>
          ))
        }
      </p>
    </section>
    <section class="section-block" id="recognition">
      <div class="section-head"><h2>Recognition / along the way</h2></div><div
        class="recognition-list"
      >
        {
          recognition.map((item) => {
            const pic = item.photo ?? item.image;
            return (
              <article>
                {pic && (
                  <a href={pic.src}>
                    <img
                      src={pic.src}
                      alt={pic.alt}
                      loading="lazy"
                      class:list={{ letter: !!item.image }}
                    />
                  </a>
                )}
                <div>
                  <span class="meta">{item.year}</span>
                  <h3>{item.title}</h3>
                  <p>{item.result}</p>
                  {item.note && <p class="muted">{item.note}</p>}
                  {item.href && (
                    <a class="meta" href={item.href}>
                      Read more ↗
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
    <section class="section-block" id="photos">
      <div class="section-head">
        <h2>Photographs / moments kept</h2><span class="meta"
          >{photos.length} frames</span>
      </div><div class="photo-grid">
        {
          [...photos]
            .sort((a, b) => b.date.localeCompare(a.date))
            .map((photo) => (
              <figure>
                <>
                  <a href={photo.src}>
                    <img src={photo.src} alt={photo.alt} loading="lazy" />
                  </a>
                  <figcaption class="meta">
                    {photo.alt} / {photo.year}
                  </figcaption>
                </>
              </figure>
            ))
        }
      </div>
    </section>
  </div></Layout
>
<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .photo-grid figure {
    margin: 0;
  }
  .photo-grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .photo-grid figcaption {
    margin-top: 9px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 28px;
  }
  .project {
    min-width: 0;
  }
  .project-media {
    aspect-ratio: 1.6;
    background: #e1e2e8;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .project-media video,
  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 15px;
    margin-top: 18px;
  }
  .project h2 {
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .project > p {
    color: var(--f-low);
    font-size: 15px;
    margin: 7px 0 15px;
  }
  .project-placeholder {
    text-align: center;
    font: 13px var(--font-mono);
    color: #666b85;
  }
  .project-placeholder > span {
    display: block;
    font-size: 64px;
    margin-bottom: 15px;
  }
  .project-details {
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .project-details summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    padding: 13px 0;
    font: 10px var(--font-mono);
    color: var(--f-mute);
  }
  .project-details summary::-webkit-details-marker {
    display: none;
  }
  .project-details[open] summary span {
    transform: rotate(45deg);
  }
  .project-details p,
  .project-details li {
    color: var(--f-low);
  }
  .project-details ul {
    padding-left: 20px;
  }
  .tech {
    font: 10px/1.8 var(--font-mono);
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font: 11px var(--font-mono);
    margin: 20px 0;
  }
  .extra-media {
    margin-top: 15px;
  }
  .contributions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 30px;
  }
  .contributions > a {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .contribution-title {
    display: flex;
    justify-content: space-between;
    font-size: 17px;
  }
  .contribution-title > span {
    color: var(--f-mute);
  }
  .contributions p {
    font-size: 14px;
    color: var(--f-low);
    margin: 7px 0;
  }
  .nixpkgs {
    font-size: 14px;
    margin-top: 25px;
    color: var(--f-low);
  }
  .recognition-list {
    display: grid;
    gap: 25px;
  }
  .recognition-list article {
    display: flex;
    align-items: start;
    gap: 25px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 25px;
  }
  .recognition-list article > a {
    width: 145px;
    flex: none;
  }
  .recognition-list img {
    width: 145px;
    height: 115px;
    object-fit: cover;
  }
  .recognition-list img.letter {
    object-fit: contain;
    background: var(--b-med);
    padding: 8px;
  }
  .recognition-list h3 {
    margin: 4px 0;
    font-size: 20px;
    font-weight: 500;
  }
  .recognition-list p {
    margin: 0;
    font-size: 15px;
  }
  .recognition-list .muted {
    color: var(--f-low);
    margin-top: 7px;
    max-width: 530px;
  }
  @media (max-width: 640px) {
    .photo-grid {
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .project-grid,
    .contributions {
      grid-template-columns: 1fr;
    }
    .recognition-list article {
      gap: 16px;
    }
    .recognition-list article > a,
    .recognition-list img {
      width: 85px;
    }
    .recognition-list img {
      height: 85px;
    }
    .recognition-list h3 {
      font-size: 17px;
    }
  }
</style>
