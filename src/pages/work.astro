---
import Layout from "~/layouts/Layout.astro";
import { projects } from "~/data/projects";
import { recognition } from "~/data/recognition";
import { highlights, nixpkgs } from "~/data/oss";
---

<Layout
  title="Work"
  description="Projects, open-source contributions, and recognition."
  ><div class="shell">
    <header class="page-head">
      <p class="eyebrow">Selected work / 2022 , now</p><h1>
        Built out of curiosity.
      </h1><p class="page-lede">
        Tools, interfaces, and experiments. Some shipped, some retired. All
        taught me something.
      </p>
    </header>
    <div class="project-grid" id="project-gallery" role="region" aria-label="Selected projects" tabindex="0">
      {
        projects.map((project, i) => {
          const cover = project.cover ?? project.media[0];
          return (
            <article class="project" id={project.slug} data-no-story>
              <>
                <div class="project-media">
                  {cover ? (
                    cover.kind === "video" ? (
                      <video
                        controls
                        playsinline
                        preload="metadata"
                        poster={cover.poster}
                        aria-label={`${project.name} demo`}
                      >
                        <source src={cover.src} type="video/mp4" />
                      </video>
                    ) : (
                      <img
                        src={cover.src}
                        alt={cover.alt ?? project.name}
                        loading="lazy"
                      />
                    )
                  ) : (
                    <div class="project-placeholder">
                      <span>∑</span>
                      <p>{project.name}</p>
                    </div>
                  )}
                </div>
                <div class="project-top">
                  <>
                    <h2>{project.name}</h2>
                    <span class="meta">{project.status ?? project.year}</span>
                  </>
                </div>
                <p>{project.summary}</p>
                <details class="project-details">
                  <summary aria-label={`More about ${project.name}`}><span aria-hidden="true">+</span></summary>
                  {project.origin && <p>{project.origin}</p>}
                  <p>{project.blurb}</p>
                  {project.highlights && (
                    <ul>
                      {project.highlights.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}
                  {project.tech.length > 0 && (
                    <p class="tech">{project.tech.join(" / ")}</p>
                  )}
                  <div class="project-links">
                    {project.repo && <a href={project.repo}>Source ↗</a>}
                    {project.demo && <a href={project.demo}>Visit ↗</a>}
                    {project.readMore && (
                      <a href={project.readMore}>Write-up →</a>
                    )}
                    {project.reddit && (
                      <a href={project.reddit}>Discussion ↗</a>
                    )}
                  </div>
                  {project.media.slice(1).map((media) =>
                    media.kind === "image" ? (
                      <img
                        class="extra-media"
                        src={media.src}
                        alt={media.alt ?? project.name}
                        loading="lazy"
                      />
                    ) : (
                      <video
                        class="extra-media"
                        controls
                        playsinline
                        preload="metadata"
                        poster={media.poster}
                      >
                        <source src={media.src} type="video/mp4" />
                      </video>
                    ),
                  )}
                </details>
              </>
            </article>
          );
        })
      }
    </div>
    <div class="gallery-controls" aria-label="Browse projects"><button type="button" data-gallery-prev aria-label="Previous project" aria-controls="project-gallery">←</button><button type="button" data-gallery-next aria-label="Next project" aria-controls="project-gallery">→</button><span data-gallery-count aria-live="polite">01 / {String(projects.length).padStart(2,"0")}</span></div>
    <section class="section-block" id="recognition">
      <div class="section-head"><h2>Recognition / along the way</h2></div><div
        class="recognition-list" tabindex="0" role="region" aria-label="Recognition"
      >
        {
          recognition.map((item) => {
            const pic = item.photo ?? item.image;
            return (
              <article class:list={{ "has-destination": !!item.href }}>
                {item.video ? <video class="recognition-video" controls playsinline preload="none" poster={item.video.poster} aria-label={`${item.title} demo`}><source src={item.video.src} type="video/mp4" /></video> : pic && (
                  <a href={item.href ?? pic.src} data-no-story={!!item.href}>
                    <img
                      src={pic.src}
                      alt={pic.alt}
                      loading="lazy"
                      class:list={{ letter: !!item.image }}
                    />
                  </a>
                )}
                <div>
                  <span class="meta">{item.year}</span>
                  <h3>{item.href ? <a class="recognition-destination" href={item.href}>{item.title}</a> : item.title}</h3>
                  <p>{item.result}</p>
                  {item.note && <p class="muted">{item.note}</p>}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
    <section class="section-block">
      <div class="section-head">
        <h2>Open source / a shared effort</h2><a
          href="https://github.com/pulls?q=is%3Apr+author%3Apwnwriter"
          >All contributions ↗</a>
      </div><div class="contributions" tabindex="0" role="region" aria-label="Open-source contributions">
        {
          highlights.map((item) => (
            <a href={item.url}>
              <>
                <span class="contribution-title">
                  {item.repo}
                  <span>↗</span>
                </span>
                <p>{item.what}</p>
                <span class="meta">
                  {item.lang}
                  {item.count ? ` / ${item.count} merged PRs` : ""}
                </span>
              </>
            </a>
          ))
        }
      </div><p class="nixpkgs">
        Also in nixpkgs: {
          nixpkgs.map((pkg, i) => (
            <span>
              {i > 0 ? " · " : ""}
              <a href={pkg.url}>{pkg.name}</a>
            </span>
          ))
        }
      </p>
    </section>


  </div></Layout
>
<script>
 const gallery=document.querySelector<HTMLElement>('#project-gallery')!;
 const prev=document.querySelector<HTMLButtonElement>('[data-gallery-prev]')!;
 const next=document.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
 const count=document.querySelector<HTMLElement>('[data-gallery-count]')!;
 const cards=Array.from(gallery.querySelectorAll<HTMLElement>('.project'));
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const step=()=>cards.length>1?cards[1].offsetLeft-cards[0].offsetLeft:gallery.clientWidth;
 function update(){const i=Math.round(gallery.scrollLeft/step());prev.disabled=gallery.scrollLeft<4;next.disabled=gallery.scrollLeft>=gallery.scrollWidth-gallery.clientWidth-4;count.textContent=`${String(i+1).padStart(2,'0')} / ${String(cards.length).padStart(2,'0')}`;}
 function move(direction:number){gallery.scrollBy({left:direction*step(),behavior:reduced.matches?'instant':'smooth'});}
 prev.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));
 gallery.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);
 gallery.addEventListener('keydown',event=>{if(event.target!==gallery)return;if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();move(event.key==='ArrowRight'?1:-1);}});
 gallery.addEventListener('play',event=>{gallery.querySelectorAll('video').forEach(video=>{if(video!==event.target)video.pause();});},true);
 update();
</script>
<style>
  .gallery-controls{display:flex;align-items:center;gap:8px;margin:8px 0 48px;}
  .gallery-controls button{display:grid;place-items:center;width:34px;height:34px;border:1px solid #e0e1e7;border-radius:11px;background:#e9eaf0;color:#707686;font-size:19px;cursor:pointer;transition:background .2s,transform .2s;}
  .gallery-controls button:hover:not(:disabled){background:#dfe2eb;transform:translateY(-1px);}
  .gallery-controls button:disabled{opacity:.35;cursor:default;}
  .gallery-controls span{margin-left:8px;font:10px var(--font-mono);color:var(--f-mute);}

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .photo-grid figure {
    margin: 0;
  }
  .photo-grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .photo-grid figcaption {
    margin-top: 9px;
  }
  .project-grid {
    --gallery-inset: max(32px, calc((100vw - 980px) / 2));
    width: calc(100vw - var(--gallery-inset));
    margin-inline: 0;
    box-sizing: border-box;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(76vw, 370px);
    gap: 24px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding: 2px var(--gallery-inset) 16px 0;
    scroll-padding-inline: 0;
    align-items: start;
  }
  .project-grid::-webkit-scrollbar{display:none;}
  .project {
    scroll-snap-align: start;
    min-width: 0;
  }
  .project-media {
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    background: #edeef1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid #e4e5eb;
  }
  .project-media video,
  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 15px;
    margin-top: 18px;
  }
  .project h2 {
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .project > p {
    color: var(--f-low);
    font-size: 15px;
    margin: 7px 0 15px;
  }
  .project-placeholder {
    text-align: center;
    font: 13px var(--font-mono);
    color: #666b85;
  }
  .project-placeholder > span {
    display: block;
    font-size: 64px;
    margin-bottom: 15px;
  }
  .project-details {
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .project-details summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    padding: 13px 0;
    font: 10px var(--font-mono);
    color: var(--f-mute);
  }
  .project-details summary::-webkit-details-marker {
    display: none;
  }
  .project-details[open] summary span {
    transform: rotate(45deg);
  }
  .project-details p,
  .project-details li {
    color: var(--f-low);
  }
  .project-details ul {
    padding-left: 20px;
  }
  .tech {
    font: 10px/1.8 var(--font-mono);
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font: 11px var(--font-mono);
    margin: 20px 0;
  }
  .extra-media {
    margin-top: 15px;
  }
  .contributions {
    --contribution-inset:max(32px,calc((100vw - 980px)/2));
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:min(78vw,280px);
    gap:14px;
    width:100vw;
    margin-inline:calc(50% - 50vw);
    padding:4px var(--contribution-inset) 16px;
    box-sizing:border-box;
    overflow-x:auto;
    overscroll-behavior-x:contain;
    scroll-snap-type:x proximity;
    scroll-padding-inline:var(--contribution-inset);
    scrollbar-width:thin;
    scrollbar-color:#cdd0db transparent;
  }
  .contributions > a {
    display:flex;
    flex-direction:column;
    gap:10px;
    padding:18px;
    border:1px solid #dfe1e8;
    border-radius:16px;
    background:#f4f4f8;
    box-shadow:inset 0 1px 0 #ffffffb0;
    text-decoration:none;
    scroll-snap-align:start;
    transition:background .18s,border-color .18s;
  }
  .contributions > a:hover{background:#eeeef5;border-color:#c9cedc;}
  .contributions > a:focus-visible{outline:2px solid #8293af;outline-offset:-3px;}
  .contributions .meta{margin-top:auto;font-size:10px;}
  .contribution-title {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    gap:12px;
    overflow-wrap:anywhere;
  }
  .contribution-title > span {
    color: var(--f-mute);
  }
  .contributions p {
    font-size: 13px;
    line-height:1.6;
    color: var(--f-low);
    margin: 7px 0;
  }
  .nixpkgs {
    font-size: 14px;
    margin-top: 25px;
    color: var(--f-low);
  }
  .recognition-list {
    --recognition-inset:max(32px,calc((100vw - 980px)/2));
    display:grid;grid-auto-flow:column;grid-auto-columns:min(78vw,260px);gap:16px;align-items:start;
    width:100vw;margin-inline:calc(50% - 50vw);box-sizing:border-box;
    padding:4px var(--recognition-inset) 16px;overflow-x:auto;
    overscroll-behavior-x:contain;scroll-snap-type:x proximity;
    scroll-padding-inline:var(--recognition-inset);scrollbar-width:thin;scrollbar-color:#cdd0db transparent;
  }
  .recognition-list article{position:relative;min-width:0;scroll-snap-align:start;padding:10px;border:1px solid #e3e4eb;border-radius:15px;background:#f1f2f680;}
  .recognition-destination{color:inherit;text-decoration:none;}
  .recognition-destination::after{content:"";position:absolute;inset:0;border-radius:15px;z-index:1;}
  .recognition-destination:focus-visible{outline:none;}
  .recognition-destination:focus-visible::after{outline:2px solid #8293af;outline-offset:2px;}
  .recognition-list .has-destination:hover{border-color:#c9cedc;background:#eeeef5;}
  .recognition-list article>a,.recognition-video{position:relative;z-index:2;}
  .recognition-video{display:block;width:100%;aspect-ratio:16/9;object-fit:contain;border-radius:10px;margin-bottom:10px;background:#e9eaf0;}
  .recognition-list article>a{display:block;margin-bottom:10px;border-radius:10px;overflow:hidden;}
  .recognition-list img{display:block;width:100%;height:148px;object-fit:cover;}
  .recognition-list img.letter{object-fit:contain;background:#e9eaf0;padding:8px;}
  .recognition-list h3{margin:3px 0 6px;font-size:15px;font-weight:500;line-height:1.35;}
  .recognition-list p{margin:0;font-size:12px;line-height:1.5;color:var(--f-low);}
  .recognition-list .meta{font-size:10px;}
  .recognition-list .muted{margin-top:5px;}
  .recognition-list div>a{display:inline-block;margin-top:9px;}
  @media (max-width: 640px) {
    .project-grid{--gallery-inset:18px;gap:18px;}
    .photo-grid {
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .contributions {--contribution-inset:18px;}
    .recognition-list{--recognition-inset:18px;}
  }
</style>
