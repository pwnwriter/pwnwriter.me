---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import ProjectViewer from "~/components/project-viewer.astro";
import { projects } from "~/pages/projects/projects";

const externalAttrs = {
  target: "_blank",
  rel: "noopener noreferrer",
};
---

<Layout
  title="projects"
  description="Things I've built: tools, configs, and experiments."
>
  <Wrapper>
    <header class="page-head">
      <h1 class="page-title">projects</h1>
      <p class="page-lede">
        small tools, experiments, and systems i kept poking at until they became
        useful enough to keep around.
      </p>
    </header>

    {
      projects.length === 0 ? (
        <p class="meta">not yet. soon.</p>
      ) : (
        <div class="projects">
          {projects.map((p, i) => {
            const primary = p.cover ?? p.media[0];
            const isVideo = primary.kind === "video";
            const poster =
              primary.kind === "image" ? primary.src : primary.poster;
            const status = p.status ?? (p.archived ? "archived" : undefined);
            return (
              <article class="project" id={p.slug}>
                <header class="pr-side">
                  <h2 class="pr-name">
                    <button
                      class="project-open"
                      data-gallery={i}
                      type="button"
                    >
                      {p.name}
                    </button>
                  </h2>
                  <p class="meta">
                    {p.year ?? "now"}
                    {status && ` · ${status}`}
                  </p>
                </header>

                <div class="pr-body">
                  <p class="pr-summary">{p.summary}</p>
                  <p class="pr-blurb">{p.blurb}</p>

                  <div
                    class="pr-media project-open"
                    data-gallery={i}
                    role="button"
                    tabindex="0"
                    aria-label={`Open ${p.name} media`}
                  >
                    {isVideo ? (
                      <video
                        class="pr-video"
                        poster={poster ?? undefined}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        src={primary.src}
                      />
                    ) : poster ? (
                      <img src={poster} alt={p.name} loading="lazy" />
                    ) : null}
                  </div>

                  {p.highlights && p.highlights.length > 0 && (
                    <details class="pr-details">
                      <summary class="meta">engineering notes</summary>
                      <ul>
                        {p.highlights.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </details>
                  )}

                  <footer class="pr-foot meta">
                    {p.tech.length > 0 && <span>{p.tech.join(" · ")}</span>}

                    {(p.repo || p.demo || p.readMore || p.reddit) && (
                      <span class="pr-links">
                        {p.demo && (
                          <a href={p.demo} {...externalAttrs}>
                            site
                          </a>
                        )}
                        {p.repo && (
                          <a href={p.repo} {...externalAttrs}>
                            source
                          </a>
                        )}
                        {p.readMore && <a href={p.readMore}>read more</a>}
                        {p.reddit && (
                          <a href={p.reddit} {...externalAttrs}>
                            thread
                          </a>
                        )}
                      </span>
                    )}
                  </footer>
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </Wrapper>

  <ProjectViewer projects={projects} />
</Layout>

<style>
  .project {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    scroll-margin-top: 5rem;
  }

  .project + .project {
    margin-top: 3.5rem;
    border-top: 1px solid var(--line);
    padding-top: 3.5rem;
  }

  .pr-name {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    line-height: 1.6;
  }

  .pr-name button {
    border: 0;
    background: none;
    padding: 0;
    color: var(--f-high);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-align: left;
    transition: color 0.15s ease;
  }

  .pr-name button:hover {
    color: var(--accent);
  }

  .pr-side .meta {
    margin: 0.15rem 0 0;
  }

  .pr-summary {
    margin: 0;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .pr-blurb {
    margin: 0.6rem 0 0;
    color: var(--f-low);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .pr-media {
    margin-top: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--b-med);
    aspect-ratio: 16 / 10;
    cursor: zoom-in;
  }

  .pr-media :is(img, video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pr-details {
    margin-top: 1rem;
  }

  .pr-details summary {
    width: fit-content;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .pr-details summary:hover {
    color: var(--f-high);
  }

  .pr-details ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    color: var(--f-low);
    font-size: 0.9rem;
    line-height: 1.6;
    list-style: disc;
  }

  .pr-details li::marker {
    color: var(--f-mute);
  }

  .pr-details li + li {
    margin-top: 0.3rem;
  }

  .pr-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-top: 1rem;
    text-transform: none;
  }

  .pr-links {
    display: flex;
    gap: 1rem;
  }

  .pr-links a {
    color: var(--f-high);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .pr-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .project {
      grid-template-columns: 1fr;
    }

    .pr-side {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>

<script>
  // Autoplay each clip (muted, looping) only while it's on screen, and pause it
  // when it scrolls away so we're never decoding off-screen video.
  function initInlineVideos() {
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduce) return; // respect reduced-motion: leave the poster still

    const videos =
      document.querySelectorAll<HTMLVideoElement>("video.pr-video");
    if (!videos.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.35 },
    );

    videos.forEach((v) => io.observe(v));
  }

  // Enter / Space opens the full-screen viewer (click is handled by the viewer)
  function initMediaKeys() {
    document
      .querySelectorAll<HTMLElement>(".pr-media.project-open")
      .forEach((el) => {
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            el.click();
          }
        });
      });
  }

  function init() {
    initInlineVideos();
    initMediaKeys();
  }

  document.addEventListener("DOMContentLoaded", init);
  if (document.readyState !== "loading") init();
</script>
