---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Heading from "~/components/text/heading.astro";
import ProjectViewer from "~/components/project-viewer.astro";
import { projects } from "~/pages/projects/projects";

const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="projects" description="Things I've built — tools, configs, and experiments.">
  <Wrapper>
    <header class="projects-header">
      <div>
        <Heading Element="h1">Projects</Heading>
        <p>
          small tools, experiments, and systems i kept poking at until they became
          useful enough to keep around.
        </p>
      </div>
    </header>

    {
      projects.length === 0 ? (
        <p class="mt-6 text-sm" style="color: var(--f-low); opacity: 0.5;">
          not yet. soon.
        </p>
      ) : (
        <div class="projects">
          {projects.map((p, i) => {
            const primary = p.cover ?? p.media[0];
            const isVideo = primary.kind === "video";
            const poster =
              primary.kind === "image" ? primary.src : primary.poster;
            const extra = p.media.length - 1;
            return (
              <article class="project-card">
                <div
                  class="pr-media project-open"
                  data-gallery={i}
                  role="button"
                  tabindex="0"
                  aria-label={`Open ${p.name} media`}
                >
                  {isVideo ? (
                    <video
                      class="pr-video"
                      poster={poster ?? undefined}
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      src={primary.src}
                    />
                  ) : poster ? (
                    <img class="pr-img" src={poster} alt={p.name} loading="lazy" />
                  ) : null}

                  {isVideo && (
                    <span class="pr-badge" aria-hidden="true">
                      preview
                    </span>
                  )}
                  {extra > 0 && (
                    <span class="pr-count" aria-hidden="true">
                      +{extra}
                    </span>
                  )}
                </div>

                <div class="pr-body">
                  <div class="pr-meta-top">
                    <span class="pr-rank">{pad(i + 1)}</span>
                    <span>/</span>
                    <span>{p.year ?? "now"}</span>
                    {p.archived && <span class="pr-archived">archived</span>}
                  </div>
                  <h2 class="pr-name">
                    <button
                      class="project-open pr-title-button"
                      data-gallery={i}
                      type="button"
                    >
                      {p.name}
                    </button>
                  </h2>
                  <p class="pr-blurb">{p.blurb}</p>

                  <div class="pr-foot">
                  {p.tech.length > 0 && (
                    <ul class="pr-tech">
                      {p.tech.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  )}

                  {(p.repo || p.demo || p.reddit) && (
                    <div class="pr-links">
                      {p.demo && (
                        <a
                          href={p.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="Live website"
                          title="Website"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M2 12h20" />
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                          </svg>
                        </a>
                      )}
                      {p.repo && (
                        <a
                          href={p.repo}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="GitHub repository"
                          title="GitHub"
                        >
                          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                          </svg>
                        </a>
                      )}
                      {p.reddit && (
                        <a
                          href={p.reddit}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="Reddit post"
                          title="Reddit"
                        >
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z" />
                          </svg>
                        </a>
                      )}
                    </div>
                  )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </Wrapper>

  <ProjectViewer projects={projects} />
</Layout>

<style>
  .projects-header {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .projects-header p {
    max-width: 40rem;
    margin-top: 0.65rem;
    color: color-mix(in srgb, var(--f-low) 82%, transparent);
    font-size: 1rem;
    line-height: 1.55;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
    background: color-mix(in srgb, var(--f-high) 3.5%, transparent);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 34%, transparent);
    background-color: color-mix(in srgb, var(--f-high) 6%, transparent);
    box-shadow: 0 24px 46px -32px color-mix(in srgb, var(--f-high) 62%, transparent);
  }

  .pr-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    cursor: pointer;
    background: color-mix(in srgb, var(--f-high) 5%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--f-low) 12%, transparent);
    outline: none;
  }

  .pr-media:focus-visible {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .pr-video,
  .pr-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.9) contrast(0.98);
    transition:
      filter 220ms ease,
      transform 320ms ease;
  }

  .project-card:hover .pr-video,
  .project-card:hover .pr-img {
    transform: scale(1.045);
    filter: saturate(1.05) contrast(1);
  }

  .pr-badge {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    display: inline-flex;
    align-items: center;
    padding: 0.14rem 0.4rem;
    font-size: 0.58rem;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0;
    color: white;
    background: rgba(0, 0, 0, 0.46);
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .pr-count {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    font-size: 0.58rem;
    font-family: var(--font-mono, monospace);
    color: rgba(255, 255, 255, 0.92);
    background: rgba(0, 0, 0, 0.46);
    border-radius: 4px;
    padding: 0.08rem 0.35rem;
    backdrop-filter: blur(4px);
  }

  .pr-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    min-width: 0;
    gap: 0.5rem;
    padding: 0.95rem 1.05rem 1.05rem;
  }

  .pr-meta-top {
    display: flex;
    align-items: center;
    gap: 0.34rem;
    width: 100%;
    color: color-mix(in srgb, var(--f-low) 60%, transparent);
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0;
  }

  .pr-rank {
    color: color-mix(in srgb, var(--accent) 86%, var(--f-high));
  }

  .pr-archived {
    margin-left: auto;
    padding: 0.05em 0.5em;
    border: 1px solid color-mix(in srgb, var(--f-low) 30%, transparent);
    border-radius: 999px;
    color: color-mix(in srgb, var(--f-low) 80%, transparent);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .pr-name {
    margin: 0;
    font-family: "Departure Mono", ui-monospace, Menlo, monospace;
    font-size: clamp(1.18rem, 2vw, 1.55rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--f-high);
  }

  .pr-title-button {
    display: block;
    max-width: 100%;
    padding: 0;
    color: inherit;
    overflow: hidden;
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
    letter-spacing: 0;
    text-align: left;
    text-overflow: ellipsis;
  }

  .pr-title-button:hover,
  .pr-title-button:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .pr-blurb {
    margin: 0.05rem 0 0;
    color: color-mix(in srgb, var(--f-low) 84%, transparent);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .pr-foot {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    margin-top: auto;
    padding-top: 0.55rem;
  }

  .pr-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.34rem;
  }

  .pr-tech li {
    max-width: 12rem;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--f-low) 18%, transparent);
    border-radius: 5px;
    padding: 0.08rem 0.42rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.64rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pr-links {
    display: flex;
    gap: 0.85rem;
  }

  .pr-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--f-low) 78%, transparent);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .pr-links a svg {
    width: 1.2rem;
    height: 1.2rem;
    display: block;
  }

  .pr-links a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  @media (max-width: 760px) {
    .projects-header {
      margin-bottom: 1.5rem;
    }

    .projects {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .pr-media {
      aspect-ratio: 16 / 9;
    }

    .pr-name {
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .pr-video,
    .pr-img {
      transition: none;
    }
    .project-card:hover {
      transform: none;
    }
    .project-card:hover .pr-video,
    .project-card:hover .pr-img {
      transform: none;
    }
  }
</style>

<script>
  // Autoplay each clip (muted, looping) only while it's on screen, and pause it
  // when it scrolls away so we're never decoding off-screen video.
  function initInlineVideos() {
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduce) return; // respect reduced-motion: leave the poster still

    const videos = document.querySelectorAll<HTMLVideoElement>("video.pr-video");
    if (!videos.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.35 },
    );

    videos.forEach((v) => io.observe(v));
  }

  // Enter / Space opens the full-screen viewer (click is handled by the viewer)
  function initMediaKeys() {
    document
      .querySelectorAll<HTMLElement>(".pr-media.project-open")
      .forEach((el) => {
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            el.click();
          }
        });
      });
  }

  function init() {
    initInlineVideos();
    initMediaKeys();
  }

  document.addEventListener("DOMContentLoaded", init);
  if (document.readyState !== "loading") init();
</script>
