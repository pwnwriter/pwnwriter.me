---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Heading from "~/components/text/heading.astro";
import ProjectViewer from "~/components/project-viewer.astro";
import { projects } from "~/pages/projects/projects";

const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="projects" description="Things I've built — tools, configs, and experiments.">
  <Wrapper>
    <header class="projects-header">
      <div>
        <Heading Element="h1">Projects</Heading>
        <p>
          small tools, experiments, and systems i kept poking at until they became
          useful enough to keep around.
        </p>
      </div>
    </header>

    {
      projects.length === 0 ? (
        <p class="mt-6 text-sm" style="color: var(--f-low); opacity: 0.5;">
          not yet. soon.
        </p>
      ) : (
        <div class="projects">
          {projects.map((p, i) => {
            const primary = p.cover ?? p.media[0];
            const isVideo = primary.kind === "video";
            const poster =
              primary.kind === "image" ? primary.src : primary.poster;
            const extra = p.media.length - 1;
            return (
              <article class="project-card">
                <div
                  class="pr-media project-open"
                  data-gallery={i}
                  role="button"
                  tabindex="0"
                  aria-label={`Open ${p.name} media`}
                >
                  {isVideo ? (
                    <video
                      class="pr-video"
                      poster={poster ?? undefined}
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      src={primary.src}
                    />
                  ) : poster ? (
                    <img class="pr-img" src={poster} alt={p.name} loading="lazy" />
                  ) : null}

                  {isVideo && (
                    <span class="pr-badge" aria-hidden="true">
                      preview
                    </span>
                  )}
                  {extra > 0 && (
                    <span class="pr-count" aria-hidden="true">
                      +{extra}
                    </span>
                  )}
                </div>

                <div class="pr-body">
                  <div class="pr-meta-top">
                    <span class="pr-rank">{pad(i + 1)}</span>
                    <span>/</span>
                    <span>{p.year ?? "now"}</span>
                  </div>
                  <h2 class="pr-name">
                    <button
                      class="project-open pr-title-button"
                      data-gallery={i}
                      type="button"
                    >
                      {p.name}
                    </button>
                  </h2>
                  <p class="pr-blurb">{p.blurb}</p>

                  {p.tech.length > 0 && (
                    <ul class="pr-tech">
                      {p.tech.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  )}

                  {(p.repo || p.demo) && (
                    <div class="pr-links">
                      {p.repo && (
                        <a href={p.repo} target="_blank" rel="noopener noreferrer">
                          repo
                        </a>
                      )}
                      {p.demo && (
                        <a href={p.demo} target="_blank" rel="noopener noreferrer">
                          live
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </Wrapper>

  <ProjectViewer projects={projects} />
</Layout>

<style>
  .projects-header {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .projects-header p {
    max-width: 40rem;
    margin-top: 0.65rem;
    color: color-mix(in srgb, var(--f-low) 82%, transparent);
    font-size: 1rem;
    line-height: 1.55;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px dashed color-mix(in srgb, var(--f-low) 20%, transparent);
    border-left: 1px dashed color-mix(in srgb, var(--f-low) 16%, transparent);
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.74fr) minmax(0, 1fr);
    gap: 1.05rem;
    min-width: 0;
    padding: 1rem;
    border-right: 1px dashed color-mix(in srgb, var(--f-low) 16%, transparent);
    border-bottom: 1px dashed color-mix(in srgb, var(--f-low) 20%, transparent);
    background:
      radial-gradient(
        circle at 10% 0%,
        color-mix(in srgb, var(--accent) 7%, transparent),
        transparent 34%
      ),
      transparent;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .project-card:hover {
    background-color: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  .pr-media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 9px;
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--f-low) 18%, transparent);
    background: color-mix(in srgb, var(--f-high) 5%, transparent);
    box-shadow: 0 14px 34px -28px color-mix(in srgb, var(--f-high) 45%, transparent);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
    outline: none;
  }

  .pr-media:hover,
  .pr-media:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
    box-shadow: 0 18px 38px -26px color-mix(in srgb, var(--f-high) 55%, transparent);
  }

  .pr-video,
  .pr-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.82) contrast(0.96);
    transition:
      filter 180ms ease,
      transform 220ms ease;
  }

  .pr-media:hover .pr-video,
  .pr-media:hover .pr-img {
    transform: scale(1.03);
    filter: saturate(1) contrast(1);
  }

  .pr-badge {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    display: inline-flex;
    align-items: center;
    padding: 0.14rem 0.4rem;
    font-size: 0.58rem;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0;
    color: white;
    background: rgba(0, 0, 0, 0.46);
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .pr-count {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    font-size: 0.58rem;
    font-family: var(--font-mono, monospace);
    color: rgba(255, 255, 255, 0.92);
    background: rgba(0, 0, 0, 0.46);
    border-radius: 4px;
    padding: 0.08rem 0.35rem;
    backdrop-filter: blur(4px);
  }

  .pr-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    gap: 0.45rem;
  }

  .pr-meta-top {
    display: flex;
    align-items: baseline;
    gap: 0.34rem;
    color: color-mix(in srgb, var(--f-low) 60%, transparent);
    font-size: 0.74rem;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0;
  }

  .pr-rank {
    color: color-mix(in srgb, var(--accent) 86%, var(--f-high));
  }

  .pr-name {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.18rem, 2vw, 1.55rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--f-high);
  }

  .pr-title-button {
    display: block;
    max-width: 100%;
    padding: 0;
    color: inherit;
    overflow: hidden;
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
    letter-spacing: 0;
    text-align: left;
    text-overflow: ellipsis;
  }

  .pr-title-button:hover,
  .pr-title-button:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .pr-blurb {
    display: -webkit-box;
    min-height: 3.75em;
    margin: 0.1rem 0 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 84%, transparent);
    font-size: 0.84rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .pr-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
    margin-top: auto;
  }

  .pr-tech li {
    max-width: 12rem;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 68%, transparent);
    border: 1px solid color-mix(in srgb, var(--f-low) 16%, transparent);
    border-radius: 4px;
    padding: 0.04rem 0.38rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pr-links {
    display: flex;
    gap: 0.85rem;
    margin-top: 0.18rem;
  }

  .pr-links a {
    color: color-mix(in srgb, var(--accent) 90%, var(--f-high));
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .pr-links a:hover {
    border-color: var(--accent);
  }

  .pr-links a::after {
    content: " ->";
  }

  @media (max-width: 760px) {
    .projects-header {
      margin-bottom: 1.35rem;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .project-card {
      grid-template-columns: minmax(5.5rem, 0.42fr) minmax(0, 1fr);
      gap: 0.8rem;
      padding: 0.85rem;
    }

    .pr-name {
      font-size: 1.18rem;
    }

    .pr-blurb {
      min-height: 0;
      font-size: 0.8rem;
      -webkit-line-clamp: 2;
    }

    .pr-tech {
      display: none;
    }
  }

  @media (max-width: 460px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .pr-media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-media,
    .pr-video,
    .pr-img {
      transition: none;
    }
    .pr-media:hover {
      transform: none;
    }
  }
</style>

<script>
  // Autoplay each clip (muted, looping) only while it's on screen, and pause it
  // when it scrolls away so we're never decoding off-screen video.
  function initInlineVideos() {
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduce) return; // respect reduced-motion: leave the poster still

    const videos = document.querySelectorAll<HTMLVideoElement>("video.pr-video");
    if (!videos.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.35 },
    );

    videos.forEach((v) => io.observe(v));
  }

  // Enter / Space opens the full-screen viewer (click is handled by the viewer)
  function initMediaKeys() {
    document
      .querySelectorAll<HTMLElement>(".pr-media.project-open")
      .forEach((el) => {
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            el.click();
          }
        });
      });
  }

  function init() {
    initInlineVideos();
    initMediaKeys();
  }

  document.addEventListener("DOMContentLoaded", init);
  if (document.readyState !== "loading") init();
</script>
