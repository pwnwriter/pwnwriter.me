---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Link from "~/components/link.astro";
import { photos } from "~/pages/photos/photos";

photos.sort((a, b) => (a.date < b.date ? 1 : -1));
const featuredPhotos = photos.slice(0, 8);

const screenPicks = [
  {
    title: "Mr. Robot",
    from: "systems breaking beautifully",
    meta: "series / paranoia",
    mark: "fs",
    tone: "#4a445f",
    rating: 5,
  },
  {
    title: "Snowden",
    from: "surveillance, keys, and consequences",
    meta: "film / security",
    mark: "sn",
    tone: "#6f6a86",
    rating: 4,
  },
  {
    title: "Who Am I",
    from: "ctf energy with questionable decisions",
    meta: "film / hacking",
    mark: "0x",
    tone: "#b4634b",
    rating: 4,
  },
  {
    title: "The Social Network",
    from: "shipping, ego, and messy origin stories",
    meta: "film / builders",
    mark: "</>",
    tone: "#897aa5",
    rating: 4,
  },
  {
    title: "Spider-Man: Brand New Day",
    from: "friendly neighborhood runtime",
    meta: "marvel / spider-man",
    mark: "sp",
    tone: "#c45b65",
    rating: 5,
  },
  {
    title: "Avengers: Endgame",
    from: "big swings, bigger portals",
    meta: "marvel / comfort rewatch",
    mark: "a",
    tone: "#6b5d95",
    rating: 5,
  },
];
---

<Layout
  title="About"
  description="About Nabeen Tiwaree, also known as pwnwriter."
>
  <Wrapper>
    <section class="about-page">
      <header class="about-hero">
        <div class="about-copy">
          <div class="annotation-lane" aria-hidden="true">
            <span class="lane-note lane-note-identity">
              docs say Nabin Tiwari<br />
              online: pwnwriter
            </span>
            <span class="lane-note lane-note-ai">concentrated in AI</span>
          </div>
          <p>
            i’m <span class="annotated annotated-name">
              <strong>Nabeen Tiwaree</strong>
            </span>. originally from the Himalayas in Nepal and currently in the
            US, i’m a <span class="annotated">
              computer science
            </span> student at <a
              href="https://www.wilmu.edu/"
              target="_blank"
              rel="noopener noreferrer">Wilmington University</a
            > who spends a lot of time around systems, security, open-source
            tools, and machines that behave better after being broken on purpose.
          </p>

          <p>
            most of what i build starts with curiosity, a weird error, a box i
            wanted to pop, or a note i wish already existed. the longer version
            is usually just me asking why one more time than was convenient.
          </p>
        </div>
      </header>

      <div class="chat-thread" aria-label="A small conversation about what I do">
        <p class="bubble bubble-left">so... what do you do?</p>
        <p class="bubble bubble-right">i write coffee, drink code, and break machines</p>
        <p class="bubble bubble-left">that's it?</p>
        <p class="bubble bubble-right">
          no, but the other answer takes like 40 minutes
        </p>
      </div>

      <section class="screen-section" aria-labelledby="screen-title">
        <div class="screen-head">
          <h2 id="screen-title">what's on-screen</h2>
          <p>
            broken systems, masked heroes, messy choices, and the occasional
            reminder that every secret has a shelf life.
          </p>
        </div>

        <div class="screen-grid">
          {screenPicks.map((pick, index) => (
            <article class="screen-pick" style={`--poster: ${pick.tone}`}>
              <div class="screen-poster" aria-hidden="true">
                <span>{pick.mark}</span>
              </div>
              <div class="screen-copy">
                <p class="screen-rank">{index + 1} / {pick.meta}</p>
                <h3>{pick.title}</h3>
                <p class="screen-stars" aria-label={`${pick.rating} out of 5 stars`}>
                  {Array.from({ length: 5 }).map((_, starIndex) => (
                    <span class:list={[starIndex < pick.rating && "is-filled"]}>
                      ★
                    </span>
                  ))}
                </p>
                <p>{pick.from}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      {
        featuredPhotos.length > 0 && (
          <section class="photo-evidence">
            <div class="photo-head">
              <div>
                <h2>photographic evidence</h2>
                <p>
                  cities, friends, talks, trails, and the occasional proof that i
                  do leave the terminal.
                </p>
              </div>
              <Link href="/photos" underline>photo archive</Link>
            </div>

            <div class="photo-rail" aria-label="Featured photos">
              {featuredPhotos.map((photo, index) => (
                <figure class="photo-item about-photo" data-index={index}>
                  <img src={photo.src} alt={photo.alt} loading="lazy" />
                  <figcaption class="photo-meta">
                    <span>{photo.alt}</span>
                    <span>{photo.date}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

    </section>
  </Wrapper>
</Layout>

<style>
  .about-page {
    max-width: 44rem;
    margin: 0 auto;
    padding-top: 0;
  }

  .about-hero h1,
  .about-section h2,
  .screen-head h2,
  .photo-head h2 {
    margin: 0;
    color: var(--f-high);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 700;
    letter-spacing: 0;
  }

  .about-hero h1 {
    font-size: clamp(2.35rem, 6vw, 3.65rem);
    line-height: 1;
  }

  .about-copy {
    position: relative;
    max-width: 38rem;
    margin-top: 0.8rem;
    padding-top: 4.15rem;
  }

  .about-copy p {
    margin: 0;
    color: var(--f-low);
    font-size: clamp(0.98rem, 1.55vw, 1.1rem);
    line-height: 1.7;
  }

  .about-copy p + p {
    margin-top: 0.75rem;
  }

  .about-copy strong {
    color: var(--f-high);
  }

  .about-copy a {
    color: var(--f-high);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 48%, transparent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .about-copy a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .annotated {
    position: relative;
    display: inline-block;
    color: var(--f-high);
  }

  .annotated::after {
    content: "";
    position: absolute;
    right: -0.2rem;
    bottom: 0.08rem;
    width: 102%;
    height: 0.34rem;
    border-bottom: 2px solid color-mix(in srgb, var(--accent) 62%, transparent);
    border-radius: 48%;
    transform: rotate(-1.5deg);
    pointer-events: none;
  }

  .annotation-lane {
    position: absolute;
    inset: 0 0 auto;
    height: 3.95rem;
    pointer-events: none;
  }

  .lane-note {
    position: absolute;
    color: color-mix(in srgb, var(--f-low) 58%, transparent);
    font-family: "Caveat", cursive;
    font-size: 1.04rem;
    font-weight: 700;
    line-height: 1.05;
    white-space: nowrap;
  }

  .lane-note::before {
    content: "";
    position: absolute;
    border-color: currentColor;
    opacity: 0.68;
  }

  .lane-note-identity {
    left: 15rem;
    top: 0.35rem;
    transform: rotate(-4deg);
  }

  .lane-note-identity::before {
    left: -1.35rem;
    top: -0.3rem;
    width: 0.85rem;
    height: 2.6rem;
    border-top: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
  }

  .lane-note-ai {
    left: 0.35rem;
    top: 2.35rem;
    transform: rotate(-7deg);
  }

  .lane-note-ai::before {
    right: -3rem;
    bottom: -0.3rem;
    width: 2.65rem;
    height: 0.85rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    border-radius: 0 0 1.4rem 0;
    transform: rotate(8deg);
  }

  .chat-thread {
    display: grid;
    gap: 0.7rem;
    margin: 1.1rem 0 2rem;
  }

  .bubble {
    width: fit-content;
    max-width: min(78%, 24rem);
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--f-low) 9%, transparent);
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--b-high) 72%, transparent);
    color: var(--f-high);
    font-size: clamp(0.88rem, 1.4vw, 0.98rem);
    line-height: 1.45;
    padding: 0.62rem 0.88rem;
    opacity: 0;
    transform: translateY(0.6rem) scale(0.98);
    animation: bubble-in 520ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .bubble-left {
    justify-self: start;
    border-bottom-left-radius: 0.35rem;
    color: color-mix(in srgb, var(--f-low) 88%, var(--f-high));
  }

  .bubble-right {
    justify-self: end;
    border-bottom-right-radius: 0.35rem;
    background: color-mix(in srgb, var(--accent) 14%, var(--b-high));
  }

  .bubble:nth-child(2) {
    animation-delay: 160ms;
  }

  .bubble:nth-child(3) {
    animation-delay: 320ms;
  }

  .bubble:nth-child(4) {
    animation-delay: 480ms;
  }

  @keyframes bubble-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .screen-section {
    margin-top: 2rem;
    border-top: 1px dashed color-mix(in srgb, var(--f-low) 18%, transparent);
    padding-top: 1.25rem;
  }

  .screen-head {
    margin-bottom: 1rem;
  }

  .screen-head h2 {
    font-size: clamp(1.35rem, 3.4vw, 1.9rem);
    line-height: 1;
  }

  .screen-head p {
    max-width: 38rem;
    margin: 0.5rem 0 0;
    color: color-mix(in srgb, var(--f-low) 78%, transparent);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .screen-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px dashed color-mix(in srgb, var(--f-low) 16%, transparent);
    border-left: 1px dashed color-mix(in srgb, var(--f-low) 14%, transparent);
  }

  .screen-pick {
    display: grid;
    grid-template-columns: 4.8rem minmax(0, 1fr);
    gap: 0.8rem;
    min-width: 0;
    padding: 0.85rem;
    border-right: 1px dashed color-mix(in srgb, var(--f-low) 14%, transparent);
    border-bottom: 1px dashed color-mix(in srgb, var(--f-low) 16%, transparent);
  }

  .screen-poster {
    position: relative;
    display: grid;
    aspect-ratio: 1 / 1;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
    border-radius: 0.45rem;
    background:
      radial-gradient(
        circle at 50% 42%,
        color-mix(in srgb, var(--poster) 70%, white) 0 7%,
        transparent 8% 100%
      ),
      radial-gradient(
        circle,
        transparent 0 42%,
        color-mix(in srgb, var(--poster) 55%, black) 43% 46%,
        transparent 47% 100%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--poster) 82%, black),
        color-mix(in srgb, var(--poster) 38%, var(--b-low))
      );
    box-shadow: 0 12px 28px -24px color-mix(in srgb, var(--poster) 80%, black);
  }

  .screen-poster::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in srgb, white 70%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 7px 7px;
    opacity: 0.46;
  }

  .screen-poster span {
    position: relative;
    color: color-mix(in srgb, white 86%, var(--f-high));
    font-family: var(--font-mono, monospace);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0;
    text-shadow: 0 0 14px currentColor;
  }

  .screen-copy {
    min-width: 0;
  }

  .screen-rank {
    margin: 0 0 0.3rem;
    color: color-mix(in srgb, var(--f-low) 55%, transparent);
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    line-height: 1.2;
  }

  .screen-copy h3 {
    margin: 0;
    overflow: hidden;
    color: var(--f-high);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .screen-stars {
    display: flex;
    gap: 0.12rem;
    margin: 0.36rem 0 0;
    color: color-mix(in srgb, var(--f-low) 30%, transparent);
    font-size: 0.72rem;
    line-height: 1;
  }

  .screen-stars span.is-filled {
    color: color-mix(in srgb, var(--accent) 86%, var(--f-high));
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .screen-copy p:last-child {
    display: -webkit-box;
    margin: 0.45rem 0 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 78%, transparent);
    font-size: 0.78rem;
    line-height: 1.42;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .photo-evidence {
    margin-top: 2.25rem;
    border-top: 1px dashed color-mix(in srgb, var(--f-low) 18%, transparent);
    padding-top: 1.25rem;
  }

  .photo-head h2 {
    font-size: clamp(1.35rem, 3.4vw, 1.9rem);
    line-height: 1;
  }

  .photo-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.3rem;
  }

  .photo-head p {
    max-width: 38rem;
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--f-low) 78%, transparent);
    font-size: 1rem;
    line-height: 1.55;
  }

  .photo-rail {
    display: grid;
    grid-auto-columns: minmax(13rem, 36%);
    grid-auto-flow: column;
    gap: 0.85rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 0.9rem 0 1rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .about-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--f-low) 10%, transparent);
    border-radius: 1.3rem;
    background: color-mix(in srgb, var(--b-high) 60%, transparent);
    cursor: pointer;
    scroll-snap-align: start;
  }

  .about-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .about-photo:hover img {
    transform: scale(1.035);
  }

  .about-photo .photo-meta {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.58), transparent);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .about-photo:hover .photo-meta {
    opacity: 1;
  }

  .about-photo .photo-meta span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .chat-thread {
      margin-bottom: 2.5rem;
    }

    .bubble {
      max-width: 92%;
    }

    .about-copy {
      padding-top: 5rem;
    }

    .annotation-lane {
      height: 4.7rem;
    }

    .lane-note {
      font-size: 0.88rem;
    }

    .lane-note-identity {
      left: 1rem;
      top: 0.1rem;
    }

    .lane-note-identity::before {
      left: -0.7rem;
      height: 2.2rem;
      width: 0.45rem;
    }

    .lane-note-ai {
      left: 1rem;
      top: 2.65rem;
    }

    .lane-note-ai::before {
      right: -1.65rem;
      width: 1.4rem;
      height: 0.55rem;
    }

    .screen-grid {
      grid-template-columns: 1fr;
    }

    .photo-head {
      align-items: start;
      flex-direction: column;
    }

    .photo-rail {
      grid-auto-columns: minmax(13rem, 82%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .about-photo img,
    .about-photo .photo-meta {
      transition: none;
    }
  }
</style>

<style is:global>
  body:has(.about-page) > .h-xl:first-of-type {
    height: 2.5rem;
  }

  @media (max-width: 640px) {
    body:has(.about-page) > .h-xl:first-of-type {
      height: 1.5rem;
    }
  }
</style>
