---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Heading from "~/components/text/heading.astro";
import Subheading from "~/components/text/subheading.astro";
import Link from "~/components/link.astro";

import BioPhoto from "~/components/BioPhoto.astro";

import Cancer from "~/components/icons/cancer.astro";
import Leo from "~/components/icons/leo.astro";
import Scorpio from "~/components/icons/scorpio.astro";
import Location from "~/components/icons/location.astro";
import Pronouns from "~/components/icons/pronouns.astro";

const bio = "/me-proud-nix-user.jpg";
---

<Layout
  title="About"
  description="About Nabeen Tiwaree, also known as pwnwriter."
>
  <Wrapper>
    <section class="about-hero">
      <BioPhoto
        src={bio}
        caption="proud nix user"
        doodle=""
      />

      <div class="about-copy">
        <p class="about-kicker">~/about</p>
        <Heading Element="h1">pwn</Heading>

        <p class="about-lede">
          I’m <strong>pwnwriter</strong>, a computer science student who likes
          systems, security, and open-source tools. Most of what I build starts
          with curiosity, a broken setup, or a note I wish already existed.
        </p>

        <div class="about-actions" aria-label="Contact links">
          <Link href="https://x.com/pwnwriter" underline>x</Link>
          <Link href="mailto:hi@pwnwriter.me" underline>email</Link>
        </div>
      </div>
    </section>

    <section class="about-section">
      <Subheading Element="h2">Small facts</Subheading>
      <dl class="fact-list">
        <div>
          <dt>
            <Pronouns size={16} />
            Pronouns
          </dt>
          <dd>He / him</dd>
        </div>

        <div>
          <dt>
            <Location size={16} />
            Location
          </dt>
          <dd>Miami, FL</dd>
        </div>

        <div>
          <dt>
            <Cancer size={16} />
            Sun
          </dt>
          <dd>Cancer</dd>
        </div>

        <div>
          <dt>
            <Leo size={16} />
            Moon
          </dt>
          <dd>Sagittarius</dd>
        </div>

        <div>
          <dt>
            <Scorpio size={16} />
            Rising
          </dt>
          <dd>Scorpio</dd>
        </div>

        <div>
          <dt>Also</dt>
          <dd>cricket, calisthenics, minimalism</dd>
        </div>
      </dl>
    </section>
  </Wrapper>
</Layout>

<style>
  .about-hero {
    display: flow-root;
    margin-bottom: 3.5rem;
  }

  .about-copy {
    max-width: 42rem;
  }

  .about-kicker {
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-family: Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .about-lede {
    color: var(--f-low);
    font-size: 1.08rem;
    line-height: 1.9;
  }

  .about-lede strong {
    color: var(--f-high);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .about-section {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--f-low) 16%, transparent);
  }

  .fact-list {
    margin: 1rem 0 0;
  }

  .fact-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.75rem;
  }

  .fact-list div {
    min-width: 0;
  }

  .fact-list dt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.2rem;
    color: var(--f-high);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .fact-list dd {
    margin: 0;
    color: var(--f-low);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .about-hero {
      margin-bottom: 2.75rem;
    }

    .fact-list {
      grid-template-columns: 1fr;
    }
  }
</style>
