---
import Layout from '~/layouts/Layout.astro';
import Wrapper from '~/components/wrapper.astro';
---

<Layout title="404" description="page not found, definitely a bug.">
	<Wrapper>
		<header class="page-head">
			<p class="meta">error[E404]: route not found</p>
			<h1 class="page-title">nothing lives here.</h1>
			<p class="page-lede">
				looks like a bug, or maybe a broken bookmark.
			</p>
		</header>
		<a class="more-link" href="/">back home</a>
	</Wrapper>
</Layout>

<style>
	.meta {
		margin: 0 0 0.9rem;
	}

	.more-link {
		margin-top: 0;
	}
</style>
