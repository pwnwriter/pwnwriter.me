---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import { recognition } from "~/data/recognition";
---

<Layout
  title="recognition"
  description="Wins, placements, talks, and rooms i got invited into."
>
  <Wrapper>
    <header class="page-head">
      <h1 class="page-title">recognition</h1>
      <p class="page-lede">
        wins, placements, talks, and rooms i got invited into. newest first.
      </p>
    </header>

    <ul role="list" class="rows recognition">
      {
        recognition.map((item) => {
          const Tag = item.href ? "a" : "div";
          const context = [item.where, item.year].filter(Boolean).join(", ");
          const summary = [context, item.note].filter(Boolean).join(". ");
          return (
            <li>
              <Tag class="row" href={item.href}>
                <span class="row-title">{item.title}</span>
                <span class="row-leader" aria-hidden="true" />
                <span class="row-date result">{item.result}</span>
              </Tag>
              {summary && <p class="row-sum">{summary}</p>}
              {item.image && (
                <a class="proof" href={item.image.src} target="_blank" rel="noopener">
                  <img src={item.image.src} alt={item.image.alt} loading="lazy" />
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </Wrapper>
</Layout>

<style>
  .recognition li + li {
    margin-top: 0.9rem;
  }

  .recognition .row {
    padding-bottom: 0.1rem;
  }

  /* a scan of the thing itself, small, full size on click */
  .proof {
    display: block;
    width: 11rem;
    margin-top: 0.8rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
  }

  .proof img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.2s ease;
  }

  .proof:hover img {
    opacity: 0.88;
  }

  /* the one place the accent speaks: what was actually won */
  .result {
    color: var(--accent);
  }
</style>
