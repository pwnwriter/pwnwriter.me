---
import Layout from "~/layouts/Layout.astro";
import PostList from "~/components/post-list.astro";
import { getCollection } from "astro:content";
const posts = await getCollection("posts");
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Layout
  title="Notes"
  description="Field notes on security, Linux, Nix, and building software."
  ><div class="shell">
    <header class="page-head">
      <p class="eyebrow">The notebook</p><h1>Things worth writing down.</h1><p
        class="page-lede"
      >
        Notes from building, breaking, and figuring it out.
      </p>
    </header><div class="list-tools">
      <label class="search"
        ><span aria-hidden="true">⌕</span><input
          type="search"
          aria-label="Search notes"
          placeholder="Find a note…"
          data-search-input
        /></label
      ><span class="meta" data-result-count aria-live="polite"
        >{posts.length} notes</span>
    </div><div class="chips" aria-label="Filter by topic">
      <button class="chip chip--active" aria-pressed="true" data-topic="all"
        >All</button
      >{
        tags.map((tag) => (
          <button class="chip" aria-pressed="false" data-topic={tag}>
            {tag}
          </button>
        ))
      }
    </div><PostList /><p hidden data-empty>
      No notes match. Try another word or topic.
    </p>
  </div></Layout
>
<script>
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-topic]"),
  ];
  const entries = [...document.querySelectorAll<HTMLElement>(".post-item")];
  let topic = "all";
  function filter() {
    const terms = (input?.value.toLowerCase().trim() ?? "")
      .split(/\s+/)
      .filter(Boolean);
    let count = 0;
    entries.forEach((entry) => {
      const visible =
        (topic === "all" || entry.dataset.tags?.split(",").includes(topic)) &&
        terms.every((term) => entry.dataset.search?.includes(term));
      entry.hidden = !visible;
      if (visible) count++;
    });
    const label = document.querySelector("[data-result-count]");
    if (label) label.textContent = `${count} ${count === 1 ? "note" : "notes"}`;
    document
      .querySelector("[data-empty]")
      ?.toggleAttribute("hidden", count !== 0);
  }
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      topic = button.dataset.topic ?? "all";
      buttons.forEach((item) => {
        item.classList.toggle("chip--active", item === button);
        item.setAttribute("aria-pressed", String(item === button));
      });
      filter();
    }),
  );
  input?.addEventListener("input", filter);
</script>
