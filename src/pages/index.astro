---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import { getCollection } from "astro:content";
import { projects } from "~/pages/projects/projects";
import { recognition } from "~/data/recognition";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const latest = recognition.slice(0, 2);
const work = projects.filter((project) => !project.archived).slice(0, 2);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

<Layout title="~" description="pwn::musings.">
  <Wrapper>
    <section class="home-page" aria-labelledby="home-title">
      <header class="intro">
        <h1 id="home-title">hi, i'm nabeen</h1>
        <p>
          i build things, break things, and keep asking why. a CS student and
          hacker in the older sense, living in Linux, security, and
          <a href="https://github.com/NixOS/nixpkgs" target="_blank" rel="noopener noreferrer">nixpkgs</a>.
        </p>
        <p class="intro-aside">
          mostly that means removing a few lines of text from some files.
        </p>

        <figure class="portrait">
          <div class="portrait-frame">
            <img
              src="/images/blackhat26/me-at-blackhat.jpeg"
              alt="Nabeen at Black Hat USA, wearing the conference badge"
              width="768"
              height="1024"
              decoding="async"
            />
        </div>
          <figcaption class="meta">black hat usa, 2026</figcaption>
        </figure>
      </header>

      <section aria-labelledby="writing-label">
        <div class="section-head">
          <h2 class="section-label" id="writing-label">writing</h2>
          <a class="more-link" href="/notes">all notes</a>
        </div>
        <ul class="rows">
          {
            posts.map((post) => (
              <li>
                <a class="row" href={`/notes/${post.slug}`}>
                  <span class="row-title">{post.data.title}</span>
                  <span class="row-leader" aria-hidden="true" />
                  <time
                    class="row-date"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="work-label">
        <div class="section-head">
          <h2 class="section-label" id="work-label">selected work</h2>
          <a class="more-link" href="/projects">all projects</a>
        </div>
        <ul class="work">
          {
            work.map((project) => (
              <li>
                <a href={`/projects#${project.slug}`}>
                  <span class="work-name">{project.name}</span>
                  <span class="work-sum">{project.tagline ?? project.summary}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="recognition-label">
        <div class="section-head">
          <h2 class="section-label" id="recognition-label">recognition</h2>
          <a class="more-link" href="/recognition">all recognition</a>
        </div>
        <ul class="rows">
          {
            latest.map((item) => {
              const Tag = item.href ? "a" : "div";
              return (
                <li>
                  <Tag class="row" href={item.href}>
                    <span class="row-title">{item.title}</span>
                    <span class="row-leader" aria-hidden="true" />
                    <span class="row-date result">{item.result}</span>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </section>
    </section>
  </Wrapper>
</Layout>

<style>
  .home-page > section {
    margin-top: 1.9rem;
  }

  /* label, rule, and the "all" link share one line instead of costing a row */
  .section-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.45rem;
  }

  .section-head .section-label {
    flex: 1;
    margin: 0;
  }

  .section-head .more-link {
    margin: 0;
  }

  /* text on the left, a slim portrait on the right running the intro's height */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8.5rem;
    column-gap: 2.5rem;
  }

  .intro > :not(.portrait) {
    grid-column: 1;
  }

  .portrait {
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: start;
    margin: 0.4rem 0 0;
  }

  .portrait-frame {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--b-med);
  }

  /* the source is a wide mirror shot: zoom in on the person, badge in frame */
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.5);
    transform-origin: 46% 58%;
    filter: grayscale(0.3);
    transition: filter 0.3s ease;
  }

  .portrait:hover img {
    filter: none;
  }

  /* the photo is mostly cream wall, which glares on the dark theme */
  :global(:root.dark) .portrait img {
    filter: grayscale(0.3) brightness(0.82);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not(.light)) .portrait img {
      filter: grayscale(0.3) brightness(0.82);
    }
  }

  :global(:root) .portrait:hover img {
    filter: none;
  }

  .portrait figcaption {
    margin-top: 0.55rem;
    font-size: 0.64rem;
  }

  .intro h1 {
    margin: 0 0 0.8rem;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 6.5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .intro p {
    max-width: 34rem;
    margin: 0;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: clamp(1.14rem, 2.6vw, 1.24rem);
    font-weight: 400;
    line-height: 1.5;
  }

  .intro p + p {
    margin-top: 0.55rem;
  }

  .intro .intro-aside {
    color: var(--f-mute);
    font-size: 1.05rem;
  }

  .intro a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--f-low) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.15s ease;
  }

  .intro a:hover {
    text-decoration-color: var(--accent);
  }

  /* the one place the accent speaks: what was actually won */
  .result {
    color: var(--accent);
  }

  .home-page .row {
    padding: 0.3rem 0;
  }

  .work {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work a {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.2rem 1.5rem;
    align-items: baseline;
    padding: 0.3rem 0;
    color: inherit;
    text-decoration: none;
  }

  .work-name {
    color: var(--f-high);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    transition: color 0.15s ease;
  }

  .work-sum {
    color: var(--f-low);
    font-family: var(--font-serif);
    font-size: 1.12rem;
    line-height: 1.45;
  }

  .work a:hover .work-name,
  .work a:focus-visible .work-name {
    color: var(--accent);
  }

  /* phones: a small portrait beside the headline and bio, so the photo
     doesn't cost a whole screen of scrolling */
  @media (max-width: 640px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 5.75rem;
      column-gap: 1rem;
    }

    .portrait {
      grid-row: 1 / span 2;
    }

    .portrait figcaption {
      display: none;
    }

    .intro .intro-aside {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .home-page > section {
      margin-top: 1.75rem;
    }

    .work a {
      grid-template-columns: 1fr;
    }
  }
</style>
