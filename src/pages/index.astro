---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Paragraph from "~/components/text/paragraph.astro";
import Link from "~/components/link.astro";
import PostList from "~/components/post-list.astro";
import { projects } from "~/pages/projects/projects";
import "~/styles/index.css";

// lead with the first few projects (order set in projects.ts)
const featured = projects.slice(0, 3);
const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="~" description="pwn::musings.">
  <Wrapper>
    <section class="hero">
      <div class="avatar-wrap">
        <img
          src="https://avatars.githubusercontent.com/u/90331517?s=400&u=69e445f801cc183e3657c7890b3178987577c5fa&v=4"
          alt="pwnwriter"
        />
      </div>
      <div>
        <h1 class="handwritten">
          Hi! I am <span class="shimmer">Nabeen</span>
        </h1>
        <Paragraph>
          I like making computers feel less borrowed and more personal.
        </Paragraph>
        <Paragraph>
          Most of this site is me following a thread, breaking something,
          fixing it, and leaving a note for whoever finds the same mess later.
          The rest is stuff I made and still like enough to <a
            href="https://github.com/pwnwriter"
            target="_blank"
            rel="noopener noreferrer">enjoy</a
          >.
        </Paragraph>
      </div>
    </section>

    <div class="divider"></div>

    <section class="section">
      <!-- <Subheading Element="h2">Notes</Subheading> -->
      <PostList max={3} />
      <Link href="/notes">{"{ All notes }"}&nbsp;&nbsp;&Rarr;</Link>
    </section>

    {
      featured.length > 0 && (
        <>
          <div class="divider" />

          <section class="section">
            <div class="work-fold">
              <div class="work-heading">
                <span class="wf-prompt" aria-hidden="true">
                  &rsaquo;
                </span>
                <span class="wf-cmd">things i've built</span>
                <span class="wf-cursor" aria-hidden="true" />
                <span class="wf-rule" aria-hidden="true" />
              </div>
              <div class="home-projects mt-6 mb-4">
                {featured.map((p, i) => {
                  const cover = p.cover ?? p.media[0];
                  const isVideo = cover.kind === "video";
                  const poster =
                    cover.kind === "image" ? cover.src : cover.poster;
                  return (
                    <article class="home-project-row">
                      <a href="/projects" class="hp-media" aria-label={p.name}>
                        {isVideo ? (
                          <video
                            class="hp-video"
                            src={cover.src}
                            poster={poster ?? undefined}
                            muted
                            loop
                            playsinline
                            preload="metadata"
                          />
                        ) : (
                          poster && (
                            <img
                              class="hp-img"
                              src={poster}
                              alt={p.name}
                              loading="lazy"
                            />
                          )
                        )}
                        <span class="hp-glow" aria-hidden="true" />
                        {isVideo && (
                          <span class="hp-badge" aria-hidden="true">
                            ▶ play
                          </span>
                        )}
                      </a>

                      <div class="hp-body">
                        <span class="hp-eyebrow">
                          {pad(i + 1)}
                          {p.year && <> &middot; {p.year}</>}
                        </span>
                        <h3 class="hp-name">
                          <a href="/projects">{p.name}</a>
                        </h3>
                        <p class="hp-blurb">{p.blurb}</p>

                        {p.tech.length > 0 && (
                          <ul class="hp-tech">
                            {p.tech.map((t) => (
                              <li>{t}</li>
                            ))}
                          </ul>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
              <Link href="/projects">
                {"{ All projects }"}&nbsp;&nbsp;&Rarr;
              </Link>
            </div>
          </section>
        </>
      )
    }
  </Wrapper>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 640px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  .avatar-wrap {
    flex-shrink: 0;
    position: relative;
    padding: 0.35rem;
  }

  /* dashed accent ring that spins up on hover */
  .avatar-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    animation: avatar-spin 18s linear infinite;
    animation-play-state: paused;
    transition: opacity 0.3s;
    opacity: 0.6;
  }

  .avatar-wrap:hover::before {
    animation-play-state: running;
    opacity: 1;
  }

  .avatar-wrap img {
    position: relative;
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid color-mix(in srgb, var(--f-low) 25%, transparent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 40%, transparent);
    transition:
      border-color 0.3s,
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }

  .avatar-wrap:hover img {
    border-color: var(--accent);
    box-shadow: 0 6px 22px -6px
      color-mix(in srgb, var(--accent) 55%, transparent);
    transform: scale(1.04) rotate(-2deg);
  }

  @keyframes avatar-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-wrap::before {
      animation: none;
    }
    .avatar-wrap:hover img {
      transform: none;
    }
  }

  .divider {
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--f-low) 25%, transparent),
      transparent
    );
    margin-bottom: 3rem;
  }

  .section {
    margin-bottom: 3rem;
  }

  .work-label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--f-low) 55%, transparent);
  }

  /* ---- Projects: a living terminal prompt (Rosé Pine) ---- */
  .work-heading {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0;
    font-family: Menlo, ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
    color: var(--f-low);
    transition: color 0.25s ease;
  }

  .work-heading:hover {
    color: var(--f-high);
  }

  .wf-prompt {
    font-weight: 700;
    color: var(--accent);
  }

  .wf-cmd {
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* blinking accent block cursor — the line reads as "alive" */
  .wf-cursor {
    display: inline-block;
    width: 0.5em;
    height: 1.05em;
    margin-left: -0.15rem;
    background: var(--accent);
    border-radius: 1px;
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 55%, transparent);
    animation: wf-blink 1.15s steps(1, end) infinite;
  }
  @keyframes wf-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  /* hairline that fills the row and draws itself open */
  .wf-rule {
    flex: 1;
    height: 1px;
    transform-origin: left center;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--f-low) 22%, transparent),
      transparent
    );
    transition: background 0.25s ease;
  }
  .work-heading:hover .wf-rule {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--accent) 50%, transparent),
      transparent
    );
  }
  .work-fold .wf-rule {
    animation: wf-draw 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes wf-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* rows render like terminal output: cascade, blur -> focus */
  .home-projects > * {
    animation: wf-card 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .home-projects > *:nth-child(1) {
    animation-delay: 0.08s;
  }
  .home-projects > *:nth-child(2) {
    animation-delay: 0.15s;
  }
  .home-projects > *:nth-child(3) {
    animation-delay: 0.22s;
  }
  @keyframes wf-card {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-rule,
    .work-heading {
      transition: none;
    }
    .wf-cursor {
      animation: none;
    }
    .work-fold .wf-rule,
    .home-projects > * {
      animation: none;
    }
  }

  /* ---- Homepage projects: compact version of /projects rows ---- */
  .home-projects {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .home-project-row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.75rem;
    align-items: center;
  }

  .home-project-row:nth-child(even) .hp-media {
    order: 2;
  }

  .hp-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--f-low) 12%, transparent);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 16%, transparent),
      color-mix(in srgb, var(--f-low) 8%, transparent)
    );
    box-shadow: 0 12px 34px -25px
      color-mix(in srgb, var(--f-high) 38%, transparent);
    text-decoration: none;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .hp-media:hover,
  .hp-media:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 32%, transparent);
    box-shadow: 0 18px 42px -24px
      color-mix(in srgb, var(--f-high) 45%, transparent);
    outline: none;
  }

  .hp-img,
  .hp-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hp-media:hover .hp-img,
  .hp-media:hover .hp-video {
    transform: scale(1.03);
  }

  .hp-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.24), transparent 45%);
    opacity: 0.68;
  }

  .hp-badge {
    position: absolute;
    bottom: 0.7rem;
    left: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.42);
    color: white;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    backdrop-filter: blur(4px);
    transition: background 0.25s ease;
  }

  .hp-media:hover .hp-badge {
    background: color-mix(in srgb, var(--accent) 72%, black);
  }

  .hp-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .hp-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--f-low) 55%, transparent);
  }

  .hp-name {
    color: var(--f-high);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .hp-name a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0% 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition:
      color 0.2s ease,
      background-size 0.2s ease;
  }

  .hp-name a:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }

  .hp-blurb {
    max-width: 34ch;
    color: var(--f-low);
    font-size: 0.86rem;
    line-height: 1.58;
  }

  .hp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.05rem;
  }

  .hp-tech li {
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 5px;
    color: color-mix(in srgb, var(--accent) 90%, var(--f-high));
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    padding: 0.06rem 0.45rem;
  }

  @media (max-width: 760px) {
    .home-projects {
      gap: 3rem;
    }

    .home-project-row:nth-child(n + 3) {
      display: none;
    }

    .home-project-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .home-project-row:nth-child(even) .hp-media,
    .home-project-row .hp-media {
      order: 0;
    }

    .hp-name {
      font-size: 1.25rem;
    }

    .hp-blurb {
      max-width: none;
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .hp-tech {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-media,
    .hp-img,
    .hp-video,
    .hp-name a {
      transition: none;
    }
    .hp-media:hover {
      transform: none;
    }
  }

  .handwritten {
    font-family: "Caveat", cursive;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--f-high);
    margin-bottom: 1.5rem;
    transform: rotate(-0.5deg);
    letter-spacing: 0.02em;
  }
</style>

<script>
  const reduceMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Autoplay clips only while visible, matching the projects page behavior.
  function initWorkAutoplay() {
    if (reduceMotion()) return;
    const vids =
      document.querySelectorAll<HTMLVideoElement>("video.hp-video");
    if (!vids.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.4 },
    );

    vids.forEach((v) => io.observe(v));
  }

  function initWork() {
    initWorkAutoplay();
  }

  document.addEventListener("DOMContentLoaded", initWork);
  if (document.readyState !== "loading") initWork();
</script>
