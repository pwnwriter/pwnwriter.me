---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import PixelHand from "~/components/pixel-hand.astro";
import SketchSignoff from "~/components/sketch-signoff.astro";
import { getCollection } from "astro:content";
import "~/styles/index.css";

// status hidden behind the avatar badge, revealed (and wobbling) on hover.
const status = "haw?";
const statusEmoji = "🐛";
const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

const formatDate = (date: Date) =>
  date.toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const cleanMarkdown = (value = "") =>
  value
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\[[^\]]+\]/g, "$1")
    .replace(/<\/?[^>]+>/g, " ")
    .replace(/^[#>*\-\s]+/gm, "")
    .replace(/[_*~]/g, "")
    .replace(/\s+/g, " ")
    .trim();

const excerpt = (value = "", maxLength = 130) => {
  const cleaned = cleanMarkdown(value);

  if (cleaned.length <= maxLength) {
    return cleaned;
  }

  return `${cleaned.slice(0, maxLength).replace(/\s+\S*$/, "")}...`;
};

const summaryFor = (post: (typeof posts)[number]) =>
  post.data.description ?? excerpt(post.body);
---

<Layout title="~" description="pwn::musings.">
  <Wrapper>
    <section class="home-page home-log" aria-labelledby="home-title">
      <header class="intro-block">
        <div class="id-row">
          <figure class="avatar">
            <img
              src="/images/blackhat26/me-avatar.jpeg"
              alt="Nabeen"
              width="400"
              height="400"
            />
            <span
              class="status-badge"
              tabindex="0"
              role="img"
              aria-label={`status: ${status}`}
            >
              <span class="status-emoji" aria-hidden="true">{statusEmoji}</span>
              <span class="status-pop" aria-hidden="true">{status}</span>
            </span>
          </figure>

          <div class="id-text">
            <h1 id="home-title">hi, i'm nabeen</h1>
            <p class="handle">
              @pwnwriter <span class="dot-sep" aria-hidden="true">·</span>
              <span class="handle-tag" tabindex="0">coffee. code. pwn.</span>
            </p>
          </div>
        </div>

        <div class="bio">
          <p>
            apparently i build things, break things, and keep asking why long
            after the how makes sense. a CS student and hacker in the older
            sense: i live around <span class="mark" style="--mark-delay: 0.4s">Linux</span>
            and security, package for
            <span class="mark" style="--mark-delay: 0.7s">nixpkgs</span>, and
            daily-drive NixOS.
          </p>
          <p class="bio-aside">
            look closely enough, though, and most of it is just me adding,
            changing, or preferably removing a few lines of text from some files.
          </p>
        </div>
      </header>

      <section class="latest" aria-labelledby="latest-title">
        <p class="section-label" id="latest-title">recent notes</p>
        <div class="notes-grid">
          {posts.map((post) => (
            <a class="note-card" href={`/notes/${post.slug}`}>
              <h2>{post.data.title}</h2>
              <p class="note-sum">{summaryFor(post)}</p>
              <div class="note-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                {post.data.tags?.length > 0 && (
                  <span class="note-tags">{post.data.tags.join(", ")}</span>
                )}
              </div>
            </a>
          ))}
        </div>
        <div class="more-row">
          <a class="more-notes" href="/notes">
            <PixelHand />
            <span>more notes</span>
          </a>
        </div>
      </section>

      <SketchSignoff />
    </section>
  </Wrapper>
</Layout>

<style>
  .home-log {
    position: relative;
    max-width: 54rem;
    margin: 0 auto;
  }

  /* github-profile-style hero, stacked: an id-row (avatar + name/handle) on
     top, a relaxed bio below it, then a compact links row. */
  .intro-block {
    display: block;
  }

  .id-row {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .id-text {
    min-width: 0;
  }

  .section-label,
  .latest-list time {
    font-family: var(--font-mono);
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .intro-block h1 {
    margin: 0;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 4.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .handle {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: lowercase;
    color: color-mix(in srgb, var(--f-low) 58%, transparent);
  }

  /* the "coffee. code. pwn." tag: accent-tinted, and it wobbles when hovered
     or focused - a small playful reward for poking at it. */
  .handle-tag {
    display: inline-block;
    color: color-mix(in srgb, var(--accent) 82%, var(--f-high));
    cursor: default;
    outline: none;
    transform-origin: center 60%;
  }

  .handle-tag:hover,
  .handle-tag:focus-visible {
    animation: wobble 0.6s ease;
  }

  @keyframes wobble {
    0%,
    100% {
      transform: rotate(0);
    }
    20% {
      transform: rotate(-4deg) scale(1.04);
    }
    40% {
      transform: rotate(3deg) scale(1.04);
    }
    60% {
      transform: rotate(-2deg) scale(1.02);
    }
    80% {
      transform: rotate(1deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .handle-tag:hover,
    .handle-tag:focus-visible,
    .status-badge:hover .status-emoji,
    .status-badge:focus-visible .status-emoji {
      animation: none;
    }
  }

  /* relaxed multi-line bio, hand-drawn marks on a couple of key phrases */
  .bio {
    max-width: 38rem;
    margin-top: 1.7rem;
  }

  .bio p {
    margin: 0 0 1.15rem;
    color: color-mix(in srgb, var(--f-low) 92%, var(--f-high));
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .bio p:last-child {
    margin-bottom: 0;
  }

  .bio-aside {
    color: color-mix(in srgb, var(--f-low) 62%, transparent) !important;
    font-size: 0.94rem !important;
    font-style: italic;
  }

  /* --- circular avatar + github-style status badge --- */
  .avatar {
    position: relative;
    flex: none;
    width: 5.4rem;
    height: 5.4rem;
    margin: 0;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 35%;
    border: 1px solid color-mix(in srgb, var(--f-low) 22%, transparent);
    background: var(--b-high);
    /* muted by default, warms to full color on hover - a small profile touch */
    filter: grayscale(0.5);
    transition: filter 300ms ease;
  }

  .avatar:hover img {
    filter: grayscale(0);
  }

  .status-badge {
    position: absolute;
    right: -0.3rem;
    bottom: -0.1rem;
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    background: var(--b-high);
    border: 1px solid color-mix(in srgb, var(--f-low) 20%, transparent);
    box-shadow: 0 1px 4px color-mix(in srgb, #000 12%, transparent);
    cursor: default;
    outline: none;
  }

  .status-emoji {
    font-size: 1rem;
    line-height: 1;
  }

  /* the status text, hidden until the badge is hovered/focused - github style */
  .status-pop {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    transform: translate(-50%, 4px);
    width: max-content;
    max-width: 16rem;
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--f-low) 18%, transparent);
    background: color-mix(in srgb, var(--b-high) 97%, transparent);
    color: color-mix(in srgb, var(--accent) 82%, var(--f-high));
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
    z-index: 3;
  }

  .status-pop::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: color-mix(in srgb, var(--b-high) 97%, transparent);
  }

  .status-badge:hover .status-pop,
  .status-badge:focus-visible .status-pop {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .status-emoji {
    transform-origin: center 70%;
  }

  .status-badge:hover .status-emoji,
  .status-badge:focus-visible .status-emoji {
    animation: wobble 0.6s ease;
  }

  @media (min-width: 640px) {
    .avatar {
      width: 6.4rem;
      height: 6.4rem;
    }
    .status-badge {
      width: 2.1rem;
      height: 2.1rem;
    }
    .status-emoji {
      font-size: 1.15rem;
    }
  }

  /* rough marker underline that sits just under the text */
  .mark {
    position: relative;
    white-space: nowrap;
  }

  .mark::after {
    content: "";
    position: absolute;
    right: -0.05em;
    bottom: -0.04em;
    left: -0.05em;
    z-index: -1;
    height: 0.16em;
    background: var(--accent);
    border-radius: 1px;
    opacity: 0.72;
    /* start collapsed on the left, then get "drawn" in on load like a marker.
       each mark carries its own --mark-delay so they sweep in one after another */
    transform: rotate(-0.7deg) scaleX(0);
    transform-origin: left center;
    animation: mark-draw 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--mark-delay, 0.5s);
  }

  @keyframes mark-draw {
    to {
      transform: rotate(-0.7deg) scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark::after {
      animation: none;
      transform: rotate(-0.7deg) scaleX(1);
    }
  }

  .dot-sep {
    color: color-mix(in srgb, var(--f-low) 26%, transparent);
  }

  .latest {
    margin-top: 3rem;
  }

  .section-label {
    margin: 0 0 0.35rem;
    color: color-mix(in srgb, var(--f-low) 58%, transparent);
    font-size: 0.68rem;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.7rem 1.6rem;
    margin-top: 1.1rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--f-low) 13%, transparent);
  }

  .note-card {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    color: inherit;
    text-decoration: none;
  }

  .note-card h2 {
    margin: 0;
    overflow: hidden;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: 1.16rem;
    font-weight: 600;
    line-height: 1.22;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 150ms ease;
  }

  .note-card:hover h2,
  .note-card:focus-visible h2 {
    color: var(--accent);
  }

  .note-card:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    outline-offset: 4px;
    border-radius: 3px;
  }

  .note-sum {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 72%, transparent);
    font-size: 0.82rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .note-meta {
    display: flex;
    gap: 0.6ch;
    align-items: baseline;
    margin-top: 0.15rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.4;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .note-meta time {
    flex: none;
    color: color-mix(in srgb, var(--f-low) 62%, transparent);
  }

  .note-tags {
    min-width: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 30%, transparent);
    text-overflow: ellipsis;
  }

  .more-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.7rem;
  }

  .more-notes {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: color-mix(in srgb, var(--f-low) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: lowercase;
    text-decoration: none;
  }

  .more-notes span {
    position: relative;
    top: 0.05rem;
  }

  .more-notes :global(.pixel-hand) {
    transition: transform 160ms ease;
  }

  .more-notes:hover {
    color: var(--f-high);
  }

  .more-notes:hover :global(.pixel-hand) {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .more-notes:hover :global(.pixel-hand) {
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .notes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .id-row {
      gap: 1rem;
    }

    .bio {
      margin-top: 1.35rem;
    }

    .bio p {
      font-size: 0.98rem;
      line-height: 1.65;
      margin-bottom: 0.95rem;
    }

    .latest {
      margin-top: 1.8rem;
    }

    .notes-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 0.7rem;
      padding-top: 0.9rem;
    }

    /* keep the mobile home short - only the 3 most recent notes */
    .note-card:nth-child(n + 4) {
      display: none;
    }
  }
</style>

<style is:global>
  /* the notes card grid needs more room than the default reading column, so
     give the home page a wider wrapper (headline + bio stay capped narrower). */
  body:has(.home-page) main .mx-auto.max-w-3xl {
    max-width: 56rem;
  }

  body:has(.home-page) header {
    margin-top: 1.25rem;
  }

  body:has(.home-page) > .h-xl {
    height: 1.75rem;
  }

  body:has(.home-page) footer {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  body:has(.home-page) footer p {
    margin-top: 0.65rem;
  }

  body:has(.home-page) main {
    display: flex;
    align-items: center;
  }

  body:has(.home-page) main > * {
    width: 100%;
  }

  /* on phones there's more content than viewport, so top-align it and let the
     page scroll normally instead of vertically centering (which can clip the
     top of tall content). */
  @media (max-width: 720px) {
    body:has(.home-page) main {
      display: block;
    }
  }

  @media (max-height: 760px) and (min-width: 760px) {
    body:has(.home-page) header {
      margin-top: 0.75rem;
    }

    body:has(.home-page) > .h-xl {
      height: 1rem;
    }
  }

  body:has(.home-page) .branches-canvas {
    opacity: 0.16;
  }
</style>
