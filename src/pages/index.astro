---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import PixelHand from "~/components/pixel-hand.astro";
import SketchSignoff from "~/components/sketch-signoff.astro";
import { getCollection } from "astro:content";
import "~/styles/index.css";

const tagline = "Coffee. Code. Pwn.";
const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

const formatDate = (date: Date) =>
  date.toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const cleanMarkdown = (value = "") =>
  value
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\[[^\]]+\]/g, "$1")
    .replace(/<\/?[^>]+>/g, " ")
    .replace(/^[#>*\-\s]+/gm, "")
    .replace(/[_*~]/g, "")
    .replace(/\s+/g, " ")
    .trim();

const excerpt = (value = "", maxLength = 130) => {
  const cleaned = cleanMarkdown(value);

  if (cleaned.length <= maxLength) {
    return cleaned;
  }

  return `${cleaned.slice(0, maxLength).replace(/\s+\S*$/, "")}...`;
};

const summaryFor = (post: (typeof posts)[number]) =>
  post.data.description ?? excerpt(post.body);
---

<Layout title="~" description="pwn::musings.">
  <Wrapper>
    <section class="home-page home-log" aria-labelledby="home-title">
      <header class="intro-block">
        <div>
          <h1 id="home-title">hi, i'm nabeen</h1>
          <p class="tagline glitch" data-text={tagline}>{tagline}</p>
        </div>
        <figure class="photo-stamp">
          <img
            src="/images/blackhat26/me-at-blackhat.jpeg"
            alt="Nabeen at Black Hat"
            width="120"
            height="150"
          />
        </figure>
      </header>

      <div class="bio">
        <p>
          i spend an unreasonable amount of time <span class="mark" style="--mark-delay: 0.5s">chasing questions</span>
          that probably didn't need answers.
        </p>

        <p>
          they usually drag me through terminals, systems, security, and
          <span class="mark" style="--mark-delay: 0.9s">Nix</span> taking things
          apart until the weird parts start to make sense.
        </p>

        <p>
          every now and then, one of those rabbit holes turns into
          <span class="mark" style="--mark-delay: 1.3s">something worth shipping</span>.
        </p>

        <aside class="margin-note" aria-hidden="true">yes, it's neovim</aside>
      </div>

      <section class="latest" aria-labelledby="latest-title">
        <p class="section-label" id="latest-title">recent notes</p>
        <div class="notes-grid">
          {posts.map((post) => (
            <a class="note-card" href={`/notes/${post.slug}`}>
              <h2>{post.data.title}</h2>
              <p class="note-sum">{summaryFor(post)}</p>
              <div class="note-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                {post.data.tags?.length > 0 && (
                  <span class="note-tags">{post.data.tags.join(", ")}</span>
                )}
              </div>
            </a>
          ))}
        </div>
        <div class="more-row">
          <a class="more-notes" href="/notes">
            <PixelHand />
            <span>more notes</span>
          </a>
        </div>
      </section>

      <SketchSignoff />
    </section>
  </Wrapper>
</Layout>

<style>
  .home-log {
    position: relative;
    max-width: 54rem;
    margin: 0 auto;
  }

  /* mobile-first: headline + a small photo sit side by side */
  .intro-block {
    display: flex;
    align-items: center;
    gap: 1.3rem;
  }

  .intro-block > div {
    flex: 0 1 auto;
    min-width: 0;
  }

  .eyebrow,
  .tagline,
  .section-label,
  .latest-list time {
    font-family: var(--font-mono);
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: color-mix(in srgb, var(--f-low) 62%, transparent);
    font-size: 0.68rem;
    line-height: 1;
  }

  .intro-block h1 {
    margin: 0;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4.5vw, 2.3rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .tagline {
    width: fit-content;
    max-width: 32rem;
    margin: 0.5rem 0 0;
    color: color-mix(in srgb, var(--accent) 84%, var(--f-high));
    font-size: 0.98rem;
    line-height: 1.5;
  }

  /* cmrg.me-style echo/glitch: two accent-tinted copies of the text sit just
     behind the real characters and drift on a slow loop, reading as doubled
     letters. the real text stays fully legible on top. */
  .glitch {
    position: relative;
    isolation: isolate;
  }

  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .glitch::before {
    color: color-mix(in srgb, var(--accent) 32%, transparent);
    animation: glitch-shift-a 2.6s steps(2, jump-none) infinite;
  }

  .glitch::after {
    color: color-mix(in srgb, var(--f-low) 24%, transparent);
    animation: glitch-shift-b 3.1s steps(2, jump-none) infinite;
  }

  @keyframes glitch-shift-a {
    0%,
    100% {
      transform: translate(0, 0.4px);
    }
    50% {
      transform: translate(0.5px, -0.5px);
    }
  }

  @keyframes glitch-shift-b {
    0%,
    100% {
      transform: translate(0, -0.4px);
    }
    50% {
      transform: translate(-0.5px, 0.5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch::before {
      transform: translate(0, 0.5px);
      animation: none;
    }
    .glitch::after {
      transform: translate(0, -0.5px);
      animation: none;
    }
  }

  .photo-stamp {
    position: relative;
    flex: none;
    width: 6.5rem;
    margin: 0;
    transform: rotate(2deg);
  }

  /* on wider screens the photo floats out to the right edge of the column,
     top-aligned with the headline and spanning down past the tagline - the
     text (headline + tagline + bio) flows underneath it on the left. */
  @media (min-width: 720px) {
    .intro-block {
      display: block;
    }

    .photo-stamp {
      position: absolute;
      top: 0.5rem;
      right: 0;
      width: 13rem;
    }

    .home-log .bio {
      max-width: 37rem;
    }
  }

  .photo-stamp img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--f-low) 20%, transparent);
    border-radius: 0.35rem;
    object-fit: cover;
    object-position: center top;
    opacity: 0.92;
  }

  .photo-stamp::after {
    content: "";
    position: absolute;
    inset: 0.28rem -0.28rem -0.28rem 0.28rem;
    z-index: -1;
    border: 1px dashed color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: 0.35rem;
  }

  /* cmrg.me-style conversational bio: a few relaxed paragraphs, key phrases
     marked with a hand-drawn accent underline. */
  .bio {
    position: relative;
    max-width: 39rem;
    margin-top: 2.4rem;
  }

  .bio p {
    margin: 0 0 1.4rem;
    color: color-mix(in srgb, var(--f-low) 90%, var(--f-high));
    font-size: clamp(1.05rem, 1.7vw, 1.18rem);
    line-height: 1.95;
  }

  .bio p:last-of-type {
    margin-bottom: 0;
  }

  /* rough marker underline that sits just under the text */
  .mark {
    position: relative;
    white-space: nowrap;
  }

  .mark::after {
    content: "";
    position: absolute;
    right: -0.05em;
    bottom: -0.04em;
    left: -0.05em;
    z-index: -1;
    height: 0.16em;
    background: var(--accent);
    border-radius: 1px;
    opacity: 0.72;
    /* start collapsed on the left, then get "drawn" in on load like a marker.
       each mark carries its own --mark-delay so they sweep in one after another */
    transform: rotate(-0.7deg) scaleX(0);
    transform-origin: left center;
    animation: mark-draw 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--mark-delay, 0.5s);
  }

  @keyframes mark-draw {
    to {
      transform: rotate(-0.7deg) scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark::after {
      animation: none;
      transform: rotate(-0.7deg) scaleX(1);
    }
  }

  /* handwritten scrawl in the right margin - decorative, wide screens only */
  .margin-note {
    display: none;
  }

  @media (min-width: 1140px) {
    .margin-note {
      display: block;
      position: absolute;
      top: 1.4rem;
      right: -12.5rem;
      width: 10rem;
      padding-left: 0.7rem;
      border-left: 1px solid color-mix(in srgb, var(--f-low) 24%, transparent);
      color: color-mix(in srgb, var(--f-low) 66%, transparent);
      font-family: "Caveat", cursive;
      font-size: 1.5rem;
      line-height: 1.1;
      transform: rotate(-5deg);
    }
  }

  .latest {
    margin-top: 3rem;
  }

  .section-label {
    margin: 0 0 0.35rem;
    color: color-mix(in srgb, var(--f-low) 58%, transparent);
    font-size: 0.68rem;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.7rem 1.6rem;
    margin-top: 1.1rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--f-low) 13%, transparent);
  }

  .note-card {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    color: inherit;
    text-decoration: none;
  }

  .note-card h2 {
    margin: 0;
    overflow: hidden;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: 1.16rem;
    font-weight: 600;
    line-height: 1.22;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 150ms ease;
  }

  .note-card:hover h2,
  .note-card:focus-visible h2 {
    color: var(--accent);
  }

  .note-card:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    outline-offset: 4px;
    border-radius: 3px;
  }

  .note-sum {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 72%, transparent);
    font-size: 0.82rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .note-meta {
    display: flex;
    gap: 0.6ch;
    align-items: baseline;
    margin-top: 0.15rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.4;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .note-meta time {
    flex: none;
    color: color-mix(in srgb, var(--f-low) 62%, transparent);
  }

  .note-tags {
    min-width: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--f-low) 30%, transparent);
    text-overflow: ellipsis;
  }

  .more-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.7rem;
  }

  .more-notes {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: color-mix(in srgb, var(--f-low) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: lowercase;
    text-decoration: none;
  }

  .more-notes span {
    position: relative;
    top: 0.05rem;
  }

  .more-notes :global(.pixel-hand) {
    transition: transform 160ms ease;
  }

  .more-notes:hover {
    color: var(--f-high);
  }

  .more-notes:hover :global(.pixel-hand) {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .more-notes:hover :global(.pixel-hand) {
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .notes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .intro-block {
      align-items: center;
      gap: 1.1rem;
    }

    .photo-stamp {
      width: 6rem;
    }

    /* tighter vertical rhythm on phones - the airy desktop spacing is too much
       on a narrow screen */
    .bio {
      margin-top: 1.4rem;
    }

    .bio p {
      margin-bottom: 0.9rem;
      line-height: 1.6;
    }

    .latest {
      margin-top: 1.8rem;
    }

    .notes-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 0.7rem;
      padding-top: 0.9rem;
    }

    /* keep the mobile home short - only the 3 most recent notes */
    .note-card:nth-child(n + 4) {
      display: none;
    }
  }

  @media (max-width: 380px) {
    /* very narrow phones: let the headline sit above the photo instead of
       squeezing them side by side */
    .intro-block {
      flex-wrap: wrap;
    }

    .photo-stamp {
      width: 5.4rem;
    }
  }
</style>

<style is:global>
  /* the notes card grid needs more room than the default reading column, so
     give the home page a wider wrapper (headline + bio stay capped narrower). */
  body:has(.home-page) main .mx-auto.max-w-3xl {
    max-width: 56rem;
  }

  body:has(.home-page) header {
    margin-top: 1.25rem;
  }

  body:has(.home-page) > .h-xl {
    height: 1.75rem;
  }

  body:has(.home-page) footer {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  body:has(.home-page) footer p {
    margin-top: 0.65rem;
  }

  body:has(.home-page) main {
    display: flex;
    align-items: center;
  }

  body:has(.home-page) main > * {
    width: 100%;
  }

  /* on phones there's more content than viewport, so top-align it and let the
     page scroll normally instead of vertically centering (which can clip the
     top of tall content). */
  @media (max-width: 720px) {
    body:has(.home-page) main {
      display: block;
    }
  }

  @media (max-height: 760px) and (min-width: 760px) {
    body:has(.home-page) header {
      margin-top: 0.75rem;
    }

    body:has(.home-page) > .h-xl {
      height: 1rem;
    }
  }

  body:has(.home-page) .branches-canvas {
    opacity: 0.16;
  }
</style>
