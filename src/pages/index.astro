---
// The front page: one photograph, a few lines on who i am, and where to find
// me. Everything else is a word in the bar at the top.
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Gloss from "~/components/gloss.astro";
import { Image } from "astro:assets";
import sf from "~/assets/sf-golden-gate.jpg";


const socials = [
  { label: "GitHub", href: "https://github.com/pwnwriter", d: "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.9 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3" },
  { label: "X", href: "https://x.com/pwnwriter", d: "M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.5h2L6.5 3.2H4.3l13.3 17.5Z" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/pwnwriter", d: "M20.4 20.5h-3.5v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.3ZM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1Zm1.8 13.1H3.6V9h3.5v11.5ZM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7c0-.9-.8-1.7-1.8-1.7Z" },
  { label: "Email", href: "mailto:hi@pwnwriter.me", d: "M1.5 8.7v8.6a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.7l-8.9 5.5a3 3 0 0 1-3.2 0L1.5 8.7Zm21-1.8v-.2a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.2l9.7 6a1.5 1.5 0 0 0 1.6 0l9.7-6Z" },
];
---

<Layout title="~" description="pwn::musings.">
  <Wrapper>
    <figure class="shot">
      <Image
        src={sf}
        alt="me at the Golden Gate Bridge at dusk, San Francisco"
        widths={[560, 880, 1180]}
        sizes="(max-width: 640px) 100vw, 33rem"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="meta">
        the golden gate, on a trip to san francisco for openai devday.
      </figcaption>
    </figure>

    <section class="intro" aria-label="about me">
      <h1 class="sr-only">pwnwriter</h1>
      <p>
        I'm <Gloss term="Nabeen" ipa="/na·veen/" script="नवीन">
          Sanskrit <i>navīna</i>, <b>new</b>: renewal, and the habit of rebuilding
          things that already work.
          <span class="names">
            <span><b>Nabin</b> on paper, and on anything official.</span>
            <span><b>Nabeen</b> online, which is how it is said out loud.</span>
            <span><b>pwnwriter</b> wherever a username is asked for. <i>pwn</i>, to
              break into a thing and own it, and <i>writer</i>, for the part after.</span>
          </span>
        </Gloss>, a <strong>CS student</strong> and hacker in the older
        sense: Linux, security, and
        <a href="https://github.com/NixOS/nixpkgs" target="_blank" rel="noopener noreferrer">nixpkgs</a>,
        mostly from a terminal.
      </p>
      <p>
        I am <span class="age" data-born="2004-07-12T00:00:00+05:45">22</span> and I
        <strong>break things</strong> to see how they work, then write it down. The
        rest of it is on <a href="/work">work</a>.
      </p>
      <p class="socials">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              title={s.label}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "me noopener noreferrer" : undefined}
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d={s.d} />
              </svg>
            </a>
          ))
        }
      </p>
    </section>
  </Wrapper>
</Layout>

<style>
  /* the photograph up top, with one line under it */
  .shot {
    margin: 0.5rem 0 0;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .shot figcaption {
    margin-top: 0.6rem;
    font-size: 0.8rem;
  }

  /* who i am: a few quiet paragraphs. the words that matter are inked, the
     names carry a note, links are underlined and nothing else. */
  .intro {
    padding-top: 2.75rem;
  }

  .intro p {
    max-width: 34rem;
    margin: 0 0 1rem;
    color: var(--f-low);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .intro strong {
    color: var(--f-high);
    font-weight: 600;
  }

  .intro a {
    color: var(--f-high);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--f-low) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .intro a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* the three names, inside the card behind my name */
  .names {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.55rem;
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  /* the live age: tabular digits so the ticking decimals don't jiggle */
  .age {
    color: var(--f-high);
    font-variant-numeric: tabular-nums;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .socials {
    display: flex;
    gap: 1.1rem;
    margin: 1.4rem 0 0;
  }

  .socials a {
    color: var(--f-mute);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .socials a:hover {
    color: var(--f-high);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .socials a:hover {
      transform: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // the age: years since birth, to nine decimals, ticking every frame-ish.
  // a year here is the mean tropical year, which is what a birthday counts.
  const age = document.querySelector<HTMLElement>(".age");
  if (age && age.dataset.born) {
    const born = new Date(age.dataset.born).getTime();
    const YEAR = 365.2422 * 24 * 60 * 60 * 1000;
    const tick = () => {
      age.textContent = ((Date.now() - born) / YEAR).toFixed(9);
    };
    tick();
    if (!reduce) setInterval(tick, 50);
  }

</script>
