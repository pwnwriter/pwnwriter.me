---
import "~/styles/syndications.css";
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDate } from "~/lib/utils";

const syndications: CollectionEntry<"syndications">[] =
  await getCollection("syndications");

syndications.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

// Group by year
const grouped: Record<number, CollectionEntry<"syndications">[]> = {};
for (const s of syndications) {
  const year = s.data.pubDate.getFullYear();
  if (!grouped[year]) grouped[year] = [];
  grouped[year].push(s);
}
const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);

// Collect unique tags for filter chips
const allTags = [...new Set(syndications.flatMap((s) => s.data.tags || []))].sort();

function excerpt(entry: CollectionEntry<"syndications">): string {
  const cleaned = entry.body
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_~{}[\]()-]/g, "")
    .replace(/\s+/g, " ")
    .trim();

  return cleaned.length > 132 ? `${cleaned.slice(0, 132).trim()}...` : cleaned;
}
---

<Layout title="Syndications" description="Personal updates and reflections.">
  <Wrapper>
    <div class="syn">
      <div class="syn-header">
        <h1 class="syn-title">syndications</h1>
        <p>
          small traces from the timeline: life, code, school, travel, and things
          i probably edited later.
        </p>
      </div>

      <div class="syn-filters" role="tablist">
        <button class="syn-chip syn-chip--active" data-filter="all">all</button>
        {allTags.map((tag) => (
          <button class="syn-chip" data-filter={tag}>{tag}</button>
        ))}
      </div>

      <div class="syn-search-row">
        <span class="syn-count" data-syn-count>{syndications.length} entries</span>
        <label class="syn-search" data-search-shell>
          <span aria-hidden="true">⌕</span>
          <input
            type="search"
            placeholder="Find it faster"
            aria-label="Search syndications"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            data-syn-search
          />
          <button type="button" aria-label="Clear search" data-syn-clear>×</button>
        </label>
      </div>

      <div class="syn-log">
        {years.map((year) => (
          <div class="syn-year" data-year={year}>
            <div class="syn-year-label">{year}</div>

            {grouped[year].map((entry) => {
              const tags = entry.data.tags || [];
              const summary = excerpt(entry);
              return (
                <article
                  class="syn-entry"
                  data-tags={tags.join(",")}
                  data-search={[
                    entry.data.title,
                    entry.slug,
                    tags.join(" "),
                    entry.body,
                    formatDate(entry.data.pubDate),
                    summary,
                  ].join(" ")}
                >
                  <div class="syn-card">
                    <a href={`/syndications/${entry.slug}`} class="syn-link">
                      <span class="syn-msg">{entry.data.title}</span>
                    </a>
                    <div class="syn-strip">
                      <time datetime={entry.data.pubDate.toISOString()}>
                        {entry.data.pubDate.toLocaleDateString(undefined, {
                          year: "numeric",
                          month: "2-digit",
                          day: "2-digit",
                        })}
                      </time>
                      <span>{tags[0] ?? "log"}</span>
                    </div>
                    <p>{summary}</p>
                    <div class="syn-meta">
                      {tags.map((t) => (
                        <span class="syn-tag">#{t}</span>
                      ))}
                      <span class="syn-read">read ↠</span>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ))}
      </div>
      <p class="syn-empty" data-syn-empty hidden>nothing matched that.</p>
    </div>
  </Wrapper>
</Layout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".syn-chip");
  const entries = document.querySelectorAll<HTMLElement>(".syn-entry");
  const yearGroups = document.querySelectorAll<HTMLElement>(".syn-year");
  const search = document.querySelector<HTMLInputElement>("[data-syn-search]");
  const clear = document.querySelector<HTMLButtonElement>("[data-syn-clear]");
  const count = document.querySelector<HTMLElement>("[data-syn-count]");
  const empty = document.querySelector<HTMLElement>("[data-syn-empty]");
  const shell = document.querySelector<HTMLElement>("[data-search-shell]");
  let activeFilter = "all";

  function escapeRegExp(value: string) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function getTerms(query: string) {
    return query
      .toLowerCase()
      .split(/\s+/)
      .map((term) => term.trim())
      .filter((term) => term.length > 1);
  }

  function clearHighlights(root: ParentNode = document) {
    root.querySelectorAll("mark.search-hit").forEach((mark) => {
      mark.replaceWith(document.createTextNode(mark.textContent ?? ""));
    });
  }

  function highlightText(root: HTMLElement, query: string) {
    const terms = getTerms(query);
    if (!terms.length) return;

    const pattern = new RegExp(`(${terms.map(escapeRegExp).join("|")})`, "gi");
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const parent = node.parentElement;
        if (!parent || parent.closest("mark, script, style, input, textarea")) {
          return NodeFilter.FILTER_REJECT;
        }
        pattern.lastIndex = 0;
        return pattern.test(node.textContent ?? "")
          ? NodeFilter.FILTER_ACCEPT
          : NodeFilter.FILTER_REJECT;
      },
    });

    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);

    nodes.forEach((node) => {
      const fragment = document.createDocumentFragment();
      const text = node.textContent ?? "";
      pattern.lastIndex = 0;
      let lastIndex = 0;

      for (const match of text.matchAll(pattern)) {
        const index = match.index ?? 0;
        if (index > lastIndex) {
          fragment.append(document.createTextNode(text.slice(lastIndex, index)));
        }

        const mark = document.createElement("mark");
        mark.className = "search-hit";
        mark.textContent = match[0];
        fragment.append(mark);
        lastIndex = index + match[0].length;
      }

      if (lastIndex < text.length) {
        fragment.append(document.createTextNode(text.slice(lastIndex)));
      }

      node.replaceWith(fragment);
    });
  }

  function openSearch() {
    shell?.setAttribute("data-open", "");
    search?.focus();
  }

  function closeSearch() {
    if (search?.value) return;
    shell?.removeAttribute("data-open");
    search?.blur();
  }

  function toggleSearch() {
    if (shell?.hasAttribute("data-open")) {
      if (search?.value) {
        search.value = "";
        applyFilters();
      }
      closeSearch();
    } else {
      openSearch();
    }
  }

  function applyFilters() {
    const query = search?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    clearHighlights();

    entries.forEach((entry) => {
      const tags = entry.dataset.tags?.split(",") ?? [];
      const text = (entry.dataset.search || entry.textContent || "").toLowerCase();
      const matchesTag = activeFilter === "all" || tags.includes(activeFilter);
      const matchesSearch = !query || text.includes(query);
      const link = entry.querySelector<HTMLAnchorElement>("a");
      if (link) {
        link.dataset.baseHref ??= link.getAttribute("href") ?? "";
        link.href = query
          ? `${link.dataset.baseHref}?q=${encodeURIComponent(query)}`
          : link.dataset.baseHref;
      }

      if (matchesTag && matchesSearch) {
        entry.removeAttribute("data-hidden");
        if (query) highlightText(entry, query);
        visible += 1;
      } else {
        entry.setAttribute("data-hidden", "");
      }
    });

    yearGroups.forEach((group) => {
      const hasVisible = group.querySelector(".syn-entry:not([data-hidden])");
      group.toggleAttribute("data-hidden", !hasVisible);
    });

    if (count) count.textContent = `${visible} ${visible === 1 ? "entry" : "entries"}`;
    empty?.toggleAttribute("hidden", visible !== 0);
    clear?.toggleAttribute("data-visible", Boolean(query));
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("syn-chip--active"));
      chip.classList.add("syn-chip--active");
      activeFilter = chip.dataset.filter ?? "all";
      applyFilters();
    });
  });

  search?.addEventListener("input", applyFilters);
  search?.addEventListener("focus", openSearch);
  search?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      if (search.value) {
        search.value = "";
        applyFilters();
      } else {
        closeSearch();
      }
    }
  });
  shell?.addEventListener("click", openSearch);
  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const isTyping =
      target?.tagName === "INPUT" ||
      target?.tagName === "TEXTAREA" ||
      target?.isContentEditable;

    if (event.key === "/" && !isTyping) {
      event.preventDefault();
      toggleSearch();
    }
  });
  clear?.addEventListener("click", () => {
    if (!search) return;
    search.value = "";
    search.focus();
    applyFilters();
  });
</script>
