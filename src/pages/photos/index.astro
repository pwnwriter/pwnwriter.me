---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Lightbox from "~/components/lightbox.astro";

const LICENSE_URL = "https://creativecommons.org/licenses/by-nc-sa/4.0/";
const LICENSE_LABEL = "CC BY-NC-SA 4.0";

import { photos } from "~/pages/photos/photos";

// newest first
photos.sort((a, b) => (a.date < b.date ? 1 : -1));

// group by year (descending)
const grouped = new Map<string, typeof photos>();
for (const p of photos) {
  const arr = grouped.get(p.year) ?? [];
  arr.push(p);
  grouped.set(p.year, arr);
}
const years = [...grouped.keys()].sort((a, b) => b.localeCompare(a));

// global index for lightbox navigation
let globalIndex = 0;
---

<Layout title="photos" description="A small archive of my photos.">
  <Wrapper>
    <header class="page-head">
      <h1 class="page-title">photos</h1>
      <p class="page-lede">
        a tiny archive of moments i like. licensed under
        <a href={LICENSE_URL} target="_blank" rel="noreferrer">{LICENSE_LABEL}</a>.
      </p>
    </header>

    {years.map((year) => {
      const yearPhotos = grouped.get(year)!;
      return (
        <section class="photo-year">
          <h2 class="section-label">{year}</h2>
          <div class="photo-masonry">
            {yearPhotos.map((p) => {
              const idx = globalIndex++;
              return (
                <figure class="photo-item" data-index={idx}>
                  <img src={p.src} alt={p.alt} loading="lazy" />
                  <figcaption class="photo-meta meta">
                    <span>{p.alt}</span>
                    <span>{p.date}</span>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </section>
      );
    })}

    {photos.length === 0 && <p class="meta">not yet. soon.</p>}
  </Wrapper>

  <Lightbox />
</Layout>

<style>
  .page-lede a {
    color: var(--f-high);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--f-low) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .photo-year + .photo-year {
    margin-top: 4rem;
  }

  /* Masonry via CSS columns */
  .photo-masonry {
    columns: 2;
    column-gap: 0.75rem;
  }

  .photo-item {
    break-inside: avoid;
    margin: 0 0 1.1rem;
    cursor: zoom-in;
  }

  .photo-item img {
    display: block;
    width: 100%;
    border-radius: 4px;
    background: var(--b-med);
    transition: opacity 0.2s ease;
  }

  .photo-item:hover img {
    opacity: 0.88;
  }

  .photo-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.4rem;
    font-size: 0.64rem;
  }

  .photo-meta span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .photo-meta span:last-child {
    flex: none;
    opacity: 0.7;
  }

  @media (max-width: 480px) {
    .photo-masonry {
      columns: 1;
    }
  }
</style>
