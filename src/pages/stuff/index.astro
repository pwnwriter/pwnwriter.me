  }

  .sn-code:hover {
    border-color: color-mix(in srgb, var(--accent) 36%, transparent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .sn-code:hover .sn-copy,
  .sn-code.is-copied .sn-copy {
