---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import Heading from "~/components/text/heading.astro";
import { wallpapers } from "~/data/wallpapers";
import { devices, software } from "~/data/uses";
import { bookmarks } from "~/data/bookmarks";
import { snippets } from "~/data/snippets";
import { bookshelf } from "~/data/bookshelf";
import { music } from "~/data/music";
import { movies } from "~/data/movies";
import { ossSummary, highlights, nixpkgs, fetchOssStats } from "~/data/oss";

const externalAttrs = { target: "_blank", rel: "noopener noreferrer" };

// build-time: refresh the oss numbers from github, and stamp the build day
const oss = await fetchOssStats();
const buildDate = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const count = (groups: { items: unknown[] }[]) =>
  groups.reduce((n, g) => n + g.items.length, 0);

const domain = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};

const tabs = [
  { id: "wallpapers", label: "wallpapers", count: wallpapers.length, blurb: "the walls i actually run. click one to grab the full-res file." },
  { id: "uses", label: "uses", count: devices.length + count(software), blurb: "the machines and tools i actually run, all declared in nix." },
  { id: "oss", label: "oss", count: oss.merged, blurb: "patches i've sent upstream. small fixes, ci, nix, and docs." },
  { id: "bookmarks", label: "bookmarks", count: count(bookmarks), blurb: "a blogroll in the old sense. go read them, then find theirs." },
  { id: "snippets", label: "snippets", count: count(snippets), blurb: "commands i re-google until my fingers learn them. click to copy." },
  { id: "bookshelf", label: "bookshelf", count: count(bookshelf), blurb: "books, papers, and writeups that earned a permanent spot." },
  { id: "music", label: "music", count: count(music), blurb: "what's in my ears while the code compiles." },
  { id: "movies", label: "movies", count: count(movies), blurb: "films and shows i keep coming back to." },
];
---

<Layout
  title="stuff"
  description="A grab-bag: wallpapers, rice, bookmarks, snippets, and a bookshelf."
>
  <Wrapper>
    <header class="stuff-header">
      <Heading Element="h1">Stuff</Heading>
      <p>
        the miscellaneous drawer: things i collect, reuse, and keep meaning to
        share. nothing load-bearing, all of it fair game to take.
      </p>
    </header>

    <nav class="tabs" role="tablist" aria-label="Stuff sections">
      {
        tabs.map((t) => (
          <button
            class="tab"
            role="tab"
            id={`tab-${t.id}`}
            data-tab={t.id}
            aria-controls={`panel-${t.id}`}
            aria-selected="false"
            tabindex="-1"
            type="button"
          >
            {t.label}
            <span class="tab-count">{t.count}</span>
          </button>
        ))
      }
    </nav>

    {
      tabs.map((t) => (
        <p class="panel-blurb" data-blurb={t.id} hidden>
          {t.blurb}
        </p>
      ))
    }

    <div class="panels">
      {/* ---------------- wallpapers ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-wallpapers"
        aria-labelledby="tab-wallpapers"
        data-panel="wallpapers"
        hidden
      >
        <div class="wp-grid">
          {wallpapers.map((w) => {
            const preview = w.thumb ?? w.file;
            const gradient = w.colors
              ? `linear-gradient(135deg, ${w.colors[0]}, ${w.colors[1]})`
              : "linear-gradient(135deg, var(--b-high), var(--accent))";
            const Tag = w.file ? "a" : "div";
            const dl = w.file ? { href: w.file, download: "" } : {};
            return (
              <Tag class="wp-card" {...dl} aria-label={w.name}>
                <div class="wp-thumb" style={`background-image:${gradient}`}>
                  {preview && (
                    <img class="wp-img" src={preview} alt={w.name} loading="lazy" />
                  )}
                  {!w.file && <span class="wp-soon">soon</span>}
                  {w.file && <span class="wp-dl">↓ download</span>}
                </div>
                <div class="wp-meta">
                  <span class="wp-name">{w.name}</span>
                  <span class="wp-info">
                    {w.tag}
                    {w.size ? ` · ${w.size}` : ""}
                  </span>
                </div>
              </Tag>
            );
          })}
        </div>
      </section>

      {/* ---------------- uses ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-uses"
        aria-labelledby="tab-uses"
        data-panel="uses"
        hidden
      >
        <p class="col-label">machines</p>
        <div class="dev-grid">
          {devices.map((d) => (
            <article class="dev-card">
              <div class="dev-top">
                <span class="dev-name">{d.name}</span>
                <span class="dev-kind">{d.kind}</span>
              </div>
              <p class="dev-role">{d.role}</p>
              <div class="dev-meta">
                {d.specs && <span>{d.specs}</span>}
                <span>{d.os}</span>
              </div>
            </article>
          ))}
        </div>

        <div class="uses-groups">
          {software.map((group) => (
            <section class="uses-group">
              <p class="col-label">{group.label}</p>
              <ul class="uses-list">
                {group.items.map((it) => (
                  <li class="uses-item">
                    <span class="uses-name">{it.name}</span>
                    {it.note && <span class="uses-note">{it.note}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <p class="uses-foot">
          it's all declared, and public:
          <a href="https://github.com/pwnwriter/nix" {...externalAttrs}>
            github.com/pwnwriter/nix
          </a>
        </p>
      </section>

      {/* ---------------- oss ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-oss"
        aria-labelledby="tab-oss"
        data-panel="oss"
        hidden
      >
        <div class="oss-stats">
          <span class="oss-stat"><b>{oss.contributions.toLocaleString()}</b> contributions</span>
          <span class="oss-stat"><b>{oss.merged}</b> merged prs</span>
          <span class="oss-stat"><b>{oss.projects}</b> projects</span>
          <span class="oss-stat"><b>{ossSummary.span}</b></span>
        </div>

        <p class="col-label">highlights</p>
        <ul class="oss-list">
          {highlights.map((c) => (
            <li>
              <a class="oss-item" href={c.url} {...externalAttrs}>
                <div class="oss-line">
                  <span class="oss-repo">{c.repo}</span>
                  {c.lang && <span class="oss-lang">{c.lang}</span>}
                  {c.count && <span class="oss-count">{c.count} prs</span>}
                </div>
                <span class="oss-desc">{c.desc}</span>
                <span class="oss-what">{c.what}</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="col-label oss-nix-label">packaged for nixpkgs</p>
        <div class="oss-nix">
          {nixpkgs.map((p) => (
            <a class="oss-pill" href={p.url} {...externalAttrs}>
              {p.name}
            </a>
          ))}
        </div>

        <p class="uses-foot">
          the full pile, closed ones and all:
          <a href={ossSummary.allUrl} {...externalAttrs}>
            all {oss.total} pull requests
          </a>
        </p>
        <p class="oss-updated">
          last synced {buildDate}
          {oss.live ? "" : " (cached)"}
        </p>
      </section>

      {/* ---------------- bookmarks ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-bookmarks"
        aria-labelledby="tab-bookmarks"
        data-panel="bookmarks"
        hidden
      >
        <div class="bm-groups">
          {bookmarks.map((group) => (
            <section class="bm-group">
              <p class="col-label">{group.label}</p>
              <ul class="bm-list">
                {group.items.map((b) => (
                  <li>
                    <a href={b.url} {...externalAttrs}>
                      <span class="bm-title">{b.title}</span>
                      <span class="bm-domain">{domain(b.url)}</span>
                      {b.note && <span class="bm-note">{b.note}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>

      {/* ---------------- snippets ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-snippets"
        aria-labelledby="tab-snippets"
        data-panel="snippets"
        hidden
      >
        <div class="sn-groups">
          {snippets.map((group) => (
            <section class="sn-group">
              <p class="col-label">{group.label}</p>
              <ul class="sn-list">
                {group.items.map((s) => (
                  <li class="sn-item">
                    <div class="sn-text">
                      <span class="sn-title">{s.title}</span>
                      {s.note && <span class="sn-note">{s.note}</span>}
                    </div>
                    <button class="sn-code" type="button" data-copy={s.code}>
                      <code>{s.code}</code>
                      <span class="sn-copy">copy</span>
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>

      {/* ---------------- bookshelf ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-bookshelf"
        aria-labelledby="tab-bookshelf"
        data-panel="bookshelf"
        hidden
      >
        <div class="bs-groups">
          {bookshelf.map((group) => (
            <section class="bs-group">
              <p class="col-label">{group.label}</p>
              <ul class="bs-list">
                {group.items.map((b) => {
                  const Tag = b.url ? "a" : "div";
                  const attrs = b.url ? { href: b.url, ...externalAttrs } : {};
                  return (
                    <li>
                      <Tag class="bs-item" {...attrs}>
                        <div class="bs-line">
                          <span class="bs-title">{b.title}</span>
                          {b.status && <span class="bs-status">{b.status}</span>}
                        </div>
                        {b.author && <span class="bs-author">{b.author}</span>}
                        {b.note && <span class="bs-note">{b.note}</span>}
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </section>

      {/* ---------------- music ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-music"
        aria-labelledby="tab-music"
        data-panel="music"
        hidden
      >
        <div class="bs-groups">
          {music.map((group) => (
            <section class="bs-group">
              <p class="col-label">{group.label}</p>
              <ul class="bs-list">
                {group.items.map((m) => {
                  const Tag = m.url ? "a" : "div";
                  const attrs = m.url ? { href: m.url, ...externalAttrs } : {};
                  return (
                    <li>
                      <Tag class="bs-item" {...attrs}>
                        <div class="bs-line">
                          <span class="bs-title">{m.title}</span>
                          {m.status && <span class="bs-status">{m.status}</span>}
                        </div>
                        {m.artist && <span class="bs-author">{m.artist}</span>}
                        {m.note && <span class="bs-note">{m.note}</span>}
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </section>

      {/* ---------------- movies ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-movies"
        aria-labelledby="tab-movies"
        data-panel="movies"
        hidden
      >
        <div class="bs-groups">
          {movies.map((group) => (
            <section class="bs-group">
              <p class="col-label">{group.label}</p>
              <ul class="bs-list">
                {group.items.map((m) => {
                  const Tag = m.url ? "a" : "div";
                  const attrs = m.url ? { href: m.url, ...externalAttrs } : {};
                  return (
                    <li>
                      <Tag class="bs-item" {...attrs}>
                        <div class="bs-line">
                          <span class="bs-title">{m.title}</span>
                          {m.status && <span class="bs-status">{m.status}</span>}
                        </div>
                        {m.year && <span class="bs-author">{m.year}</span>}
                        {m.note && <span class="bs-note">{m.note}</span>}
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </section>
    </div>
  </Wrapper>
</Layout>

<style>
  .stuff-header {
    max-width: 44rem;
    margin-bottom: 1rem;
  }

  .stuff-header p {
    max-width: 38rem;
    margin-top: 0.4rem;
    color: color-mix(in srgb, var(--f-low) 82%, transparent);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ---- tab bar ---- */
  .tabs {
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--f-low) 13%, transparent);
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.35rem 0.7rem;
    border: 0;
    border-radius: 7px;
    background: none;
    color: color-mix(in srgb, var(--f-low) 70%, transparent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: lowercase;
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .tab:hover {
    color: var(--f-high);
    background: color-mix(in srgb, var(--f-high) 5%, transparent);
  }

  .tab[aria-selected="true"] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .tab-count {
    color: color-mix(in srgb, var(--f-low) 50%, transparent);
    font-size: 0.62rem;
  }

  .tab[aria-selected="true"] .tab-count {
    color: color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .panel-blurb {
    margin: 0 0 1.15rem;
    color: color-mix(in srgb, var(--f-low) 74%, transparent);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .panel[hidden],
  .panel-blurb[hidden] {
    display: none;
  }

  /* shared column label for the list panels */
  .col-label {
    margin: 0 0 0.6rem;
    color: color-mix(in srgb, var(--f-low) 60%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: lowercase;
  }

  /* ---------- wallpapers ---------- */
  .wp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .wp-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--f-high) 3.5%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  a.wp-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 34%, transparent);
    box-shadow: 0 22px 42px -30px color-mix(in srgb, var(--f-high) 62%, transparent);
  }

  .wp-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid color-mix(in srgb, var(--f-low) 12%, transparent);
  }

  .wp-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 320ms ease;
  }

  a.wp-card:hover .wp-img {
    transform: scale(1.045);
  }

  .wp-soon {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.4);
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    backdrop-filter: blur(4px);
  }

  .wp-dl {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--b-low) 55%, transparent);
    color: var(--f-high);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0;
    transition: opacity 180ms ease;
    backdrop-filter: blur(2px);
  }

  a.wp-card:hover .wp-dl,
  a.wp-card:focus-visible .wp-dl {
    opacity: 1;
  }

  .wp-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem 0.7rem;
  }

  .wp-name {
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .wp-info {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--f-low) 55%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    white-space: nowrap;
  }

  /* ---------- uses ---------- */
  .dev-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-bottom: 2.25rem;
  }

  .dev-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--f-high) 3.5%, transparent);
  }

  .dev-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .dev-name {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .dev-name::before {
    content: "▚ ";
    opacity: 0.55;
  }

  .dev-kind {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--f-low) 55%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: lowercase;
  }

  .dev-role {
    margin: 0;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .dev-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    color: color-mix(in srgb, var(--f-low) 62%, transparent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  .uses-groups {
    display: grid;
    gap: 1.8rem;
  }

  .uses-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .uses-item {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.15rem 1rem;
  }

  .uses-name {
    color: var(--f-high);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .uses-note {
    color: color-mix(in srgb, var(--f-low) 74%, transparent);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .uses-foot {
    margin: 2rem 0 0;
    color: color-mix(in srgb, var(--f-low) 66%, transparent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .uses-foot a {
    margin-left: 0.4rem;
    color: var(--accent);
    text-decoration: none;
  }

  .uses-foot a:hover {
    text-decoration: underline;
  }

  /* ---------- oss ---------- */
  .oss-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-bottom: 1.6rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--f-low) 13%, transparent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--f-low) 66%, transparent);
  }

  .oss-stat b {
    color: var(--accent);
    font-weight: 400;
    font-size: 1.05rem;
  }

  .oss-list {
    display: grid;
    gap: 0;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--f-low) 12%, transparent);
  }

  .oss-item {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--f-low) 10%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .oss-line {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .oss-repo {
    color: var(--f-high);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    transition: color 150ms ease;
  }

  .oss-item:hover .oss-repo,
  .oss-item:focus-visible .oss-repo {
    color: var(--accent);
  }

  .oss-lang {
    flex-shrink: 0;
    padding: 0.02em 0.45em;
    border: 1px solid color-mix(in srgb, var(--f-low) 22%, transparent);
    border-radius: 999px;
    color: color-mix(in srgb, var(--f-low) 66%, transparent);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .oss-count {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--accent) 76%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .oss-desc {
    color: color-mix(in srgb, var(--f-low) 60%, transparent);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .oss-what {
    color: color-mix(in srgb, var(--f-high) 88%, transparent);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .oss-updated {
    margin: 0.6rem 0 0;
    color: color-mix(in srgb, var(--f-low) 45%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .oss-nix-label {
    margin-top: 0;
  }

  .oss-nix {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .oss-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.55rem;
