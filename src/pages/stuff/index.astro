---
import Layout from "~/layouts/Layout.astro";
import Wrapper from "~/components/wrapper.astro";
import { devices, software } from "~/data/uses";
import { ossSummary, highlights, nixpkgs, fetchOssStats } from "~/data/oss";

const externalAttrs = { target: "_blank", rel: "noopener noreferrer" };

// build-time: refresh the oss numbers from github, and stamp the build day
const oss = await fetchOssStats();
const buildDate = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const count = (groups: { items: unknown[] }[]) =>
  groups.reduce((n, g) => n + g.items.length, 0);

const domain = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};

const tabs = [
  { id: "uses", label: "uses", count: devices.length + count(software), blurb: "the machines and tools i actually run, all declared in nix." },
  { id: "oss", label: "oss", count: oss.merged, blurb: "patches i've sent upstream. small fixes, ci, nix, and docs." },
];
---

<Layout
  title="stuff"
  description="The machines i run and the patches i send upstream."
>
  <Wrapper>
    <header class="page-head">
      <h1 class="page-title">stuff</h1>
      <p class="page-lede">
        the machines and tools i actually run, and the patches i have sent
        upstream. all of it declared in nix.
      </p>
    </header>

    <nav class="tabs" role="tablist" aria-label="Stuff sections">
      {
        tabs.map((t) => (
          <button
            class="tab"
            role="tab"
            id={`tab-${t.id}`}
            data-tab={t.id}
            aria-controls={`panel-${t.id}`}
            aria-selected="false"
            tabindex="-1"
            type="button"
          >
            {t.label}
            <span class="tab-count">{t.count}</span>
          </button>
        ))
      }
    </nav>

    {
      tabs.map((t) => (
        <p class="panel-blurb" data-blurb={t.id} hidden>
          {t.blurb}
        </p>
      ))
    }

    <div class="panels">
      {/* ---------------- uses ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-uses"
        aria-labelledby="tab-uses"
        data-panel="uses"
        hidden
      >
        <p class="col-label">machines</p>
        <div class="dev-grid">
          {devices.map((d) => (
            <article class="dev-card">
              <div class="dev-top">
                <span class="dev-name">{d.name}</span>
                <span class="dev-kind">{d.kind}</span>
              </div>
              <p class="dev-role">{d.role}</p>
              <div class="dev-meta">
                {d.specs && <span>{d.specs}</span>}
                <span>{d.os}</span>
              </div>
            </article>
          ))}
        </div>

        <div class="uses-groups">
          {software.map((group) => (
            <section class="uses-group">
              <p class="col-label">{group.label}</p>
              <ul class="uses-list">
                {group.items.map((it) => (
                  <li class="uses-item">
                    <span class="uses-name">{it.name}</span>
                    {it.note && <span class="uses-note">{it.note}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <p class="uses-foot">
          it's all declared, and public:
          <a href="https://github.com/pwnwriter/nix" {...externalAttrs}>
            github.com/pwnwriter/nix
          </a>
        </p>
      </section>

      {/* ---------------- oss ---------------- */}
      <section
        class="panel"
        role="tabpanel"
        id="panel-oss"
        aria-labelledby="tab-oss"
        data-panel="oss"
        hidden
      >
        <div class="oss-stats">
          <span class="oss-stat"><b>{oss.contributions.toLocaleString()}</b> contributions</span>
          <span class="oss-stat"><b>{oss.merged}</b> merged prs</span>
          <span class="oss-stat"><b>{oss.projects}</b> projects</span>
          <span class="oss-stat"><b>{ossSummary.span}</b></span>
        </div>

        <p class="col-label">highlights</p>
        <ul class="oss-list">
          {highlights.map((c) => (
            <li>
              <a class="oss-item" href={c.url} {...externalAttrs}>
                <div class="oss-line">
                  <span class="oss-repo">{c.repo}</span>
                  {c.lang && <span class="oss-lang">{c.lang}</span>}
                  {c.count && <span class="oss-count">{c.count} prs</span>}
                </div>
                <span class="oss-desc">{c.desc}</span>
                <span class="oss-what">{c.what}</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="col-label oss-nix-label">packaged for nixpkgs</p>
        <div class="oss-nix">
          {nixpkgs.map((p) => (
            <a class="oss-pill" href={p.url} {...externalAttrs}>
              {p.name}
            </a>
          ))}
        </div>

        <p class="uses-foot">
          the full pile, closed ones and all:
          <a href={ossSummary.allUrl} {...externalAttrs}>
            all {oss.total} pull requests
          </a>
        </p>
        <p class="oss-updated">
          last synced {buildDate}
          {oss.live ? "" : " (cached)"}
        </p>
      </section>

    </div>
  </Wrapper>
</Layout>

<style>
  /* tabs: a line of plain mono words, same as the tag filters elsewhere */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: 0 0 1.25rem;
  }

  .tab {
    border: 0;
    background: none;
    padding: 0;
    color: var(--f-mute);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.7;
    transition: color 0.15s ease;
  }

  .tab:hover {
    color: var(--f-high);
  }

  .tab[aria-selected="true"] {
    color: var(--accent);
  }

  .tab-count {
    margin-left: 0.2rem;
    font-size: 0.62rem;
    opacity: 0.6;
  }

  .panel-blurb {
    margin: 0 0 3rem;
    color: var(--f-low);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* shared bits */
  .col-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1rem;
    color: var(--f-mute);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .col-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .panel :is(ul, ol) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel a {
    color: inherit;
    text-decoration: none;
  }

  .uses-group + .uses-group,
  .bm-group + .bm-group,
  .sn-group + .sn-group,
  .bs-group + .bs-group,
  .uses-groups,
  .oss-nix-label {
    margin-top: 3rem;
  }

  .uses-foot,
  .oss-updated {
    margin: 2.5rem 0 0;
    color: var(--f-mute);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .oss-updated {
    margin-top: 0.4rem;
    opacity: 0.7;
  }

  .uses-foot a {
    color: var(--f-high);
    transition: color 0.15s ease;
  }

  .uses-foot a:hover {
    color: var(--accent);
  }

  /* uses */
  .dev-card {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.15rem 1.5rem;
    padding: 0.6rem 0;
  }

  .dev-top {
    display: flex;
    flex-direction: column;
    grid-row: span 2;
  }

  .dev-name,
  .uses-name,
  .oss-repo {
    color: var(--f-high);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .dev-kind,
  .dev-meta,
  .oss-lang,
  .oss-count,
  .bm-domain,
  .bs-status {
    color: var(--f-mute);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .dev-role {
    margin: 0;
    color: var(--f-low);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .dev-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
  }

  .uses-item {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.4rem 0;
  }

  .uses-note,
  .oss-desc,
  .bm-note,
  .sn-note,
  .bs-note {
    color: var(--f-low);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* oss */
  .oss-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    margin-bottom: 3rem;
    color: var(--f-mute);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .oss-stat b {
    margin-right: 0.3rem;
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .oss-item,
  .bs-item {
    display: block;
    padding: 0.7rem 0;
  }

  .oss-line,
  .bs-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
  }

  .oss-repo {
    transition: color 0.15s ease;
  }

  .oss-count,
  .bs-status {
    margin-left: auto;
  }

  .oss-desc,
  .oss-what {
    display: block;
    margin-top: 0.25rem;
  }

  .oss-what {
    color: var(--f-mute);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .oss-nix {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .oss-pill {
    color: var(--f-low);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    transition: color 0.15s ease;
  }

  @media (max-width: 560px) {
    .wp-grid {
      gap: 1.5rem 0.9rem;
    }

    .wp-meta {
      flex-direction: column;
      gap: 0.1rem;
    }

    .dev-card,
    .uses-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .dev-top {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      grid-row: auto;
    }
  }
</style>

<script>
  function initStuffTabs() {
    const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
    if (!tablist) return;

    const tabs = Array.from(
      tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>(".panel"),
    );
    const blurbs = Array.from(
      document.querySelectorAll<HTMLElement>(".panel-blurb"),
    );
    if (!tabs.length) return;

    const ids = tabs.map((t) => t.dataset.tab || "");

    function select(id: string, focus = false, push = true) {
      if (!ids.includes(id)) id = ids[0];

      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
      });
      blurbs.forEach((b) => {
        b.hidden = b.dataset.blurb !== id;
      });

      if (push && `#${id}` !== window.location.hash) {
        history.replaceState(null, "", `#${id}`);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => select(tab.dataset.tab || "", false));
    });

    // arrow-key navigation across the tab bar
    tablist.addEventListener("keydown", (e) => {
      const i = tabs.findIndex(
        (t) => t.getAttribute("aria-selected") === "true",
      );
      if (i < 0) return;
      let next = -1;
      if (e.key === "ArrowRight" || e.key === "l") next = (i + 1) % tabs.length;
      else if (e.key === "ArrowLeft" || e.key === "h")
        next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      if (next >= 0) {
        e.preventDefault();
        select(tabs[next].dataset.tab || "", true);
      }
    });

    window.addEventListener("hashchange", () => {
      select(window.location.hash.slice(1), false, false);
    });

    const initial = window.location.hash.slice(1);
    select(ids.includes(initial) ? initial : ids[0], false, false);
  }

  function initCopy() {
    document.querySelectorAll<HTMLButtonElement>(".sn-code").forEach((btn) => {
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy || "");
        } catch {
          return;
        }
        const label = btn.querySelector(".sn-copy");
        const prev = label?.textContent;
        if (label) label.textContent = "copied";
        btn.classList.add("is-copied");
        window.setTimeout(() => {
          if (label) label.textContent = prev || "copy";
          btn.classList.remove("is-copied");
        }, 1200);
      });
    });
  }

  function init() {
    initStuffTabs();
    initCopy();
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
