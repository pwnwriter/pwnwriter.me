    font-size: 0.84rem;
    line-height: 1.45;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 860px) {
    .wp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .sn-item,
    .uses-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  @media (max-width: 480px) {
    .stuff-header {
      margin-bottom: 1.25rem;
    }
    .wp-grid,
    .dev-grid {
      grid-template-columns: 1fr;
