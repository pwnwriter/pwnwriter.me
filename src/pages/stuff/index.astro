    border-top: 1px solid color-mix(in srgb, var(--f-low) 12%, transparent);
  }

  .bm-list a {
    display: grid;
    grid-template-columns: minmax(0, auto) 1fr;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--f-low) 10%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .bm-title {
    color: var(--f-high);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.2;
    transition: color 150ms ease;
  }

  .bm-list a:hover .bm-title,
  .bm-list a:focus-visible .bm-title {
