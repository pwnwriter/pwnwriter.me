  }

  .bm-domain {
    justify-self: end;
    color: color-mix(in srgb, var(--f-low) 50%, transparent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .bm-note {
    grid-column: 1 / -1;
    color: color-mix(in srgb, var(--f-low) 74%, transparent);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  /* ---------- snippets ---------- */
  .sn-list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sn-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .sn-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .sn-title {
    color: var(--f-high);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .sn-note {
    color: color-mix(in srgb, var(--f-low) 60%, transparent);
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .sn-code {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--f-high) 4%, transparent);
    cursor: pointer;
    text-align: left;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
