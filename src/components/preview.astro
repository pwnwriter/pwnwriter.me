---
// One overlay for everything on the work page. A card says which entry to
// show, the entry's media runs in a viewer (stills and video both), and the
// words sit beside it. Esc or a click outside closes it, arrows step through.
---

<div class="pv" data-pv hidden>
  <div class="pv-scrim" data-pv-close></div>

  <div class="pv-panel" role="dialog" aria-modal="true" aria-labelledby="pv-title">
    <button class="pv-x" type="button" data-pv-close aria-label="close preview">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="pv-stage">
      <div class="pv-media" data-pv-media></div>
      <button class="pv-nav pv-prev" type="button" data-pv-prev aria-label="previous">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="pv-nav pv-next" type="button" data-pv-next aria-label="next">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <div class="pv-dots" data-pv-dots></div>
    </div>

    <div class="pv-info">
      <h2 class="pv-title" id="pv-title" data-pv-title></h2>
      <p class="pv-sub" data-pv-sub></p>
      <p class="pv-blurb" data-pv-blurb></p>
      <ul class="pv-points" data-pv-points></ul>
      <p class="pv-tech" data-pv-tech></p>
      <p class="pv-links" data-pv-links></p>
    </div>
  </div>
</div>

<style>
  .pv {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  .pv[hidden] {
    display: none;
  }

  .pv-scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--f-high) 42%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .pv.is-open .pv-scrim {
    opacity: 1;
  }

  .pv-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 0;
    width: min(62rem, 100%);
    max-height: min(42rem, 88vh);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--background);
    box-shadow: 0 24px 70px color-mix(in srgb, var(--f-high) 26%, transparent);
    opacity: 0;
    transform: scale(0.97) translateY(8px);
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pv.is-open .pv-panel {
    opacity: 1;
    transform: none;
  }

  .pv-x {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--background) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--f-low);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .pv-x:hover {
    color: var(--f-high);
    background: var(--b-med);
  }

  /* the viewer */
  .pv-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 16rem;
    background: var(--b-med);
  }

  .pv-media {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 1.1rem;
  }

  .pv-media :global(img),
  .pv-media :global(video) {
    max-width: 100%;
    max-height: min(38rem, 78vh);
    border-radius: 10px;
    object-fit: contain;
  }

  /* a scanned letter is paper, so it gets a white sheet behind it */
  .pv-media.is-scan :global(img) {
    background: #fff;
  }

  .pv-nav {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--background) 86%, transparent);
    backdrop-filter: blur(8px);
    color: var(--f-low);
    transform: translateY(-50%);
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .pv-nav:hover {
    color: var(--f-high);
  }

  .pv-prev {
    left: 0.7rem;
  }

  .pv-next {
    right: 0.7rem;
  }

  .pv-nav[hidden] {
    display: none;
  }

  .pv-dots {
    position: absolute;
    bottom: 0.7rem;
    left: 50%;
    display: flex;
    gap: 0.35rem;
    transform: translateX(-50%);
  }

  .pv-dots :global(span) {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--f-low) 40%, transparent);
    transition: background 0.15s ease;
  }

  .pv-dots :global(span.on) {
    background: var(--f-high);
  }

  /* the words */
  .pv-info {
    overflow-y: auto;
    padding: 2.1rem 1.75rem 1.75rem;
  }

  .pv-title {
    margin: 0;
    color: var(--f-high);
    font-size: 1.3rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .pv-sub {
    margin: 0.3rem 0 0;
    color: var(--f-mute);
    font-size: 0.88rem;
  }

  .pv-blurb {
    margin: 1rem 0 0;
    color: var(--f-low);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .pv-points {
    margin: 0.9rem 0 0;
    padding-left: 1.05rem;
    color: var(--f-low);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .pv-points :global(li) {
    margin-bottom: 0.3rem;
    list-style: disc;
  }

  .pv-points :global(li)::marker {
    color: var(--f-mute);
  }

  .pv-points:empty,
  .pv-blurb:empty,
  .pv-sub:empty,
  .pv-tech:empty,
  .pv-links:empty {
    display: none;
  }

  .pv-tech {
    margin: 1rem 0 0;
    color: var(--f-mute);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .pv-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 1.1rem 0 0;
  }

  .pv-links :global(a) {
    color: var(--f-high);
    font-size: 0.9rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--f-low) 45%, transparent);
    text-underline-offset: 0.25em;
    transition: color 0.15s ease;
  }

  .pv-links :global(a:hover) {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .pv {
      padding: 0.75rem;
    }

    .pv-panel {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      max-height: 92vh;
    }

    .pv-stage {
      min-height: 0;
    }

    .pv-media :global(img),
    .pv-media :global(video) {
      max-height: 42vh;
    }

    .pv-info {
      padding: 1.25rem 1.25rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-scrim,
    .pv-panel {
      transition: opacity 0.15s ease;
    }

    .pv-panel {
      transform: none;
    }
  }
</style>

<script>
  type Media = { kind: "image" | "video"; src: string; alt?: string; poster?: string };
  type Entry = {
    title: string;
    sub?: string;
    blurb?: string;
    points?: string[];
    tech?: string[];
    links?: { label: string; href: string }[];
    scan?: boolean;
    media: Media[];
  };

  const root = document.querySelector<HTMLElement>("[data-pv]");
  const data = document.getElementById("preview-data");
  if (root && data) {
    const entries: Record<string, Entry> = JSON.parse(data.textContent || "{}");
    const panel = root.querySelector<HTMLElement>(".pv-panel")!;
    const stage = root.querySelector<HTMLElement>("[data-pv-media]")!;
    const dots = root.querySelector<HTMLElement>("[data-pv-dots]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-pv-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-pv-next]")!;
    const el = (s: string) => root.querySelector<HTMLElement>(s)!;

    let entry: Entry | null = null;
    let i = 0;
    let opener: HTMLElement | null = null;

    const stopVideo = () => stage.querySelector("video")?.pause();

    const show = (n: number) => {
      if (!entry) return;
      stopVideo();
      i = (n + entry.media.length) % entry.media.length;
      const m = entry.media[i];
      stage.classList.toggle("is-scan", !!entry.scan);
      stage.innerHTML = "";
      if (m.kind === "video") {
        const v = document.createElement("video");
        v.src = m.src;
        if (m.poster) v.poster = m.poster;
        v.controls = true;
        v.playsInline = true;
        v.preload = "metadata";
        stage.append(v);
      } else {
        const img = document.createElement("img");
        img.src = m.src;
        img.alt = m.alt ?? entry.title;
        stage.append(img);
      }
      dots.innerHTML = "";
      if (entry.media.length > 1) {
        entry.media.forEach((_, k) => {
          const d = document.createElement("span");
          if (k === i) d.className = "on";
          dots.append(d);
        });
      }
    };

    const open = (key: string, from: HTMLElement) => {
      const e = entries[key];
      if (!e) return;
      entry = e;
      opener = from;
      el("[data-pv-title]").textContent = e.title;
      el("[data-pv-sub]").textContent = e.sub ?? "";
      el("[data-pv-blurb]").textContent = e.blurb ?? "";
      el("[data-pv-points]").innerHTML = (e.points ?? [])
        .map((p) => `<li>${p}</li>`)
        .join("");
      el("[data-pv-tech]").textContent = (e.tech ?? []).join("  ·  ");
      el("[data-pv-links]").innerHTML = (e.links ?? [])
        .map(
          (l) =>
            `<a href="${l.href}" target="_blank" rel="noopener noreferrer">${l.label}</a>`,
        )
        .join("");
      const many = e.media.length > 1;
      prev.hidden = !many;
      next.hidden = !many;
      show(0);
      root.hidden = false;
      requestAnimationFrame(() => root.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      panel.focus?.();
    };

    const close = () => {
      stopVideo();
      root.classList.remove("is-open");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        root.hidden = true;
        stage.innerHTML = "";
      }, 220);
      opener?.focus();
      entry = null;
    };

    document.querySelectorAll<HTMLElement>("[data-pv-open]").forEach((card) => {
      card.addEventListener("click", (ev) => {
        ev.preventDefault();
        open(card.dataset.pvOpen!, card);
      });
    });

    root.querySelectorAll("[data-pv-close]").forEach((b) =>
      b.addEventListener("click", close),
    );
    prev.addEventListener("click", () => show(i - 1));
    next.addEventListener("click", () => show(i + 1));

    document.addEventListener("keydown", (e) => {
      if (root.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(i - 1);
      else if (e.key === "ArrowRight") show(i + 1);
    });
  }
</script>
