<script>
// The official embed uses an open shadow root; theme its launcher without
// replacing the embed or changing its private-message flow.
const shell=document.querySelector<HTMLElement>('.hello-embed');
if(shell){
  const observer=new MutationObserver(applyTheme);
  function applyTheme(){
    const widget=shell!.querySelector<HTMLElement>('[data-whoami-widget]');
    const root=widget?.shadowRoot;
    if(!root||root.querySelector('[data-site-hello-theme]'))return;
    const style=document.createElement('style');
    style.setAttribute('data-site-hello-theme','');
    style.textContent=`
      .launcher{font:500 17px/1.25 Hanken,Arial,sans-serif;background:#eee8f7;color:#594d6d;border:1px solid #d9cfe8;border-radius:9px;padding:5px 9px;gap:7px;box-shadow:inset 0 1px 0 #ffffffa0;transition:background .18s,border-color .18s;}
      .launcher:hover{transform:none;background:#e8dff3;color:#493a60;border-color:#c9b9dd;box-shadow:inset 0 1px 0 #ffffffa0;}
      .launcher img{display:block;width:21px;height:21px;border-radius:5px;transform:none;}
      .launcher span:last-child{display:none;}
      .launcher:hover span:last-child{transform:translate(1px,-1px);}
      .launcher:focus-visible{outline:2px solid #a18abd;outline-offset:4px;}
      dialog{background:#f1f1f3;color:#25262c;border-color:#c8cad4;border-radius:12px;box-shadow:0 18px 60px #24273520;}
      dialog::backdrop{background:#e8e9ef99;backdrop-filter:blur(5px);}
      .top{border-color:#d7d8df;}.top span{color:#737581;}.close{background:#e5e6eb;color:#737581;}.fallback{background:#f1f1f3;border-color:#d7d8df;}.fallback a{color:#737581;}
      @media(max-width:640px){.launcher{font-size:16px;}}
      @media(prefers-reduced-motion:reduce){.launcher,.launcher span:last-child{transition:none;}}
    `;
    root.append(style);
    root.addEventListener('keydown',event=>{
      const key=event as KeyboardEvent;
      if(key.key==='Escape'&&root.querySelector<HTMLDialogElement>('dialog')?.open){
        key.preventDefault();key.stopPropagation();root.querySelector<HTMLButtonElement>('.close')?.click();
      }
    },true);
    const launcher=root.querySelector<HTMLButtonElement>('.launcher')!;
    const hover=document.createElement('div');hover.className='hello-hover';hover.setAttribute('popover','manual');hover.setAttribute('role','dialog');hover.setAttribute('aria-label','whoami profile card preview');
    const preview=document.createElement('img');preview.src='/images/previews/whoami-pwnwriter.png';preview.alt='Nabeen’s whoami.cards profile card';preview.width=716;preview.height=974;
    hover.append(preview);root.append(hover);
    const extra=document.createElement('style');extra.textContent=`
      .hello-hover{position:fixed;inset:auto;margin:0;width:260px;max-width:calc(100vw - 32px);padding:0;border:1px solid #dcd6e8;border-radius:17px;background:#f5effb;box-shadow:0 2px 4px #25273804,0 15px 35px #25273820;overflow:hidden;}
      .hello-hover img{display:block;width:100%;height:auto;max-height:calc(100dvh - 40px);object-fit:contain;}.hello-hover:popover-open{animation:hello-card-in .32s cubic-bezier(.16,1,.3,1);will-change:transform,opacity;}.hello-hover.is-closing:popover-open{animation:hello-card-out .18s ease-in forwards;}@keyframes hello-card-in{from{opacity:0;transform:perspective(900px) translateY(10px) rotateX(7deg) rotateY(-5deg) scale(.94)}to{opacity:1;transform:perspective(900px) translateY(0) rotateX(0) rotateY(0) scale(1)}}@keyframes hello-card-out{from{opacity:1;transform:perspective(900px) translateY(0) rotateX(0) rotateY(0) scale(1)}to{opacity:0;transform:perspective(900px) translateY(8px) rotateX(5deg) rotateY(-4deg) scale(.96)}}.hello-hover::backdrop{background:none;pointer-events:none;}@keyframes hello-info{from{opacity:0;translate:0 -4px}to{opacity:1;translate:0 0}}@media(prefers-reduced-motion:reduce){.hello-hover:popover-open{animation:none}}
    `;root.append(extra);
    let hoverTimer:ReturnType<typeof setTimeout>|undefined;
    let closing=false,closeMotionTimer:ReturnType<typeof setTimeout>|undefined;
    const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hideHover=()=>{
      clearTimeout(hoverTimer);if(!hover.matches(':popover-open')||closing)return;
      if(reducedMotion){hover.hidePopover();return;}
      closing=true;hover.classList.add('is-closing');
      closeMotionTimer=setTimeout(()=>{hover.hidePopover();hover.classList.remove('is-closing');closing=false;},180);
    };
    const openHover=()=>{
      if(root.querySelector<HTMLDialogElement>('dialog')?.open)return;clearTimeout(hoverTimer);
      if(closing){clearTimeout(closeMotionTimer);hover.classList.remove('is-closing');closing=false;}
      if(!hover.matches(':popover-open')){hover.showPopover();}
      const rect=launcher.getBoundingClientRect(),width=hover.offsetWidth,height=hover.offsetHeight;const above=rect.bottom+10+height>innerHeight-16;
      hover.style.left=`${Math.max(16,Math.min(rect.left,innerWidth-width-16))}px`;hover.style.top=`${above?Math.max(16,rect.top-height-10):rect.bottom+10}px`;
      hover.style.transformOrigin=above?'50% 100%':'50% 0%';
    };
    window.addEventListener('scroll',()=>{if(hover.matches(':popover-open')&&!closing)openHover();},{passive:true});
    window.addEventListener('resize',()=>{if(hover.matches(':popover-open')&&!closing)openHover();});
    const later=()=>{clearTimeout(hoverTimer);hoverTimer=setTimeout(()=>{if(!hover.contains(root.activeElement))hideHover();},160);};
    launcher.addEventListener('pointerenter',event=>{if(event.pointerType!=='touch')openHover();});launcher.addEventListener('pointerleave',later);launcher.addEventListener('keydown',event=>{if(event.key==='ArrowDown'){event.preventDefault();openHover();}});launcher.addEventListener('blur',later);launcher.addEventListener('click',hideHover);
    hover.addEventListener('pointerenter',()=>{clearTimeout(hoverTimer);if(closing)openHover();});hover.addEventListener('pointerleave',later);hover.addEventListener('focusout',later);
    root.addEventListener('keydown',event=>{if((event as KeyboardEvent).key==='Escape'&&hover.matches(':popover-open')){event.preventDefault();event.stopPropagation();hideHover();}});
    document.addEventListener('pointerdown',event=>{if(!event.composedPath().includes(widget!))hideHover();});
    observer.disconnect();
  }
  observer.observe(shell,{childList:true,subtree:true});
  applyTheme();
  // A window load check also covers deferred scripts that initialize after
  // their host is inserted without another light-DOM mutation.
  window.addEventListener('load',applyTheme,{once:true});
}
</script>
