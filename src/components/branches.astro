<canvas id="branches-canvas" class="branches-canvas" aria-hidden="true"></canvas>

<style>
  .branches-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    opacity: 0.16;
  }
</style>

<script>
  function drawCircuitNotes() {
    const canvas = document.getElementById(
      "branches-canvas",
    ) as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const dpr = window.devicePixelRatio || 1;
    let animationId: number | null = null;
    let animationStart = 0;

    function isDark() {
      const html = document.documentElement;
      if (html.classList.contains("dark")) return true;
      if (html.classList.contains("light")) return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function color(alpha: number) {
      return isDark()
        ? `rgba(232, 227, 217, ${alpha})`
        : `rgba(55, 49, 83, ${alpha})`;
    }

    function accent(alpha: number) {
      return isDark()
        ? `rgba(196, 167, 231, ${alpha})`
        : `rgba(161, 113, 92, ${alpha})`;
    }

    type Point = [number, number];

    function scale(points: Point[], w: number, h: number) {
      return points.map(([x, y]) => [x * w, y * h] as Point);
    }

    function drawTrace(points: Point[], progress: number) {
      if (points.length < 2 || progress <= 0) return;

      const total = points.length - 1;
      const visible = progress * total;

      ctx!.beginPath();
      ctx!.moveTo(points[0][0], points[0][1]);

      for (let i = 1; i < points.length; i++) {
        const segmentProgress = Math.min(Math.max(visible - (i - 1), 0), 1);
        if (segmentProgress <= 0) break;

        const [x1, y1] = points[i - 1];
        const [x2, y2] = points[i];
        const x = x1 + (x2 - x1) * segmentProgress;
        const y = y1 + (y2 - y1) * segmentProgress;
        ctx!.lineTo(x, y);
      }

      ctx!.strokeStyle = color(0.5);
      ctx!.lineWidth = 1.15;
      ctx!.lineCap = "round";
      ctx!.lineJoin = "round";
      ctx!.stroke();
    }

    function drawNode(x: number, y: number, active = false) {
      ctx!.beginPath();
      ctx!.arc(x, y, active ? 3.2 : 2.15, 0, Math.PI * 2);
      ctx!.fillStyle = active ? accent(0.58) : color(0.4);
      ctx!.fill();
    }

    function drawChip(x: number, y: number, size: number) {
      ctx!.save();
      ctx!.translate(x, y);
      ctx!.rotate(-0.08);
      ctx!.strokeStyle = color(0.42);
      ctx!.lineWidth = 1;
      ctx!.strokeRect(-size / 2, -size / 2, size, size);

      for (let i = -2; i <= 2; i++) {
        if (i === 0) continue;
        ctx!.beginPath();
        ctx!.moveTo(-size / 2 - 8, i * (size / 7));
        ctx!.lineTo(-size / 2, i * (size / 7));
        ctx!.moveTo(size / 2, i * (size / 7));
        ctx!.lineTo(size / 2 + 8, i * (size / 7));
        ctx!.stroke();
      }
      ctx!.restore();
    }

    function drawNote(text: string, x: number, y: number, rotate: number) {
      ctx!.save();
      ctx!.translate(x, y);
      ctx!.rotate(rotate);
      ctx!.font = "700 24px Caveat, cursive";
      ctx!.fillStyle = accent(0.56);
      ctx!.fillText(text, 0, 0);
      ctx!.restore();
    }

    function drawTerminalText(text: string, x: number, y: number, rotate = 0) {
      ctx!.save();
      ctx!.translate(x, y);
      ctx!.rotate(rotate);
      ctx!.font = "700 13px Menlo, Consolas, monospace";
      ctx!.fillStyle = color(0.3);
      ctx!.fillText(text, 0, 0);
      ctx!.restore();
    }

    function drawBracket(x: number, y: number, height: number) {
      ctx!.save();
      ctx!.strokeStyle = accent(0.5);
      ctx!.lineWidth = 1.5;
      ctx!.beginPath();
      ctx!.moveTo(x + 16, y);
      ctx!.lineTo(x, y);
      ctx!.lineTo(x, y + height);
      ctx!.lineTo(x + 16, y + height);
      ctx!.stroke();
      ctx!.restore();
    }

    function render(progress = 1) {
      const w = window.innerWidth;
      const h = window.innerHeight;
      ctx!.clearRect(0, 0, w, h);

      const traces = [
        scale(
          [
            [0.78, 0.1],
            [0.85, 0.1],
            [0.85, 0.2],
            [0.91, 0.2],
            [0.91, 0.34],
            [0.97, 0.34],
          ],
          w,
          h,
        ),
        scale(
          [
            [0.66, 0.36],
            [0.75, 0.36],
            [0.75, 0.46],
            [0.84, 0.46],
            [0.84, 0.56],
            [0.93, 0.56],
          ],
          w,
          h,
        ),
        scale(
          [
            [0.02, 0.78],
            [0.12, 0.78],
            [0.12, 0.68],
            [0.24, 0.68],
            [0.24, 0.58],
            [0.38, 0.58],
          ],
          w,
          h,
        ),
        scale(
          [
            [0.58, 0.84],
            [0.7, 0.84],
            [0.7, 0.76],
            [0.82, 0.76],
            [0.82, 0.68],
            [0.94, 0.68],
          ],
          w,
          h,
        ),
      ];

      traces.forEach((trace, index) => {
        const localProgress = Math.max(0, Math.min(1, progress * 1.2 - index * 0.12));
        drawTrace(trace, localProgress);
        if (localProgress >= 0.98) {
          trace.forEach(([x, y], pointIndex) => {
            if (pointIndex % 2 === 0) drawNode(x, y, pointIndex === trace.length - 1);
          });
        }
      });

      drawChip(w * 0.86, h * 0.31, 42);
      drawChip(w * 0.2, h * 0.68, 34);

      if (w > 720) {
        drawBracket(w * 0.68, h * 0.18, 76);
        drawNote("trace this later", w * 0.7, h * 0.22, -0.07);
        drawNote("works until it doesn't", w * 0.08, h * 0.64, -0.1);
        drawNote("todo: break cleaner", w * 0.66, h * 0.64, 0.08);
        drawTerminalText("nix flake check --impure", w * 0.06, h * 0.2, -0.035);
        drawTerminalText("nmap -sC -sV -p- 10.10.11.42", w * 0.68, h * 0.43, 0.04);
        drawTerminalText("uid=0(root) gid=0(root)", w * 0.12, h * 0.88, 0.02);
        drawTerminalText("RIP=0x4141414141414141", w * 0.62, h * 0.79, -0.025);
        drawTerminalText("ffuf -u /FUZZ -w raft.txt", w * 0.78, h * 0.13, 0.03);
        drawTerminalText("/nix/store/4n9x...-shell", w * 0.58, h * 0.92, -0.015);
        drawTerminalText("nc -lvnp 4444", w * 0.84, h * 0.62, 0.04);
        drawTerminalText("age.secrets.ssh-key.file", w * 0.18, h * 0.76, -0.02);
        drawTerminalText("builtins.derivation { }", w * 0.36, h * 0.53, 0.025);
      } else {
        drawNote("trace later", w * 0.58, h * 0.16, -0.07);
        drawTerminalText("nix flake check", w * 0.08, h * 0.84, -0.03);
        drawTerminalText("nc -lvnp 4444", w * 0.56, h * 0.74, 0.04);
      }
    }

    function animate(timestamp: number) {
      if (!animationStart) animationStart = timestamp;
      const progress = Math.min((timestamp - animationStart) / 1300, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      render(eased);

      if (progress < 1) {
        animationId = requestAnimationFrame(animate);
      }
    }

    function resize() {
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        render();
        return;
      }

      if (animationId) cancelAnimationFrame(animationId);
      animationStart = 0;
      animationId = requestAnimationFrame(animate);
    }

    resize();
    window.addEventListener("resize", resize, { passive: true });

    new MutationObserver(() => render()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  document.addEventListener("DOMContentLoaded", drawCircuitNotes);
  if (document.readyState !== "loading") drawCircuitNotes();
</script>
