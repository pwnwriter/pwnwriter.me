<canvas id="branches-canvas" class="branches-canvas" aria-hidden="true"></canvas>

<style>
  .branches-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    opacity: 0.16;
  }
</style>

<script>
  function drawCircuitNotes() {
    const canvas = document.getElementById(
      "branches-canvas",
    ) as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    // offscreen buffer holds the static scene (traces, chips, notes, text) so
    // the realtime loop only has to redraw the moving pulses each frame.
    const buffer = document.createElement("canvas");
    const bctx = buffer.getContext("2d");
    if (!bctx) return;

    const dpr = window.devicePixelRatio || 1;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    let rafId: number | null = null;
    let introStart = 0;
    let phase: "intro" | "loop" = "intro";
    let lastFrame = 0;
    let sceneTraces: Point[][] = [];

    function isDark() {
      const html = document.documentElement;
      if (html.classList.contains("dark")) return true;
      if (html.classList.contains("light")) return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function color(alpha: number) {
      return isDark()
        ? `rgba(232, 227, 217, ${alpha})`
        : `rgba(55, 49, 83, ${alpha})`;
    }

    function accent(alpha: number) {
      return isDark()
        ? `rgba(196, 167, 231, ${alpha})`
        : `rgba(161, 113, 92, ${alpha})`;
    }

    type Point = [number, number];
    type C = CanvasRenderingContext2D;

    function scale(points: Point[], w: number, h: number) {
      return points.map(([x, y]) => [x * w, y * h] as Point);
    }

    function drawTrace(c: C, points: Point[], progress: number) {
      if (points.length < 2 || progress <= 0) return;

      const total = points.length - 1;
      const visible = progress * total;

      c.beginPath();
      c.moveTo(points[0][0], points[0][1]);

      for (let i = 1; i < points.length; i++) {
        const segmentProgress = Math.min(Math.max(visible - (i - 1), 0), 1);
        if (segmentProgress <= 0) break;

        const [x1, y1] = points[i - 1];
        const [x2, y2] = points[i];
        const x = x1 + (x2 - x1) * segmentProgress;
        const y = y1 + (y2 - y1) * segmentProgress;
        c.lineTo(x, y);
      }

      c.strokeStyle = color(0.5);
      c.lineWidth = 1.15;
      c.lineCap = "round";
      c.lineJoin = "round";
      c.stroke();
    }

    function drawNode(c: C, x: number, y: number, active = false) {
      c.beginPath();
      c.arc(x, y, active ? 3.2 : 2.15, 0, Math.PI * 2);
      c.fillStyle = active ? accent(0.58) : color(0.4);
      c.fill();
    }

    function drawChip(c: C, x: number, y: number, size: number) {
      c.save();
      c.translate(x, y);
      c.rotate(-0.08);
      c.strokeStyle = color(0.42);
      c.lineWidth = 1;
      c.strokeRect(-size / 2, -size / 2, size, size);

      for (let i = -2; i <= 2; i++) {
        if (i === 0) continue;
        c.beginPath();
        c.moveTo(-size / 2 - 8, i * (size / 7));
        c.lineTo(-size / 2, i * (size / 7));
        c.moveTo(size / 2, i * (size / 7));
        c.lineTo(size / 2 + 8, i * (size / 7));
        c.stroke();
      }
      c.restore();
    }

    function drawNote(c: C, text: string, x: number, y: number, rotate: number) {
      c.save();
      c.translate(x, y);
      c.rotate(rotate);
      c.font = "700 24px Caveat, cursive";
      c.fillStyle = accent(0.56);
      c.fillText(text, 0, 0);
      c.restore();
    }

    function drawTerminalText(c: C, text: string, x: number, y: number, rotate = 0) {
      c.save();
      c.translate(x, y);
      c.rotate(rotate);
      c.font = "700 13px Menlo, Consolas, monospace";
      c.fillStyle = color(0.3);
      c.fillText(text, 0, 0);
      c.restore();
    }

    function drawBracket(c: C, x: number, y: number, height: number) {
      c.save();
      c.strokeStyle = accent(0.5);
      c.lineWidth = 1.5;
      c.beginPath();
      c.moveTo(x + 16, y);
      c.lineTo(x, y);
      c.lineTo(x, y + height);
      c.lineTo(x + 16, y + height);
      c.stroke();
      c.restore();
    }

    function tracesFor(w: number, h: number): Point[][] {
      return [
        scale(
          [
            [0.78, 0.1],
            [0.85, 0.1],
            [0.85, 0.2],
            [0.91, 0.2],
            [0.91, 0.34],
            [0.97, 0.34],
          ],
          w,
          h,
        ),
        scale(
          [
            [0.66, 0.36],
            [0.75, 0.36],
            [0.75, 0.46],
            [0.84, 0.46],
            [0.84, 0.56],
            [0.93, 0.56],
          ],
          w,
          h,
        ),
        scale(
          [
            [0.02, 0.78],
            [0.12, 0.78],
            [0.12, 0.68],
            [0.24, 0.68],
            [0.24, 0.58],
            [0.38, 0.58],
          ],
          w,
          h,
        ),
        scale(
          [
            [0.58, 0.84],
            [0.7, 0.84],
            [0.7, 0.76],
            [0.82, 0.76],
            [0.82, 0.68],
            [0.94, 0.68],
          ],
          w,
          h,
        ),
      ];
    }

    // draw the full static scene (traces revealed to `progress`) onto ctx `c`.
    function renderScene(c: C, w: number, h: number, progress = 1) {
      c.clearRect(0, 0, w, h);

      const traces = tracesFor(w, h);

      traces.forEach((trace, index) => {
        const localProgress = Math.max(
          0,
          Math.min(1, progress * 1.2 - index * 0.12),
        );
        drawTrace(c, trace, localProgress);
        if (localProgress >= 0.98) {
          trace.forEach(([x, y], pointIndex) => {
            if (pointIndex % 2 === 0)
              drawNode(c, x, y, pointIndex === trace.length - 1);
          });
        }
      });

      drawChip(c, w * 0.86, h * 0.31, 42);
      drawChip(c, w * 0.2, h * 0.68, 34);

      if (w > 720) {
        drawBracket(c, w * 0.68, h * 0.18, 76);
        drawNote(c, "trace this later", w * 0.7, h * 0.22, -0.07);
        drawNote(c, "works until it doesn't", w * 0.08, h * 0.64, -0.1);
        drawNote(c, "todo: break cleaner", w * 0.66, h * 0.64, 0.08);
        drawTerminalText(c, "nix flake check --impure", w * 0.06, h * 0.2, -0.035);
        drawTerminalText(c, "nmap -sC -sV -p- 10.10.11.42", w * 0.68, h * 0.43, 0.04);
        drawTerminalText(c, "uid=0(root) gid=0(root)", w * 0.12, h * 0.88, 0.02);
        drawTerminalText(c, "RIP=0x4141414141414141", w * 0.62, h * 0.79, -0.025);
        drawTerminalText(c, "ffuf -u /FUZZ -w raft.txt", w * 0.78, h * 0.13, 0.03);
        drawTerminalText(c, "/nix/store/4n9x...-shell", w * 0.58, h * 0.92, -0.015);
        drawTerminalText(c, "nc -lvnp 4444", w * 0.84, h * 0.62, 0.04);
        drawTerminalText(c, "age.secrets.ssh-key.file", w * 0.18, h * 0.76, -0.02);
        drawTerminalText(c, "builtins.derivation { }", w * 0.36, h * 0.53, 0.025);
      } else {
        drawNote(c, "trace later", w * 0.58, h * 0.16, -0.07);
        drawTerminalText(c, "nix flake check", w * 0.08, h * 0.84, -0.03);
        drawTerminalText(c, "nc -lvnp 4444", w * 0.56, h * 0.74, 0.04);
      }
    }

    // position along a polyline for t in [0, 1] across its full length.
    function pointAt(points: Point[], t: number): Point {
      const total = points.length - 1;
      const d = Math.min(Math.max(t, 0), 1) * total;
      const i = Math.min(Math.floor(d), total - 1);
      const f = d - i;
      const [x1, y1] = points[i];
      const [x2, y2] = points[i + 1];
      return [x1 + (x2 - x1) * f, y1 + (y2 - y1) * f];
    }

    function buildBuffer(w: number, h: number) {
      buffer.width = w * dpr;
      buffer.height = h * dpr;
      bctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      renderScene(bctx!, w, h, 1);
    }

    // realtime layer: pulses travelling the traces + gently breathing endpoints.
    function loop(ts: number) {
      if (document.hidden) {
        rafId = null;
        return;
      }
      if (ts - lastFrame < 33) {
        rafId = requestAnimationFrame(loop);
        return;
      }
      lastFrame = ts;

      const w = window.innerWidth;
      const h = window.innerHeight;
      const time = ts / 1000;

      ctx!.clearRect(0, 0, w, h);
      ctx!.drawImage(buffer, 0, 0, w, h);

      sceneTraces.forEach((pts, i) => {
        const speed = 0.11 + i * 0.017;
        const t = (time * speed + i * 0.37) % 1;
        const head = pointAt(pts, t);
        const tail = pointAt(pts, Math.max(0, t - 0.06));

        const grad = ctx!.createLinearGradient(tail[0], tail[1], head[0], head[1]);
        grad.addColorStop(0, accent(0));
        grad.addColorStop(1, accent(0.65));
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 2;
        ctx!.lineCap = "round";
        ctx!.beginPath();
        ctx!.moveTo(tail[0], tail[1]);
        ctx!.lineTo(head[0], head[1]);
        ctx!.stroke();

        ctx!.beginPath();
        ctx!.arc(head[0], head[1], 4.5, 0, Math.PI * 2);
        ctx!.fillStyle = accent(0.16);
        ctx!.fill();
        ctx!.beginPath();
        ctx!.arc(head[0], head[1], 2.1, 0, Math.PI * 2);
        ctx!.fillStyle = accent(0.9);
        ctx!.fill();

        // breathing glow on the trace's end node
        const end = pts[pts.length - 1];
        const pulse = 0.5 + 0.5 * Math.sin(time * 1.6 + i * 1.3);
        ctx!.beginPath();
        ctx!.arc(end[0], end[1], 2.4 + pulse * 2.6, 0, Math.PI * 2);
        ctx!.fillStyle = accent(0.05 + pulse * 0.14);
        ctx!.fill();
      });

      rafId = requestAnimationFrame(loop);
    }

    function startLoop(w: number, h: number) {
      sceneTraces = tracesFor(w, h);
      buildBuffer(w, h);
      phase = "loop";
      lastFrame = 0;
      rafId = requestAnimationFrame(loop);
    }

    function introAnim(ts: number) {
      if (!introStart) introStart = ts;
      const progress = Math.min((ts - introStart) / 1300, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const w = window.innerWidth;
      const h = window.innerHeight;
      renderScene(ctx!, w, h, eased);

      if (progress < 1) {
        rafId = requestAnimationFrame(introAnim);
      } else {
        startLoop(w, h);
      }
    }

    function resize() {
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const w = window.innerWidth;
      const h = window.innerHeight;

      if (rafId) cancelAnimationFrame(rafId);
      rafId = null;

      if (reduce.matches) {
        renderScene(ctx!, w, h, 1);
        return;
      }

      introStart = 0;
      phase = "intro";
      rafId = requestAnimationFrame(introAnim);
    }

    resize();
    window.addEventListener("resize", resize, { passive: true });

    // pause when the tab isn't visible; resume the loop when it comes back.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
      } else if (!reduce.matches && phase === "loop" && rafId === null) {
        lastFrame = 0;
        rafId = requestAnimationFrame(loop);
      }
    });

    // theme flip: repaint the static buffer (and static frame) with new colors.
    new MutationObserver(() => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      if (reduce.matches) {
        renderScene(ctx!, w, h, 1);
      } else if (phase === "loop") {
        buildBuffer(w, h);
      }
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  document.addEventListener("DOMContentLoaded", drawCircuitNotes);
  if (document.readyState !== "loading") drawCircuitNotes();
</script>
