---
// Section breadcrumb: extends the sticky header path-trail (~ › notes › Title)
// with the article's live section as you scroll, as a single current-section
// chip. Clicking the chip opens a full-screen numbered table-of-contents menu
// (↑ back to top, 01. 02. 03. …, the current section marked, strikethrough on
// hover), aligned to the article column — the same on desktop and mobile.
//
// Desktop: full path + the section chip.
// Mobile (<=720px): the trail collapses to just the section chip.
// Also reachable with the `space ;` leader, then j/k to move, enter to jump.
// No-ops on pages whose article has no headings.
---

<style is:global>
	/* the single live section crumb appended onto the header breadcrumb trail */
	#breadcrumbs .crumb-section {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		flex-shrink: 0; /* hold place; the title crumb shrinks first, not this */
		white-space: nowrap;
	}

	#breadcrumbs .crumb-section .sep {
		margin: 0 0.5rem;
		color: color-mix(in srgb, var(--f-low) 38%, transparent);
	}

	#breadcrumbs .crumb-section .cicon {
		margin-right: 0.3rem;
		color: var(--accent);
		font-size: 0.9em;
	}

	#breadcrumbs .crumb-section button {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		max-width: min(38vw, 20rem);
		padding: 0.05rem 0.32rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--f-high);
		font: inherit;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	#breadcrumbs .crumb-section button:hover,
	#breadcrumbs.toc-open .crumb-section button {
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		color: var(--accent);
	}

	#breadcrumbs .crumb-section .lbl {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#breadcrumbs .crumb-section .chev {
		flex-shrink: 0;
		margin-left: 0.4rem;
		color: color-mix(in srgb, var(--f-low) 55%, transparent);
		font-size: 0.8em;
		transition: transform 0.2s ease;
	}

	#breadcrumbs.toc-open .crumb-section .chev {
		transform: rotate(180deg);
	}

	/* mobile: hide the path crumbs so only the current section chip shows */
	@media (max-width: 720px) {
		#breadcrumbs.has-active-section > li:not(.crumb-section),
		#breadcrumbs.has-active-section > span {
			display: none;
		}

		#breadcrumbs.has-active-section .crumb-section .sep {
			display: none;
		}

		#breadcrumbs.has-active-section .crumb-section button {
			max-width: min(82vw, 26rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#breadcrumbs .crumb-section .chev {
			transition: none;
		}
	}

	/* ---- the full-screen numbered table-of-contents menu ---- */
	.crumb-toc {
		position: fixed;
		inset: 0;
		z-index: 55;
		overflow-y: auto;
		background: color-mix(in srgb, var(--background) 90%, transparent);
		backdrop-filter: blur(10px) saturate(1.2);
		-webkit-backdrop-filter: blur(10px) saturate(1.2);
		animation: crumb-toc-in 0.22s ease;
	}

	@keyframes crumb-toc-in {
		from {
			opacity: 0;
		}
	}

	/* mobile: full-width list dropping from the top */
	.crumb-toc__inner {
		width: 100%;
		max-width: 48rem;
		margin: 0 auto;
		padding: clamp(4.5rem, 12vh, 7rem) 2rem 4rem;
	}

	/* desktop: the menu is a LEFT rail beside the article, which stays readable —
	   only a faint veil, no heavy blur. Vertically centred, sliding in from left. */
	@media (min-width: 721px) {
		.crumb-toc {
			display: flex;
			align-items: center;
			align-items: safe center;
			background: color-mix(in srgb, var(--background) 30%, transparent);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}

		/* a tiny rail tucked against the left edge, not a takeover */
		.crumb-toc__inner {
			width: auto;
			max-width: 15rem;
			margin: 0;
			padding: 1.5rem clamp(1.25rem, 3vw, 2.25rem);
			animation: crumb-toc-slide 0.24s ease;
		}

		.crumb-toc__top {
			margin-bottom: 1.1rem;
			font-size: 0.7rem;
		}

		.crumb-toc__list {
			gap: 0;
		}

		/* one tight little line per section (ellipsis if long) */
		.crumb-toc__item {
			padding: 0.05rem 0;
			gap: 0.45rem;
			line-height: 1.15;
		}

		.crumb-toc__item .num {
			width: 1.35rem;
			font-size: 0.58rem;
		}

		.crumb-toc__item .lb {
			font-size: 0.72rem;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.crumb-toc__item.lvl-h3 .lb {
			padding-left: 0.7rem;
		}

		.crumb-toc__item.lvl-h4 .lb {
			padding-left: 1.4rem;
		}

		.crumb-toc__item.lvl-h3 .lb {
			padding-left: 0.9rem;
		}

		.crumb-toc__item.lvl-h4 .lb {
			padding-left: 1.8rem;
		}
	}

	@keyframes crumb-toc-slide {
		from {
			opacity: 0;
			transform: translateX(-14px);
		}
	}

	.crumb-toc__top {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 2.75rem;
		color: color-mix(in srgb, var(--f-low) 78%, transparent);
		font-family: var(--font-mono);
		font-size: 0.95rem;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.crumb-toc__top .arw {
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.crumb-toc__top:hover,
	.crumb-toc__top.is-focus {
		color: var(--accent);
	}

	.crumb-toc__top:hover .arw,
	.crumb-toc__top.is-focus .arw {
		transform: translateY(-2px);
	}

	.crumb-toc__list {
		display: flex;
		flex-direction: column;
	}

	.crumb-toc__item {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.32rem 0;
		color: var(--f-high);
		text-decoration: none;
		line-height: 1.32;
	}

	.crumb-toc__item .num {
		flex-shrink: 0;
		width: 2.1rem;
		color: color-mix(in srgb, var(--f-low) 42%, transparent);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
	}

	.crumb-toc__item .lb {
		min-width: 0;
		font-size: clamp(1.12rem, 2.4vw, 1.5rem);
		transition: color 0.15s ease;
	}

	.crumb-toc__item.lvl-h3 .lb {
		padding-left: 1.4rem;
	}

	.crumb-toc__item.lvl-h4 .lb {
		padding-left: 2.8rem;
	}

	/* hover / keyboard focus: cross the entry off, cmrg-style */
	.crumb-toc__item:hover .lb,
	.crumb-toc__item.is-focus .lb {
		color: color-mix(in srgb, var(--f-low) 68%, transparent);
		text-decoration: line-through;
		text-decoration-color: color-mix(in srgb, var(--accent) 65%, transparent);
		text-decoration-thickness: 2px;
	}

	/* the section you're currently reading */
	.crumb-toc__item.is-current .num {
		color: var(--accent);
	}

	.crumb-toc__item.is-current .lb {
		color: var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.crumb-toc {
			animation: none;
		}

		.crumb-toc__inner {
			animation: none;
		}

		.crumb-toc__top .arw {
			transition: none;
		}
	}
</style>

<script>
	const ICONS: Record<string, string> = {
		H2: '✦',
		H3: '✧',
		H4: '∙',
	};
	const SEP = '›';
	const LEADER_TIMEOUT = 300;

	function initCrumbs() {
		const ul = document.getElementById('breadcrumbs');
		const prose = document.querySelector('.prose');
		if (!ul || !prose) return;

		const headings = Array.from(
			prose.querySelectorAll('h2, h3, h4'),
		) as HTMLElement[];
		if (!headings.length) return;

		const mq = window.matchMedia('(max-width: 720px)');
		let isMobile = mq.matches;

		// the single appended section chip (rebuilt as you scroll)
		let chip: { wrap: HTMLElement } | null = null;

		// ---------- the numbered TOC menu ----------
		let toc: HTMLElement | null = null;
		let tocItems: HTMLAnchorElement[] = [];
		let focusIdx = -1;
		let leaderPending = false;
		let leaderTimer: ReturnType<typeof setTimeout> | null = null;

		function currentId(): string {
			const active = getActiveHeadings();
			return active.length ? active[active.length - 1].id : '';
		}

		function buildToc() {
			const overlay = document.createElement('div');
			overlay.className = 'crumb-toc';
			overlay.setAttribute('role', 'menu');

			const inner = document.createElement('div');
			inner.className = 'crumb-toc__inner';
			overlay.appendChild(inner);

			const cur = currentId();
			tocItems = [];

			// ↑ back to top
			const top = document.createElement('a');
			top.className = 'crumb-toc__top';
			top.href = '#';
			top.innerHTML = '<span class="arw">↑</span><span>back to top</span>';
			top.addEventListener('click', (e) => {
				e.preventDefault();
				closeToc();
				window.scrollTo({
					top: 0,
					behavior: prefersReduced() ? 'auto' : 'smooth',
				});
			});
			inner.appendChild(top);
			tocItems.push(top);

			const list = document.createElement('nav');
			list.className = 'crumb-toc__list';
			inner.appendChild(list);

			headings.forEach((h, i) => {
				const text = h.textContent?.trim() || '';
				const a = document.createElement('a');
				a.href = h.id ? `#${h.id}` : '#';
				a.className =
					'crumb-toc__item lvl-' +
					h.tagName.toLowerCase() +
					(h.id && h.id === cur ? ' is-current' : '');
				a.dataset.hid = h.id || '';
				a.title = text; // full section name on hover when truncated

				const num = document.createElement('span');
				num.className = 'num';
				num.textContent = String(i + 1).padStart(2, '0') + '.';

				const lb = document.createElement('span');
				lb.className = 'lb';
				lb.textContent = text;

				a.append(num, lb);
				a.addEventListener('click', (e) => {
					e.preventDefault();
					closeToc();
					if (h.id)
						document
							.getElementById(h.id)
							?.scrollIntoView({
								behavior: prefersReduced() ? 'auto' : 'smooth',
							});
				});
				a.addEventListener('mouseenter', () => setFocus(tocItems.indexOf(a)));
				list.appendChild(a);
				tocItems.push(a);
			});

			// click on the empty backdrop (outside the list column) closes
			overlay.addEventListener('click', (e) => {
				if (e.target === overlay || e.target === inner) closeToc();
			});

			return overlay;
		}

		function setFocus(idx: number) {
			focusIdx = idx;
			tocItems.forEach((it, i) => it.classList.toggle('is-focus', i === idx));
			if (idx >= 0) tocItems[idx]?.scrollIntoView({ block: 'nearest' });
		}

		function openToc() {
			if (toc) return;
			toc = buildToc();
			document.body.appendChild(toc);
			document.documentElement.style.overflow = 'hidden'; // lock background
			ul!.classList.add('toc-open');

			// start focus on the current section
			const curEl = toc.querySelector('.is-current') as HTMLElement | null;
			setFocus(curEl ? tocItems.indexOf(curEl as HTMLAnchorElement) : 0);
		}

		function closeToc() {
			toc?.remove();
			toc = null;
			tocItems = [];
			focusIdx = -1;
			document.documentElement.style.overflow = '';
			ul!.classList.remove('toc-open');
		}

		function toggleToc() {
			if (toc) closeToc();
			else openToc();
		}

		// ---------- keyboard: leader + in-menu nav ----------
		function handleTocKeys(e: KeyboardEvent) {
			if (!toc) return;
			const actions: Record<string, () => void> = {
				j: () => setFocus((focusIdx + 1) % tocItems.length),
				ArrowDown: () => actions.j(),
				k: () => setFocus((focusIdx - 1 + tocItems.length) % tocItems.length),
				ArrowUp: () => actions.k(),
				Enter: () => tocItems[focusIdx]?.click(),
				Escape: () => closeToc(),
				q: () => closeToc(),
			};
			const action = actions[e.key];
			if (action) {
				e.preventDefault();
				action();
			}
		}

		document.addEventListener('keydown', handleTocKeys);

		document.addEventListener('keydown', (e) => {
			const tag = (e.target as HTMLElement).tagName;
			if (
				tag === 'INPUT' ||
				tag === 'TEXTAREA' ||
				(e.target as HTMLElement).isContentEditable
			)
				return;

			if (e.key === ' ' && !leaderPending) {
				leaderPending = true;
				if (leaderTimer) clearTimeout(leaderTimer);
				leaderTimer = setTimeout(() => {
					leaderPending = false;
				}, LEADER_TIMEOUT);
				return;
			}

			if (leaderPending && e.key === ';') {
				e.preventDefault();
				leaderPending = false;
				if (leaderTimer) clearTimeout(leaderTimer);
				if (chip) toggleToc();
				return;
			}

			leaderPending = false;
		});

		// ---------- active section detection ----------
		function getActiveHeadings(): HTMLElement[] {
			const offset = 120;
			let active: HTMLElement[] = [];

			for (const heading of headings) {
				const top = heading.getBoundingClientRect().top + window.scrollY;
				if (top - offset <= window.scrollY) {
					const tag = heading.tagName;
					if (tag === 'H2') {
						active = [heading];
					} else if (tag === 'H3') {
						const h2 = active.find((h) => h.tagName === 'H2');
						active = h2 ? [h2, heading] : [heading];
					} else if (tag === 'H4') {
						const h2 = active.find((h) => h.tagName === 'H2');
						const h3 = active.find((h) => h.tagName === 'H3');
						active = [h2, h3, heading].filter(Boolean) as HTMLElement[];
					}
				}
			}
			return active;
		}

		function renderChip(active: HTMLElement[]) {
			ul!.classList.add('has-active-section');
			const h = active[active.length - 1];
			const text = h.textContent?.trim() || '';

			const li = document.createElement('li');
			li.className = 'crumb-section crumb-current';

			const sep = document.createElement('span');
			sep.className = 'sep';
			sep.textContent = SEP;

			const icon = document.createElement('span');
			icon.className = 'cicon';
			icon.textContent = ICONS[h.tagName] || ICONS.H4;

			const btn = document.createElement('button');
			btn.type = 'button';
			const lbl = document.createElement('span');
			lbl.className = 'lbl';
			lbl.textContent = text;
			const chev = document.createElement('span');
			chev.className = 'chev';
			chev.textContent = '▾';
			btn.append(lbl, chev);
			btn.setAttribute('aria-label', 'Jump to a section');
			btn.setAttribute('aria-haspopup', 'menu');
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleToc();
			});

			li.append(sep, icon, btn);
			ul!.appendChild(li);
			chip = { wrap: btn };

			// keep an open menu's current marker fresh as you scroll
			if (toc) {
				const cur = currentId();
				toc.querySelectorAll('.crumb-toc__item').forEach((el) => {
					el.classList.toggle(
						'is-current',
						!!cur && (el as HTMLElement).dataset.hid === cur,
					);
				});
			}
		}

		function render() {
			ul!.querySelectorAll('.crumb-section').forEach((n) => n.remove());
			chip = null;

			const active = getActiveHeadings();
			if (!active.length) {
				ul!.classList.remove('has-active-section');
				closeToc();
				return;
			}
			renderChip(active);
		}

		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(() => {
						render();
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true },
		);

		window.addEventListener(
			'resize',
			() => {
				isMobile = mq.matches;
				render();
			},
			{ passive: true },
		);

		render();
	}

	function prefersReduced() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	initCrumbs();
	document.addEventListener('astro:after-swap', initCrumbs);
</script>
