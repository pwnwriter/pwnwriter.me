---
// Section breadcrumb: extends the sticky header path-trail (~ › notes › Title)
// with the article's live section as you scroll, as a single current-section
// chip. Clicking the chip drops a small numbered dropdown of the article's
// sections; click one to jump to it. Same compact dropdown on laptop and mobile.
// Also reachable with the `space ;` leader, then j/k to move, enter to jump.
// No-ops on pages whose article has no headings.
---

<style is:global>
	/* the single live section crumb appended onto the header breadcrumb trail */
	#breadcrumbs .crumb-section {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		flex-shrink: 0; /* hold place; the title crumb shrinks first, not this */
		white-space: nowrap;
	}

	#breadcrumbs .crumb-section .sep {
		margin: 0 0.5rem;
		color: color-mix(in srgb, var(--f-low) 38%, transparent);
	}


	#breadcrumbs .crumb-section button {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		max-width: min(38vw, 20rem);
		padding: 0.05rem 0.32rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--f-high);
		font: inherit;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	#breadcrumbs .crumb-section button:hover,
	#breadcrumbs.toc-open .crumb-section button {
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		color: var(--accent);
	}

	#breadcrumbs .crumb-section .lbl {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#breadcrumbs .crumb-section .chev {
		flex-shrink: 0;
		margin-left: 0.4rem;
		color: color-mix(in srgb, var(--f-low) 55%, transparent);
		font-size: 0.8em;
		transition: transform 0.2s ease;
	}

	#breadcrumbs.toc-open .crumb-section .chev {
		transform: rotate(180deg);
	}

	/* mobile: hide the path crumbs so only the current section chip shows */
	@media (max-width: 720px) {
		#breadcrumbs.has-active-section > li:not(.crumb-section),
		#breadcrumbs.has-active-section > span {
			display: none;
		}

		#breadcrumbs.has-active-section .crumb-section .sep {
			display: none;
		}

		#breadcrumbs.has-active-section .crumb-section button {
			max-width: min(82vw, 26rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#breadcrumbs .crumb-section .chev {
			transition: none;
		}
	}

	/* ---- compact section dropdown, dropped from the breadcrumb chip ---- */
	.crumb-toc {
		position: fixed;
		z-index: 60;
		min-width: 12rem;
		max-width: min(22rem, 92vw);
		max-height: min(62vh, 24rem);
		overflow-y: auto;
		padding: 0.3rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--b-med);
		box-shadow: 0 12px 32px -18px color-mix(in srgb, #000 45%, transparent);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		animation: crumb-toc-in 0.15s ease;
	}

	@keyframes crumb-toc-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}

	/* ↑ back to top, sitting above the section list */
	.crumb-toc__top {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 0.55rem;
		margin-bottom: 0.2rem;
		border-bottom: 1px solid var(--line);
		color: color-mix(in srgb, var(--f-low) 78%, transparent);
		text-decoration: none;
		white-space: nowrap;
	}

	.crumb-toc__top .arw {
		color: var(--accent);
	}

	.crumb-toc__top:hover,
	.crumb-toc__top.is-focus {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
		border-radius: 0.45rem;
	}

	.crumb-toc__list {
		display: flex;
		flex-direction: column;
	}

	.crumb-toc__item {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		padding: 0.4rem 0.55rem;
		border-radius: 0.45rem;
		color: var(--f-low);
		text-decoration: none;
		white-space: nowrap;
	}

	.crumb-toc__item .num {
		flex-shrink: 0;
		width: 1.5rem;
		color: color-mix(in srgb, var(--f-low) 45%, transparent);
		font-size: 0.72em;
		font-variant-numeric: tabular-nums;
	}

	.crumb-toc__item .lb {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.crumb-toc__item.lvl-h3 .lb {
		padding-left: 0.9rem;
	}

	.crumb-toc__item.lvl-h4 .lb {
		padding-left: 1.8rem;
	}

	.crumb-toc__item:hover,
	.crumb-toc__item.is-focus {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
	}

	.crumb-toc__item.is-current {
		color: var(--f-high);
	}

	.crumb-toc__item.is-current .num {
		color: var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.crumb-toc {
			animation: none;
		}
	}
</style>

<script>
	const ICONS: Record<string, string> = {
		H2: '',
		H3: '',
		H4: '',
	};
	const SEP = '›';
	const LEADER_TIMEOUT = 300;

	function initCrumbs() {
		const ul = document.getElementById('breadcrumbs');
		const prose = document.querySelector('.prose');
		if (!ul || !prose) return;

		const headings = Array.from(
			prose.querySelectorAll('h2, h3, h4'),
		) as HTMLElement[];
		if (!headings.length) return;

		const mq = window.matchMedia('(max-width: 720px)');
		let isMobile = mq.matches;

		// the single appended section chip (rebuilt as you scroll)
		let chip: { wrap: HTMLElement } | null = null;

		// ---------- the section dropdown ----------
		let toc: HTMLElement | null = null;
		let tocItems: HTMLAnchorElement[] = [];
		let focusIdx = -1;
		let leaderPending = false;
		let leaderTimer: ReturnType<typeof setTimeout> | null = null;

		function currentId(): string {
			const active = getActiveHeadings();
			return active.length ? active[active.length - 1].id : '';
		}

		function buildToc() {
			const panel = document.createElement('div');
			panel.className = 'crumb-toc';
			panel.setAttribute('role', 'menu');

			const cur = currentId();
			tocItems = [];

			// ↑ back to top
			const top = document.createElement('a');
			top.className = 'crumb-toc__top';
			top.href = '#';
			top.innerHTML = '<span class="arw">↑</span><span>back to top</span>';
			top.addEventListener('click', (e) => {
				e.preventDefault();
				closeToc();
				window.scrollTo({
					top: 0,
					behavior: prefersReduced() ? 'auto' : 'smooth',
				});
			});
			panel.appendChild(top);
			tocItems.push(top);

			const list = document.createElement('nav');
			list.className = 'crumb-toc__list';
			panel.appendChild(list);

			headings.forEach((h, i) => {
				const text = h.textContent?.trim() || '';
				const a = document.createElement('a');
				a.href = h.id ? `#${h.id}` : '#';
				a.className =
					'crumb-toc__item lvl-' +
					h.tagName.toLowerCase() +
					(h.id && h.id === cur ? ' is-current' : '');
				a.dataset.hid = h.id || '';
				a.title = text; // full section name on hover when truncated

				const num = document.createElement('span');
				num.className = 'num';
				num.textContent = String(i + 1).padStart(2, '0') + '.';

				const lb = document.createElement('span');
				lb.className = 'lb';
				lb.textContent = text;

				a.append(num, lb);
				a.addEventListener('click', (e) => {
					e.preventDefault();
					closeToc();
					if (h.id)
						document
							.getElementById(h.id)
							?.scrollIntoView({
								behavior: prefersReduced() ? 'auto' : 'smooth',
							});
				});
				a.addEventListener('mouseenter', () => setFocus(tocItems.indexOf(a)));
				list.appendChild(a);
				tocItems.push(a);
			});

			return panel;
		}

		// drop the panel just beneath the chip, clamped inside the viewport
		function positionToc() {
			if (!toc || !chip) return;
			const r = chip.wrap.getBoundingClientRect();
			toc.style.top = r.bottom + 8 + 'px';

			const width = toc.getBoundingClientRect().width || 208;
			const margin = 10;
			let left = r.left;
			if (left + width > window.innerWidth - margin) {
				left = Math.max(margin, window.innerWidth - margin - width);
			}
			toc.style.left = left + 'px';
		}

		function setFocus(idx: number) {
			focusIdx = idx;
			tocItems.forEach((it, i) => it.classList.toggle('is-focus', i === idx));
			if (idx >= 0) tocItems[idx]?.scrollIntoView({ block: 'nearest' });
		}

		function openToc() {
			if (toc || !chip) return;
			toc = buildToc();
			document.body.appendChild(toc);
			positionToc();
			ul!.classList.add('toc-open');

			// start focus on the current section
			const curEl = toc.querySelector('.is-current') as HTMLElement | null;
			setFocus(curEl ? tocItems.indexOf(curEl as HTMLAnchorElement) : 0);
		}

		function closeToc() {
			toc?.remove();
			toc = null;
			tocItems = [];
			focusIdx = -1;
			ul!.classList.remove('toc-open');
		}

		function toggleToc() {
			if (toc) closeToc();
			else openToc();
		}

		// close when clicking anywhere outside the dropdown or the chip
		document.addEventListener('click', (e) => {
			if (!toc) return;
			const t = e.target as Node;
			if (toc.contains(t) || chip?.wrap.contains(t)) return;
			closeToc();
		});

		// ---------- keyboard: leader + in-menu nav ----------
		function handleTocKeys(e: KeyboardEvent) {
			if (!toc) return;
			const actions: Record<string, () => void> = {
				j: () => setFocus((focusIdx + 1) % tocItems.length),
				ArrowDown: () => actions.j(),
				k: () => setFocus((focusIdx - 1 + tocItems.length) % tocItems.length),
				ArrowUp: () => actions.k(),
				Enter: () => tocItems[focusIdx]?.click(),
				Escape: () => closeToc(),
				q: () => closeToc(),
			};
			const action = actions[e.key];
			if (action) {
				e.preventDefault();
				action();
			}
		}

		document.addEventListener('keydown', handleTocKeys);

		document.addEventListener('keydown', (e) => {
			const tag = (e.target as HTMLElement).tagName;
			if (
				tag === 'INPUT' ||
				tag === 'TEXTAREA' ||
				(e.target as HTMLElement).isContentEditable
			)
				return;

			if (e.key === ' ' && !leaderPending) {
				leaderPending = true;
				if (leaderTimer) clearTimeout(leaderTimer);
				leaderTimer = setTimeout(() => {
					leaderPending = false;
				}, LEADER_TIMEOUT);
				return;
			}

			if (leaderPending && e.key === ';') {
				e.preventDefault();
				leaderPending = false;
				if (leaderTimer) clearTimeout(leaderTimer);
				if (chip) toggleToc();
				return;
			}

			leaderPending = false;
		});

		// ---------- active section detection ----------
		function getActiveHeadings(): HTMLElement[] {
			const offset = 120;
			let active: HTMLElement[] = [];

			for (const heading of headings) {
				const top = heading.getBoundingClientRect().top + window.scrollY;
				if (top - offset <= window.scrollY) {
					const tag = heading.tagName;
					if (tag === 'H2') {
						active = [heading];
					} else if (tag === 'H3') {
						const h2 = active.find((h) => h.tagName === 'H2');
						active = h2 ? [h2, heading] : [heading];
					} else if (tag === 'H4') {
						const h2 = active.find((h) => h.tagName === 'H2');
						const h3 = active.find((h) => h.tagName === 'H3');
						active = [h2, h3, heading].filter(Boolean) as HTMLElement[];
					}
				}
			}
			return active;
		}

		function renderChip(active: HTMLElement[]) {
			ul!.classList.add('has-active-section');
			const h = active[active.length - 1];
			const text = h.textContent?.trim() || '';

			const li = document.createElement('li');
			li.className = 'crumb-section crumb-current';

			const sep = document.createElement('span');
			sep.className = 'sep';
			sep.textContent = SEP;

			const icon = document.createElement('span');
			icon.className = 'cicon';
			icon.textContent = ICONS[h.tagName] || ICONS.H4;

			const btn = document.createElement('button');
			btn.type = 'button';
			const lbl = document.createElement('span');
			lbl.className = 'lbl';
			lbl.textContent = text;
			const chev = document.createElement('span');
			chev.className = 'chev';
			chev.textContent = '▾';
			btn.append(lbl, chev);
			btn.setAttribute('aria-label', 'Jump to a section');
			btn.setAttribute('aria-haspopup', 'menu');
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleToc();
			});

			li.append(sep, icon, btn);
			ul!.appendChild(li);
			chip = { wrap: btn };

			// keep an open dropdown aligned + its current marker fresh as you scroll
			if (toc) {
				const cur = currentId();
				toc.querySelectorAll('.crumb-toc__item').forEach((el) => {
					el.classList.toggle(
						'is-current',
						!!cur && (el as HTMLElement).dataset.hid === cur,
					);
				});
				positionToc();
			}
		}

		function render() {
			ul!.querySelectorAll('.crumb-section').forEach((n) => n.remove());
			chip = null;

			const active = getActiveHeadings();
			if (!active.length) {
				ul!.classList.remove('has-active-section');
				closeToc();
				return;
			}
			renderChip(active);
		}

		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(() => {
						render();
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true },
		);

		window.addEventListener(
			'resize',
			() => {
				isMobile = mq.matches;
				render();
			},
			{ passive: true },
		);

		render();
	}

	function prefersReduced() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	initCrumbs();
	document.addEventListener('astro:after-swap', initCrumbs);
</script>
