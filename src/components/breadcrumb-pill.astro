---
// Section breadcrumb: extends the sticky header path-trail (~ › notes › Title)
// with the article's live section as you scroll — one unified breadcrumb.
//
// Desktop: the section chain grows onto the end of the trail; clicking a
//   section crumb opens a sibling picker (also `space ;` leader + j/k/h/l).
// Mobile (<=720px): the trail would overflow, so it collapses to just the
//   current section with a chevron that opens a tap-to-jump table of contents.
// No-ops on pages whose article has no headings.
---

<style is:global>
	/* live section crumbs appended onto the end of the header breadcrumb trail */
	#breadcrumbs .crumb-section {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}

	#breadcrumbs .crumb-section .sep {
		margin: 0 0.5rem;
		color: color-mix(in srgb, var(--f-low) 38%, transparent);
	}

	#breadcrumbs .crumb-section .cicon {
		margin-right: 0.3rem;
		color: var(--accent);
		font-size: 0.9em;
	}

	#breadcrumbs .crumb-section button {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		padding: 0.05rem 0.32rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: color-mix(in srgb, var(--f-low) 82%, transparent);
		font: inherit;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	/* the deepest (current) section reads as "you are here" */
	#breadcrumbs .crumb-section:last-child button {
		color: var(--f-high);
	}

	#breadcrumbs .crumb-section button:hover {
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		color: var(--accent);
	}

	/* the collapsed mobile crumb: label + chevron */
	#breadcrumbs .crumb-current .lbl {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#breadcrumbs .crumb-current .chev {
		flex-shrink: 0;
		margin-left: 0.4rem;
		color: color-mix(in srgb, var(--f-low) 55%, transparent);
		font-size: 0.8em;
		transition: transform 0.2s ease;
	}

	#breadcrumbs.toc-open .crumb-current .chev {
		transform: rotate(180deg);
	}

	/* mobile: hide the path crumbs while deep in a section so only the current
	   section shows — nothing overflows the narrow header. */
	@media (max-width: 720px) {
		#breadcrumbs.has-active-section > li:not(.crumb-section),
		#breadcrumbs.has-active-section > span {
			display: none;
		}

		#breadcrumbs.has-active-section .crumb-section .sep {
			display: none;
		}

		#breadcrumbs.has-active-section .crumb-current button {
			max-width: min(78vw, 24rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#breadcrumbs .crumb-current .chev {
			transition: none;
		}
	}

	/* mobile table-of-contents panel */
	.crumb-toc {
		position: fixed;
		z-index: 60;
		max-height: 62vh;
		overflow-y: auto;
		padding: 0.3rem;
		border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
		border-radius: 0.8rem;
		background: color-mix(in srgb, var(--b-med) 92%, transparent);
		backdrop-filter: blur(16px) saturate(1.4);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		box-shadow: 0 18px 46px -20px color-mix(in srgb, var(--f-high) 80%, transparent);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.crumb-toc__item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.6rem;
		border-radius: 0.5rem;
		color: var(--f-low);
		text-decoration: none;
	}

	.crumb-toc__item .ic {
		flex-shrink: 0;
		color: var(--accent);
	}

	.crumb-toc__item .lb {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.crumb-toc__item.lvl-h3 {
		padding-left: 1.5rem;
	}

	.crumb-toc__item.lvl-h4 {
		padding-left: 2.4rem;
	}

	.crumb-toc__item.is-current {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--f-high);
	}

	/* the desktop sibling-picker card */
	.crumb-pick {
		position: fixed;
		z-index: 60;
		min-width: 12rem;
		max-width: 22rem;
		max-height: 16rem;
		overflow-y: auto;
		padding: 0.3rem;
		border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--b-med) 86%, transparent);
		backdrop-filter: blur(14px) saturate(1.4);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		box-shadow: 0 16px 44px -20px color-mix(in srgb, var(--f-high) 80%, transparent);
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}

	.crumb-pick a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.6rem;
		border-radius: 0.45rem;
		color: var(--f-low);
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		outline: none;
	}
</style>

<script>
	const ICONS: Record<string, string> = {
		H2: '✦',
		H3: '✧',
		H4: '∙',
	};
	const SEP = '›';
	const LEADER_TIMEOUT = 300;

	function initCrumbs() {
		const ul = document.getElementById('breadcrumbs');
		const prose = document.querySelector('.prose');
		if (!ul || !prose) return;

		const headings = Array.from(
			prose.querySelectorAll('h2, h3, h4'),
		) as HTMLElement[];
		if (!headings.length) return;

		const scroller = ul.closest('.overflow-x-auto') as HTMLElement | null;
		const mq = window.matchMedia('(max-width: 720px)');
		let isMobile = mq.matches;

		let crumbs: { wrap: HTMLElement; heading: HTMLElement }[] = [];

		// ---------- desktop sibling picker ----------
		let activePicker: HTMLElement | null = null;
		let activeCrumbIdx = -1;
		let pickerFocusIdx = -1;
		let pickerItems: HTMLAnchorElement[] = [];
		let leaderPending = false;
		let leaderTimer: ReturnType<typeof setTimeout> | null = null;

		function closePicker() {
			activePicker?.remove();
			activePicker = null;
			pickerItems = [];
			pickerFocusIdx = -1;
			activeCrumbIdx = -1;
		}

		function getSiblings(target: HTMLElement): HTMLElement[] {
			const tag = target.tagName;
			if (tag === 'H2') return headings.filter((h) => h.tagName === 'H2');

			const parentTag = tag === 'H3' ? 'H2' : 'H3';
			let parent: HTMLElement | null = null;
			for (const h of headings) {
				if (h === target) break;
				if (h.tagName === parentTag) parent = h;
			}

			const siblings: HTMLElement[] = [];
			let inScope = !parent;
			for (const h of headings) {
				if (h === parent) {
					inScope = true;
					continue;
				}
				if (inScope && h.tagName === parentTag) break;
				if (inScope && h.tagName === tag) siblings.push(h);
			}
			return siblings;
		}

		function highlightItem(idx: number) {
			pickerItems.forEach((item, i) => {
				const indicator = item.querySelector('span:first-child') as HTMLElement;
				const label = item.querySelector('span:last-child') as HTMLElement;
				const active = i === idx;
				item.style.background = active ? 'var(--b-high)' : 'transparent';
				if (indicator)
					indicator.style.color = active ? 'var(--accent)' : 'transparent';
				if (label) label.style.color = active ? 'var(--accent)' : 'var(--f-low)';
				if (active) item.scrollIntoView({ block: 'nearest' });
			});
		}

		function openPickerAt(crumbIdx: number) {
			closePicker();
			if (crumbIdx < 0 || crumbIdx >= crumbs.length) return;

			activeCrumbIdx = crumbIdx;
			const { wrap, heading: target } = crumbs[crumbIdx];
			const siblings = getSiblings(target);
			if (siblings.length <= 1) return;

			const picker = document.createElement('div');
			picker.className = 'crumb-pick';
			const btnRect = wrap.getBoundingClientRect();
			picker.style.top = btnRect.bottom + 8 + 'px';
			picker.style.left = btnRect.left + 'px';

			pickerFocusIdx = -1;
			pickerItems = [];

			siblings.forEach((h, si) => {
				if (h === target) pickerFocusIdx = si;

				const text = h.textContent?.trim() || '';
				const item = document.createElement('a');
				item.href = h.id ? `#${h.id}` : '#';
				item.title = text;

				const indicator = document.createElement('span');
				indicator.textContent = SEP;
				indicator.style.cssText =
					'flex-shrink: 0; font-weight: bold; color: transparent; width: 0.75rem;';

				const iconSpan = document.createElement('span');
				iconSpan.textContent = ICONS[h.tagName] || ICONS.H4;
				iconSpan.style.cssText = 'flex-shrink: 0; color: var(--accent);';

				const label = document.createElement('span');
				label.textContent = text;
				label.style.cssText =
					'overflow: hidden; text-overflow: ellipsis; color: var(--f-low);';

				item.append(indicator, iconSpan, label);

				item.addEventListener('mouseenter', () => {
					pickerFocusIdx = si;
					highlightItem(pickerFocusIdx);
				});
				item.addEventListener('click', (e) => {
					e.preventDefault();
					closePicker();
					if (h.id)
						document
							.getElementById(h.id)
							?.scrollIntoView({ behavior: 'smooth' });
				});

				picker.appendChild(item);
				pickerItems.push(item);
			});

			document.body.appendChild(picker);
			highlightItem(pickerFocusIdx);
			activePicker = picker;
		}

		function handlePickerKeys(e: KeyboardEvent) {
			if (!activePicker) return;

			const actions: Record<string, () => void> = {
				j: () => {
					pickerFocusIdx = (pickerFocusIdx + 1) % pickerItems.length;
					highlightItem(pickerFocusIdx);
				},
				ArrowDown: () => actions.j(),
				k: () => {
					pickerFocusIdx =
						(pickerFocusIdx - 1 + pickerItems.length) % pickerItems.length;
					highlightItem(pickerFocusIdx);
				},
				ArrowUp: () => actions.k(),
				h: () => {
					if (activeCrumbIdx > 0) openPickerAt(activeCrumbIdx - 1);
				},
				ArrowLeft: () => actions.h(),
				l: () => {
					if (activeCrumbIdx < crumbs.length - 1)
						openPickerAt(activeCrumbIdx + 1);
				},
				ArrowRight: () => actions.l(),
				Enter: () => pickerItems[pickerFocusIdx]?.click(),
				Escape: () => closePicker(),
				q: () => closePicker(),
			};

			const action = actions[e.key];
			if (action) {
				e.preventDefault();
				action();
			}
		}

		document.addEventListener('keydown', handlePickerKeys);

		document.addEventListener('keydown', (e) => {
			const tag = (e.target as HTMLElement).tagName;
			if (
				tag === 'INPUT' ||
				tag === 'TEXTAREA' ||
				(e.target as HTMLElement).isContentEditable
			)
				return;

			if (e.key === ' ' && !leaderPending) {
				leaderPending = true;
				if (leaderTimer) clearTimeout(leaderTimer);
				leaderTimer = setTimeout(() => {
					leaderPending = false;
				}, LEADER_TIMEOUT);
				return;
			}

			if (leaderPending && e.key === ';') {
				e.preventDefault();
				leaderPending = false;
				if (leaderTimer) clearTimeout(leaderTimer);
				if (activePicker) closePicker();
				else if (!isMobile && crumbs.length > 0)
					openPickerAt(crumbs.length - 1);
				return;
			}

			leaderPending = false;
		});

		document.addEventListener('click', (e) => {
			if (!activePicker) return;
			const target = e.target as Node;
			if (activePicker.contains(target)) return;
			if (crumbs.some((c) => c.wrap.contains(target))) return;
			closePicker();
		});

		// ---------- mobile table of contents ----------
		let toc: HTMLElement | null = null;

		function buildToc() {
			const panel = document.createElement('div');
			panel.className = 'crumb-toc';
			headings.forEach((h) => {
				const a = document.createElement('a');
				a.href = h.id ? `#${h.id}` : '#';
				a.className = 'crumb-toc__item lvl-' + h.tagName.toLowerCase();
				a.dataset.hid = h.id || '';

				const ic = document.createElement('span');
				ic.className = 'ic';
				ic.textContent = ICONS[h.tagName] || ICONS.H4;

				const lb = document.createElement('span');
				lb.className = 'lb';
				lb.textContent = h.textContent?.trim() || '';

				a.append(ic, lb);
				a.addEventListener('click', (e) => {
					e.preventDefault();
					closeToc();
					if (h.id)
						document.getElementById(h.id)?.scrollIntoView({ behavior: 'smooth' });
				});
				panel.appendChild(a);
			});
			return panel;
		}

		function positionToc() {
			if (!toc) return;
			const header = document.querySelector('.site-header');
			const top = header ? header.getBoundingClientRect().bottom : 56;
			toc.style.top = top + 6 + 'px';
			toc.style.left = '0.6rem';
			toc.style.right = '0.6rem';
		}

		function highlightToc() {
			if (!toc) return;
			const active = getActiveHeadings();
			const currentId = active.length ? active[active.length - 1].id : '';
			toc.querySelectorAll('.crumb-toc__item').forEach((el) => {
				el.classList.toggle(
					'is-current',
					!!currentId && (el as HTMLElement).dataset.hid === currentId,
				);
			});
		}

		function openToc() {
			if (toc) return;
			toc = buildToc();
			document.body.appendChild(toc);
			positionToc();
			highlightToc();
			ul!.classList.add('toc-open');
		}

		function closeToc() {
			toc?.remove();
			toc = null;
			ul!.classList.remove('toc-open');
		}

		document.addEventListener('click', (e) => {
			if (!toc) return;
			const t = e.target as Node;
			if (toc.contains(t)) return;
			const currentBtn = ul!.querySelector('.crumb-current button');
			if (currentBtn && currentBtn.contains(t)) return;
			closeToc();
		});

		// ---------- active section detection ----------
		function getActiveHeadings(): HTMLElement[] {
			const offset = 120;
			let active: HTMLElement[] = [];

			for (const heading of headings) {
				const top = heading.getBoundingClientRect().top + window.scrollY;
				if (top - offset <= window.scrollY) {
					const tag = heading.tagName;
					if (tag === 'H2') {
						active = [heading];
					} else if (tag === 'H3') {
						const h2 = active.find((h) => h.tagName === 'H2');
						active = h2 ? [h2, heading] : [heading];
					} else if (tag === 'H4') {
						const h2 = active.find((h) => h.tagName === 'H2');
						const h3 = active.find((h) => h.tagName === 'H3');
						active = [h2, h3, heading].filter(Boolean) as HTMLElement[];
					}
				}
			}
			return active;
		}

		function renderMobile(active: HTMLElement[]) {
			ul!.classList.add('has-active-section');
			const h = active[active.length - 1];
			const text = h.textContent?.trim() || '';

			const li = document.createElement('li');
			li.className = 'crumb-section crumb-current';

			const sep = document.createElement('span');
			sep.className = 'sep';
			sep.textContent = SEP;

			const icon = document.createElement('span');
			icon.className = 'cicon';
			icon.textContent = ICONS[h.tagName] || ICONS.H4;

			const btn = document.createElement('button');
			const lbl = document.createElement('span');
			lbl.className = 'lbl';
			lbl.textContent = text;
			const chev = document.createElement('span');
			chev.className = 'chev';
			chev.textContent = '▾';
			btn.append(lbl, chev);
			btn.setAttribute('aria-label', 'Jump to section');
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				if (toc) closeToc();
				else openToc();
			});

			li.append(sep, icon, btn);
			ul!.appendChild(li);
			crumbs.push({ wrap: btn, heading: h });

			if (toc) {
				positionToc();
				highlightToc();
			}
		}

		function renderDesktop(active: HTMLElement[]) {
			ul!.classList.remove('has-active-section');
			active.forEach((h) => {
				const text = h.textContent?.trim() || '';

				const li = document.createElement('li');
				li.className = 'crumb-section';

				const sep = document.createElement('span');
				sep.className = 'sep';
				sep.textContent = SEP;

				const icon = document.createElement('span');
				icon.className = 'cicon';
				icon.textContent = ICONS[h.tagName] || ICONS.H4;

				const btn = document.createElement('button');
				btn.textContent = text.length > 34 ? text.slice(0, 34) + '…' : text;
				if (text.length > 34) btn.title = text;

				const idx = crumbs.length;
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					if (activePicker && activeCrumbIdx === idx) closePicker();
					else openPickerAt(idx);
				});

				li.append(sep, icon, btn);
				ul!.appendChild(li);
				crumbs.push({ wrap: btn, heading: h });
			});

			if (scroller) scroller.scrollLeft = scroller.scrollWidth;
		}

		function render() {
			ul!.querySelectorAll('.crumb-section').forEach((n) => n.remove());
			crumbs = [];

			const active = getActiveHeadings();
			if (!active.length) {
				ul!.classList.remove('has-active-section');
				if (activePicker) closePicker();
				if (toc) closeToc();
				return;
			}

			if (isMobile) {
				if (activePicker) closePicker();
				renderMobile(active);
			} else {
				if (toc) closeToc();
				renderDesktop(active);
			}
		}

		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(() => {
						render();
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true },
		);

		window.addEventListener(
			'resize',
			() => {
				isMobile = mq.matches;
				positionToc();
				render();
			},
			{ passive: true },
		);

		render();
	}

	initCrumbs();
	document.addEventListener('astro:after-swap', initCrumbs);
</script>
