---
import { getCollection } from "astro:content";
const { tag } = Astro.props;
const posts = (await getCollection("posts"))
  .filter((post) => !tag || post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<ul class="rows">
  {
    posts.map((post) => (
      <li
        class="post-item"
        data-tags={post.data.tags.join(",")}
        data-search={`${post.data.title} ${post.data.description ?? ""} ${post.body}`.toLowerCase()}
      >
        <a class="row" href={`/notes/${post.slug}`}>
          <>
            <span class="row-title">{post.data.title}</span>
            <time class="row-date" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en-US", {
                month: "short",
                year: "numeric",
              })}
            </time>
          </>
        </a>
      </li>
    ))
  }
</ul>
