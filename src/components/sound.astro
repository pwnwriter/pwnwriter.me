---
// Playful interface sounds, synthesised in real time with the Web Audio API so
// there are zero audio files to ship and it all works offline:
//   - a soft "tick" on every click (links, buttons)
//   - a graphite "scratch" per character as the sign-off writes itself out
//   - a quiet blip when a blog entry slides under the pointer
//
// Everything hangs off window.pwnSfx so other components (the sign-off typer)
// can trigger a note without importing anything. Browsers won't let audio play
// before a user gesture, so the very first click just unlocks the context; from
// then on it sings. A persisted mute toggle sits in the bottom-left corner.
---

<button
  type="button"
  data-sfx-toggle
  class="sfx-toggle"
  aria-label="toggle interface sounds"
  aria-pressed="false"
  title="interface sounds"
>
  <span class="sfx-ico sfx-ico--on" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" stroke="none"></path>
      <path d="M16.5 8.5a4 4 0 0 1 0 7"></path>
      <path d="M19 6a7.5 7.5 0 0 1 0 12"></path>
    </svg>
  </span>
  <span class="sfx-ico sfx-ico--off" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" stroke="none"></path>
      <path d="M22 9l-6 6"></path>
      <path d="M16 9l6 6"></path>
    </svg>
  </span>
</button>

<style>
  .sfx-toggle {
    position: fixed;
    left: 1rem;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 50;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--f-low) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--background) 62%, transparent);
    color: color-mix(in srgb, var(--f-low) 76%, transparent);
    backdrop-filter: blur(12px) saturate(1.35);
    -webkit-backdrop-filter: blur(12px) saturate(1.35);
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .sfx-toggle:hover,
  .sfx-toggle:focus-visible {
    opacity: 1;
    color: var(--accent);
    transform: translateY(-1px);
    outline: none;
  }

  /* which glyph shows depends on the muted state, flagged on the button */
  .sfx-ico {
    display: none;
    line-height: 0;
  }

  .sfx-toggle:not(.is-muted) .sfx-ico--on,
  .sfx-toggle.is-muted .sfx-ico--off {
    display: inline-flex;
  }

  .sfx-toggle.is-muted {
    color: color-mix(in srgb, var(--f-low) 52%, transparent);
  }

  @media (max-width: 640px) {
    .sfx-toggle {
      opacity: 0.4;
    }
  }
</style>

<script>
  interface PwnSfx {
    click: () => void;
    hover: () => void;
    pencil: () => void;
    isMuted: () => boolean;
    setMuted: (m: boolean) => void;
  }

  declare global {
    interface Window {
      pwnSfx?: PwnSfx;
      webkitAudioContext?: typeof AudioContext;
    }
  }

  const STORAGE_KEY = "sfx-muted";

  function buildEngine(): PwnSfx {
    let ctx: AudioContext | null = null;
    let master: GainNode | null = null;
    let noise: AudioBuffer | null = null;
    let muted = localStorage.getItem(STORAGE_KEY) === "1";
    let lastHover = 0;

    function ensure(): boolean {
      if (muted) return false;
      if (!ctx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return false;
        ctx = new AC();
        master = ctx.createGain();
        master.gain.value = 0.5;
        master.connect(ctx.destination);

        // one shared half-second of white noise for the tick + scratch
        const len = Math.floor(ctx.sampleRate * 0.5);
        noise = ctx.createBuffer(1, len, ctx.sampleRate);
        const data = noise.getChannelData(0);
        for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
      }
      if (ctx.state === "suspended") ctx.resume();
      return true;
    }

    // a short filtered burst of the shared noise buffer
    function burst(freq: number, q: number, peak: number, decay: number) {
      if (!ctx || !master || !noise) return;
      const t = ctx.currentTime;
      const src = ctx.createBufferSource();
      src.buffer = noise;
      src.playbackRate.value = 0.85 + Math.random() * 0.3;

      const bp = ctx.createBiquadFilter();
      bp.type = "bandpass";
      bp.frequency.value = freq;
      bp.Q.value = q;

      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.linearRampToValueAtTime(peak, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + decay);

      src.connect(bp).connect(g).connect(master);
      src.start(t);
      src.stop(t + decay + 0.02);
    }

    // a soft, rounded "pop". cmrg's sounds are recorded samples replayed at a
    // jittered playbackRate; we mimic that warmth with a sine whose pitch dips
    // as it decays, gently low-passed, plus a touch of random detune per hit so
    // repeats never sound identical (their trick is Math.random()/9 + 0.9).
    function pop(freq: number, endFreq: number, peak: number, dur: number) {
      if (!ctx || !master) return;
      const now = ctx.currentTime;
      const jitter = 0.9 + Math.random() * 0.14; // ~ playbackRate 0.9–1.04
      const f0 = freq * jitter;

      const osc = ctx.createOscillator();
      osc.type = "sine";
      osc.frequency.setValueAtTime(f0, now);
      osc.frequency.exponentialRampToValueAtTime(
        endFreq * jitter,
        now + dur * 0.9,
      );

      const lp = ctx.createBiquadFilter();
      lp.type = "lowpass";
      lp.frequency.value = 2400;

      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, now);
      g.gain.exponentialRampToValueAtTime(peak, now + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, now + dur);

      osc.connect(lp).connect(g).connect(master);
      osc.start(now);
      osc.stop(now + dur + 0.02);
    }

    function click() {
      if (!ensure()) return;
      pop(430, 240, 0.28, 0.08); // warm, tactile "bop"
      burst(2600, 1.2, 0.05, 0.02); // a whisper of noise on top for the "tick"
    }

    function hover() {
      if (!ensure() || !ctx) return;
      const now = ctx.currentTime;
      if (now - lastHover < 0.05) return; // don't stack on fast pointer sweeps
      lastHover = now;
      pop(620, 470, 0.07, 0.055); // a quieter, higher sibling of the click
    }

    function pencil() {
      if (!ensure()) return;
      // a scratchy graphite stroke: bright, brief, gently randomised so a run
      // of characters reads as continuous handwriting rather than a machine gun
      burst(1500 + Math.random() * 1600, 0.6, 0.05, 0.035);
    }

    return {
      click,
      hover,
      pencil,
      isMuted: () => muted,
      setMuted: (m: boolean) => {
        muted = m;
        localStorage.setItem(STORAGE_KEY, m ? "1" : "0");
      },
    };
  }

  function initSound() {
    if (!window.pwnSfx) {
      window.pwnSfx = buildEngine();

      // click "tick" for anything that reads as a control
      document.addEventListener(
        "pointerdown",
        (e) => {
          const t = e.target as HTMLElement | null;
          if (
            t?.closest(
              'a[href], button, [role="button"], summary, input[type="submit"], input[type="button"], label',
            )
          ) {
            window.pwnSfx?.click();
          }
        },
        true,
      );

      // blip when a blog entry slides under the pointer. mouseover bubbles (unlike
      // mouseenter), so we delegate and only fire when the item actually changes.
      let lastItem: Element | null = null;
      document.addEventListener("mouseover", (e) => {
        const item = (e.target as HTMLElement | null)?.closest(
          ".post-item, [data-sfx-hover]",
        );
        if (item && item !== lastItem) {
          lastItem = item;
          window.pwnSfx?.hover();
        } else if (!item) {
          lastItem = null;
        }
      });

      // the mute toggle survives view-transition swaps via delegation
      document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement | null)?.closest(
          "[data-sfx-toggle]",
        ) as HTMLButtonElement | null;
        if (!btn) return;
        const next = !window.pwnSfx!.isMuted();
        window.pwnSfx!.setMuted(next);
        syncToggle();
        if (!next) window.pwnSfx!.click(); // little confirmation on unmute
      });
    }

    syncToggle();
  }

  function syncToggle() {
    const muted = window.pwnSfx?.isMuted() ?? false;
    document.querySelectorAll("[data-sfx-toggle]").forEach((el) => {
      const btn = el as HTMLButtonElement;
      btn.classList.toggle("is-muted", muted);
      btn.setAttribute("aria-pressed", muted ? "false" : "true");
      btn.title = muted ? "interface sounds: off" : "interface sounds: on";
    });
  }

  initSound();
  document.addEventListener("astro:after-swap", initSound);
</script>
