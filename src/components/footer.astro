---
// One quiet line under the prayer flags. The contact icons live in the intro, so they
// are not repeated here.
import Wrapper from "~/components/wrapper.astro";
import PrayerFlags from "~/components/prayer-flags.astro";

const site = [
  { text: "syndications", href: "/syndications" },
  { text: "tags", href: "/notes/tags" },
  {
    text: "rss",
    href: import.meta.env.DEV ? `/rss.xml?${Date.now()}` : "/rss.xml",
  },
  {
    text: "stats",
    href: "https://cloud.umami.is/share/tNl4j2DN3BMN3xwq/pwnwriter.me",
  },
];

const year = new Date().getFullYear();
---

<Wrapper>
  <PrayerFlags />
  <footer class="site-footer meta">
    <span>© {year} pwnwriter</span>
    <nav aria-label="footer">
      {
        site.map(({ text, href }) => (
          <a
            href={href}
            rel={href.startsWith("http") ? "external noopener" : undefined}
            target={href.startsWith("http") ? "_blank" : undefined}
          >
            {text}
          </a>
        ))
      }
    </nav>
  </footer>
</Wrapper>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding: 0.9rem 0 1.5rem;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1.1rem;
  }

  .site-footer a {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--f-high);
  }
</style>
