---
import Wrapper from "~/components/wrapper.astro";
import Vine from "~/components/vine.astro";

const site = [
  { text: "syndications", href: "/syndications" },
  { text: "photos", href: "/photos" },
  {
    text: "rss",
    href: import.meta.env.DEV ? `/rss.xml?${Date.now()}` : "/rss.xml",
  },
  {
    text: "stats",
    href: "https://cloud.umami.is/share/tNl4j2DN3BMN3xwq/pwnwriter.me",
  },
];

// 24x24 filled glyphs, drawn in currentColor
const elsewhere = [
  {
    label: "GitHub",
    href: "https://github.com/pwnwriter",
    icon: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "X",
    href: "https://x.com/pwnwriter",
    icon: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/pwnwriter",
    icon: "M20.447 20.452h-3.554v-5.569c0-1.327-.027-3.036-1.85-3.036-1.853 0-2.136 1.447-2.136 2.942v5.663H9.354V9h3.413v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.266 2.37 4.266 5.455v6.286ZM5.337 7.433c-1.144 0-2.07-.928-2.07-2.07 0-1.143.926-2.07 2.07-2.07 1.143 0 2.07.927 2.07 2.07 0 1.142-.927 2.07-2.07 2.07Zm1.778 13.019H3.558V9h3.557v11.452ZM22.225 0H1.771C.792 0 0 .771 0 1.723v20.554C0 23.229.792 24 1.771 24h20.451C23.2 24 24 23.229 24 22.277V1.723C24 .771 23.2 0 22.225 0Z",
  },
  {
    label: "Email",
    href: "mailto:hi@pwnwriter.me",
    icon: "M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67ZM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z",
  },
];
---

<Wrapper>
  <Vine />
  <footer class="site-footer meta">
    <nav aria-label="footer">
      {
        site.map(({ text, href }) => (
          <a
            href={href}
            rel={href.startsWith("http") ? "external" : undefined}
            target={href.startsWith("http") ? "_blank" : undefined}
          >
            {text}
          </a>
        ))
      }
    </nav>

    <nav class="elsewhere" aria-label="elsewhere">
      {
        elsewhere.map(({ label, href, icon }) => (
          <a
            href={href}
            aria-label={label}
            title={label}
            rel={href.startsWith("http") ? "me noopener noreferrer" : undefined}
            target={href.startsWith("http") ? "_blank" : undefined}
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={icon} />
            </svg>
          </a>
        ))
      }
    </nav>
  </footer>
</Wrapper>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding: 1.1rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1.1rem;
  }

  .site-footer .elsewhere {
    gap: 1.1rem;
  }

  .site-footer a {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--f-high);
  }
</style>
