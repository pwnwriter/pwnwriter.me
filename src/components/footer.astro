---
import SiteDirectory from './SiteDirectory.astro';
---
<footer class="site-footer shell compact-footer">
  <span class="footer-copyright">© {new Date().getFullYear()} pwnwriter</span>
  <span class="jump-hint">Press <kbd>/</kbd> to jump anywhere</span>
  <SiteDirectory />
</footer>
<style>
.compact-footer{justify-content:space-between;align-items:center;padding-block:20px 100px;}
.footer-copyright{font:10px var(--font-mono);color:var(--f-mute);}
.jump-hint{font:12px var(--font-sans);color:var(--f-mute);display:flex;align-items:center;gap:7px;}.jump-hint kbd{font:10px var(--font-mono);padding:4px 7px;border-radius:6px;background:#e7e8ed;color:#7a7f90;}
@media(max-width:640px){.compact-footer{flex-direction:row;gap:15px;}.jump-hint{font-size:11px;}}
</style>
