---
import Wrapper from "~/components/wrapper.astro";

const links = [
  { text: "~", href: "/" },
  { text: "about", href: "/about" },
  { text: "notes", href: "/notes" },
  { text: "projects", href: "/projects" },
  { text: "syndications", href: "/syndications" },
  {
    text: "rss",
    href: import.meta.env.DEV ? `/rss.xml?${Date.now()}` : "/rss.xml",
  },
  {
    text: "stats",
    href: "https://cloud.umami.is/share/tNl4j2DN3BMN3xwq/pwnwriter.me",
  },
];
---

<Wrapper>
  <footer class="py-md text-center font-mono">
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1">
      {
        links.map(({ text, href }) => {
          const isExternal = href.startsWith("http");
          const label = text === "~" ? "~" : `/${text}`;
          return (
            <a
              href={href}
              rel={isExternal ? "external" : undefined}
              target={isExternal ? "_blank" : undefined}
              class="footer-slash"
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <p class="mt-4 text-xs text-f-low opacity-50">
      &copy; {new Date().getFullYear()} pwnwriter
    </p>
  </footer>
</Wrapper>

<style>
  /* sit above the bottom edge-blur (z-10) so the footer stays crisp at the end
     of the page while the blur still softens body content mid-scroll. */
  footer {
    position: relative;
    z-index: 11;
  }

  /* cmrg-style lowercase slash links: no chrome, just quiet text that warms
     to the accent on hover. */
  .footer-slash {
    font-size: 0.75rem;
    letter-spacing: 0;
    text-transform: lowercase;
    color: color-mix(in srgb, var(--f-low) 68%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-slash:hover,
  .footer-slash:focus-visible {
    color: var(--accent);
  }
</style>
