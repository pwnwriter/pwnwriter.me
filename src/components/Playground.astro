---
import { getCollection } from 'astro:content';
const notes = (await getCollection('posts')).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime()).slice(0,3);
---
<section class="playground" aria-label="Little experiments">
 <header class="shelf-head"><h2>little experiments</h2><span>go on, try one</span></header>
 <div class="shelf" id="playground-shelf">
  <article class="toy"><div class="stage terminal-stage">
   <div class="terminal"><div class="terminal-bar"><span></span><span></span><span></span><small>pwn@localhost</small></div><div class="terminal-copy"><div class="command"><span>❯</span> <span data-command>whoami</span></div><div class="terminal-output" data-terminal-output aria-live="polite">nabeen<br/>security research & interfaces</div></div><button type="button" class="run-command" aria-label="Run next terminal demo">run <span aria-hidden="true">↵</span></button></div>
  </div><div class="toy-label"><h3>the terminal</h3><span>one command at a time</span></div></article>
  <article class="toy"><div class="stage folder-stage">
   <details class="note-folder"><summary aria-label="Open notes folder"><span class="folder-back"></span><span class="paper paper-one"></span><span class="paper paper-two"></span><span class="folder-front"><span class="folder-symbol" aria-hidden="true">✳</span><span class="folder-label">field notes</span></span></summary><div class="folder-contents"><header><span>recent notes</span><button type="button" class="close-folder" aria-label="Close notes folder">×</button></header>{notes.map(note=><a href={`/notes/${note.slug}`}><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 2h6l3 3v9H4zM9 2v4h4"/></svg><span>{note.data.title}</span><span aria-hidden="true">↗</span></a>)}</div></details>
  </div><div class="toy-label"><h3>field notes</h3><span>open the folder</span></div></article>
  <article class="toy"><div class="stage dial-stage" data-color-toy>
   <div class="dial-device"><div class="dial-display"><span class="tiny-led"></span><span data-color-label>sage</span><span class="dial-value" data-dial-value>140°</span></div><div class="dial-well"><div class="dial-knob"><span class="knob-marker"></span><span class="knob-center"></span></div></div><label class="dial-control"><span class="sr-only">Turn the color dial</span><input type="range" min="0" max="360" value="140" aria-label="Turn the color dial"/></label><span class="dial-caption">a little change of hue</span></div>
  </div><div class="toy-label"><h3>color study</h3><span>turn the dial</span></div></article>
 </div>
 <nav class="shelf-controls" aria-label="Browse experiments"><button type="button" data-shelf-step="-1" aria-label="Previous experiment">←</button><button type="button" data-shelf-step="1" aria-label="Next experiment">→</button></nav>
</section>
<style>
.playground{margin:3.6rem 0 2.6rem;}
.shelf-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1.1rem;}.shelf-head h2{font:12px var(--font-sans);font-weight:450;color:var(--f-low);margin:0;}.shelf-head>span{font-size:11px;color:var(--f-mute);}
.shelf{display:grid;grid-auto-flow:column;grid-auto-columns:260px;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 0 6px;}.shelf::-webkit-scrollbar{display:none;}.toy{min-width:0;scroll-snap-align:start;}.stage{position:relative;height:258px;border-radius:24px;background:#f0f0eb;display:grid;place-items:center;overflow:hidden;}
.toy-label{display:flex;flex-direction:column;gap:3px;margin-top:12px;}.toy-label h3{font-size:13px;font-weight:500;color:var(--f-high);margin:0;}.toy-label>span{font-size:11px;color:var(--f-mute);}
.terminal{width:222px;position:relative;overflow:hidden;border-radius:12px;background:#29312e;color:#dce8db;box-shadow:0 15px 24px #202b2426;border:1px solid #36433a;transform:rotate(-3deg);transition:transform .35s;}.terminal:hover{transform:rotate(0) translateY(-3px);}.terminal-bar{display:flex;align-items:center;gap:4px;padding:10px;background:#343d37;}.terminal-bar>span{height:5px;width:5px;border-radius:50%;background:#bfa490;}.terminal-bar>span:nth-child(2){background:#c4b581;}.terminal-bar>span:nth-child(3){background:#92ab8c;}.terminal-bar small{font:8px var(--font-mono);margin-left:auto;color:#a5b2a8;}.terminal-copy{padding:15px 14px 8px;font:9px/1.8 var(--font-mono);height:105px;}.command{color:#d8e6d5;margin-bottom:9px;}.command>span:first-child{color:#a9c79c;}.terminal-output{color:#a3b4a5;white-space:pre-line;min-height:45px;}.run-command{display:block;margin:0 11px 11px auto;background:#3e4b40;border:1px solid #526453;border-radius:5px;padding:4px 8px;color:#c9d9c5;font:8px var(--font-mono);}.run-command:hover{background:#50634f;}
.note-folder{position:relative;width:202px;height:155px;perspective:700px;}.note-folder summary{position:absolute;inset:0;list-style:none;cursor:pointer;}.note-folder summary::-webkit-details-marker{display:none;}.folder-back{position:absolute;inset:10px 0 0;border-radius:9px;background:#aab898;box-shadow:0 14px 20px #2636261c;}.folder-back::before{content:"";position:absolute;top:-10px;left:0;width:79px;height:20px;border-radius:8px 12px 0 0;background:#aab898;}.paper{position:absolute;width:172px;height:120px;left:15px;top:13px;background:#fffdf5;border:1px solid #e6e7dc;border-radius:5px;transition:transform .4s;}.paper-one{transform:rotate(-5deg);}.paper-two{transform:rotate(3deg);background:repeating-linear-gradient(#fffdf5 0 15px,#dde3d4 16px,#fffdf5 17px);}.folder-front{position:absolute;left:0;right:0;bottom:0;height:114px;background:linear-gradient(160deg,#ccd5b9,#b6c5a2);border:1px solid #acbc9d;border-radius:6px 6px 10px 10px;transform-origin:bottom;transition:transform .4s;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;}.folder-symbol{font-size:31px;color:#7d916c;}.folder-label{font:9px var(--font-mono);color:#647b5b;}.note-folder:not([open]):hover .folder-front{transform:rotateX(-15deg);}.note-folder:not([open]):hover .paper-one{transform:translateY(-8px) rotate(-7deg);}.folder-contents{position:absolute;inset:-20px -10px;background:#fffdf7;border:1px solid #e2e5d8;border-radius:13px;box-shadow:0 15px 24px #202b2420;padding:13px;animation:folder-open .25s ease;}.folder-contents header{display:flex;align-items:center;justify-content:space-between;font:9px var(--font-mono);color:var(--f-mute);margin-bottom:8px;}.close-folder{border:0;background:none;color:var(--f-low);font-size:19px;line-height:1;}.folder-contents a{display:flex;align-items:center;gap:8px;padding:11px 0;border-top:1px solid #eceee4;text-decoration:none;color:var(--f-low);font-size:11px;line-height:1.5;}.folder-contents a>span:first-of-type{flex:1;}.folder-contents a:hover{color:var(--f-high);}.folder-contents svg{flex:none;}
.dial-stage{--hue:140;--turn:140deg;}.dial-device{width:164px;padding:14px 16px 12px;border-radius:19px;background:linear-gradient(145deg,#fdfcf8,#e8e7df);box-shadow:0 2px 1px #fff inset,0 0 0 1px #deded4,0 17px 23px #2b36231a;text-align:center;}.dial-display{display:flex;align-items:center;gap:5px;font:8px var(--font-mono);color:#7c8778;}.tiny-led{width:5px;height:5px;border-radius:50%;background:hsl(var(--hue) 30% 55%);box-shadow:0 0 6px hsl(var(--hue) 40% 70%);}.dial-value{margin-left:auto;}.dial-well{width:89px;height:89px;border-radius:50%;margin:15px auto 10px;background:#d9dbd1;box-shadow:inset 0 2px 5px #0002;padding:5px;}.dial-knob{width:100%;height:100%;position:relative;border-radius:50%;background:conic-gradient(from 45deg,#f9f9f4,#dadcd2,#fafaf5,#d6d9ce,#f9f9f4);box-shadow:0 4px 5px #0002,0 1px 1px #fff inset;transform:rotate(var(--turn));}.knob-marker{position:absolute;width:3px;height:12px;top:8px;left:calc(50% - 1.5px);background:hsl(var(--hue) 22% 47%);border-radius:3px;}.knob-center{position:absolute;inset:20px;border-radius:50%;border:1px solid #e1e3d8;}.dial-control input{width:100%;height:3px;accent-color:hsl(var(--hue) 25% 47%);cursor:ew-resize;}.dial-caption{display:block;font:7px var(--font-mono);color:#99a18f;margin-top:7px;}
.shelf-controls{display:flex;gap:6px;margin-top:16px;}.shelf-controls button{display:grid;place-items:center;width:29px;height:29px;border:0;border-radius:9px;background:#eeeee7;color:var(--f-low);font-size:14px;}.shelf-controls button:disabled{opacity:.3;cursor:default;}.shelf-controls button:not(:disabled):hover{background:#e3e7dc;}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);}
@keyframes folder-open{from{opacity:0;transform:translateY(5px);}to{opacity:1;transform:translateY(0);}}
@media(max-width:560px){.shelf{grid-auto-columns:min(260px,78vw);}.stage{height:245px;}.playground{margin-top:2.8rem;}}
@media(prefers-reduced-motion:reduce){.terminal,.paper,.folder-front{transition:none;}.folder-contents{animation:none;}}
</style>
<script>
const demos=[{command:'whoami',output:'nabeen\nsecurity research & interfaces'},{command:'pwd',output:'/earth/baltimore\noriginally from Nepal'},{command:'cat interests.txt',output:'linux · security · nix\nbuilding things, breaking things'}];
let demo=0;let typing:ReturnType<typeof setInterval>|undefined;
const run=document.querySelector<HTMLButtonElement>('.run-command');
run?.addEventListener('click',()=>{demo=(demo+1)%demos.length;const command=document.querySelector('[data-command]');const output=document.querySelector('[data-terminal-output]');if(!command||!output)return;command.textContent=demos[demo].command;if(typing)clearInterval(typing);const result=demos[demo].output;if(matchMedia('(prefers-reduced-motion: reduce)').matches){output.textContent=result;return;}let i=0;output.textContent='';output.setAttribute('aria-busy','true');typing=setInterval(()=>{output.textContent=result.slice(0,++i);if(i>=result.length){clearInterval(typing);output.removeAttribute('aria-busy');}},20);});
document.querySelector('.close-folder')?.addEventListener('click',()=>{document.querySelector<HTMLDetailsElement>('.note-folder')?.removeAttribute('open');document.querySelector<HTMLElement>('.note-folder summary')?.focus();});
const slider=document.querySelector<HTMLInputElement>('.dial-control input');slider?.addEventListener('input',()=>{const toy=document.querySelector<HTMLElement>('[data-color-toy]');if(!toy)return;const hue=Number(slider.value);toy.style.setProperty('--hue',String(hue));toy.style.setProperty('--turn',`${hue}deg`);const value=document.querySelector('[data-dial-value]');const name=document.querySelector('[data-color-label]');if(value)value.textContent=`${hue}°`;if(name)name.textContent=hue<35?'clay':hue<75?'ochre':hue<165?'sage':hue<205?'teal':hue<265?'blue':hue<320?'lilac':'rose';});
const shelf=document.getElementById('playground-shelf');const controls=document.querySelectorAll<HTMLButtonElement>('[data-shelf-step]');const update=()=>{if(!shelf)return;controls.forEach(b=>b.disabled=Number(b.dataset.shelfStep)<0?shelf.scrollLeft<=2:shelf.scrollLeft>=shelf.scrollWidth-shelf.clientWidth-2);};controls.forEach(button=>button.addEventListener('click',()=>{if(!shelf)return;const width=(shelf.querySelector('article')?.getBoundingClientRect().width??260)+16;shelf.scrollBy({left:Number(button.dataset.shelfStep)*width,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}));shelf?.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);update();
</script>
