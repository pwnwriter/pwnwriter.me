<div class="flags" role="img" aria-label="Twelve small paper prayer flags, a reminder of Bouddha">
  {[0, 1].map(() => <img src="/images/prayer-flags-paper.webp" alt="" width="1600" height="533" loading="lazy" decoding="async" />)}
</div>
<style>
.flags{display:flex;align-items:flex-start;gap:0;width:100%;margin:2rem auto .5rem;}
.flags img{display:block;width:50%;min-width:0;height:auto;transform-origin:50% 9%;animation:paper-breeze 7s ease-in-out infinite;will-change:transform;--gust:0;transition:--gust .6s ease;}
.flags img:nth-child(2){animation-duration:8.5s;animation-delay:-3s;}
@property --gust {syntax:"<number>";inherits:false;initial-value:0;}
@media(hover:hover){.flags img:hover{--gust:1;}}
@keyframes paper-breeze{0%,100%{transform:perspective(700px) rotateX(calc(var(--gust) * -3deg)) skewX(calc(-.6deg - var(--gust) * 1.2deg)) translateY(0);}50%{transform:perspective(700px) rotateX(calc(5deg + var(--gust) * 8deg)) skewX(calc(.6deg + var(--gust) * 1.8deg)) translateY(calc(1px + var(--gust) * 2px));}}
@media(prefers-reduced-motion:reduce){.flags img{animation:none;will-change:auto;}}
</style>
