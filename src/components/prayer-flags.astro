---
// Lungta, the way they are strung over Boudhanath: one garland in the five
// colours, in order, each flag carrying a syllable of ॐ मणि पद्मे हूँ with a
// lotus border along its hem. Drawn on a canvas so the string can sag, the
// cloth can lift, and the run can string itself left to right when it shows.
// Seeded from the page path, so every page hangs its own, the same each visit.
---

<div class="flags" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .flags {
    height: 76px;
    /* melt into the page at both ends instead of stopping at a hard edge */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%);
  }

  .flags canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const H = 76;
  const HANG_MS = 1500;
  const TAU = Math.PI * 2;

  const FLAG_W = 32;
  const FLAG_H = 41;
  const PITCH = 35;

  // lungta, in order: sky, cloud, fire, water, earth. the real colours, with
  // the ink each one is block-printed in.
  const LIGHT = [
    { bg: "#2f6fb3", fg: "#f7f4ea" },
    { bg: "#f2eee2", fg: "#2f8f5b" },
    { bg: "#c93f2e", fg: "#e8b13a" },
    { bg: "#2f8f5b", fg: "#e8b13a" },
    { bg: "#e8b13a", fg: "#2f6fb3" },
  ];
  const DARK = [
    { bg: "#4e92d6", fg: "#f7f4ea" },
    { bg: "#e8e4d4", fg: "#2f8f5b" },
    { bg: "#df5b47", fg: "#f3c45c" },
    { bg: "#43ad72", fg: "#f3c45c" },
    { bg: "#f0bf55", fg: "#2f6fb3" },
  ];

  // the six syllables, and how they are said
  const MANTRA = [
    { gl: "ॐ", ro: "OM" },
    { gl: "म", ro: "MA" },
    { gl: "णि", ro: "NI" },
    { gl: "प", ro: "PAD" },
    { gl: "द्मे", ro: "ME" },
    { gl: "हूँ", ro: "HUM" },
  ];

  type Flag = { s: number; phase: number; colour: number; syl: number };

  const root = document.querySelector<HTMLElement>(".flags");
  const canvas = root?.querySelector("canvas");
  const ctx = canvas?.getContext("2d");

  if (root && canvas && ctx) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // a small deterministic rng, seeded from the path
    let seed = 2166136261;
    for (const ch of location.pathname) {
      seed ^= ch.charCodeAt(0);
      seed = Math.imul(seed, 16777619);
    }
    const rnd = () => {
      seed ^= seed << 13;
      seed ^= seed >>> 17;
      seed ^= seed << 5;
      return ((seed >>> 0) % 100000) / 100000;
    };

    let W = 0, dpr = 1;
    let ink = "#576869", paper = "#fbf9f4";
    let palette = LIGHT;
    let flags: Flag[] = [];

    const strand = { y: 0.1, sag: 0.09, tilt: -0.02, p: rnd() * TAU };

    const stringY = (s: number, t: number) =>
      strand.y * H +
      Math.sin(s * Math.PI) * strand.sag * H +
      Math.sin(s * 2.4 + strand.p + t * 0.4) * 2 +
      (s - 0.5) * strand.tilt * H;

    const readColors = () => {
      const cs = getComputedStyle(root);
      const v = (n: string, d: string) => cs.getPropertyValue(n).trim() || d;
      ink = v("--f-low", ink);
      paper = v("--background", paper);
      palette = window.matchMedia("(prefers-color-scheme: dark)").matches ? DARK : LIGHT;
    };

    const layout = () => {
      const w = Math.round(root.clientWidth);
      if (!w) return;
      W = w;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineJoin = "round";
      ctx.lineCap = "round";

      flags = [];
      const n = Math.max(6, Math.ceil(W / PITCH) + 1);
      for (let i = 0; i < n; i++) {
        flags.push({
          s: (i * PITCH) / W,
          phase: rnd() * TAU,
          colour: i % 5,
          syl: i % 6,
        });
      }
    };

    // one flag: cloth pinned along the string, lifting at the free edge, with
    // its syllable block-printed on it and a lotus hem along the bottom
    const drawFlag = (f: Flag, t: number, grown: number) => {
      const s0 = f.s;
      const s1 = f.s + FLAG_W / W;
      const x0 = s0 * W;
      const x1 = s1 * W;
      const y0 = stringY(s0, t);
      const y1 = stringY(s1, t);

      const lift = Math.sin(t * 1.9 + f.phase) * 2.6;
      const curl = Math.cos(t * 1.4 + f.phase * 1.3) * 1.8;
      const { bg, fg } = palette[f.colour];

      ctx.save();
      ctx.globalAlpha = grown;

      // the cloth
      ctx.beginPath();
      ctx.moveTo(x0, y0);
      ctx.lineTo(x1, y1);
      ctx.quadraticCurveTo(x1 + lift * 0.6, y1 + FLAG_H * 0.55, x1 + lift, y1 + FLAG_H + curl);
      ctx.quadraticCurveTo(
        (x0 + x1) / 2 + lift * 0.5,
        y0 + FLAG_H + curl * 1.4,
        x0 + lift * 0.45,
        y0 + FLAG_H,
      );
      ctx.closePath();
      ctx.fillStyle = bg;
      ctx.fill();

      // everything printed on it rides the cloth, so it is drawn in the
      // flag's own frame: along the string, and tilted with the lift
      ctx.save();
      ctx.clip();
      const cx = (x0 + x1) / 2 + lift * 0.35;
      const cy = (y0 + y1) / 2;
      const tilt = Math.atan2(y1 - y0, x1 - x0) + lift * 0.004;
      ctx.translate(cx, cy);
      ctx.rotate(tilt);
      ctx.fillStyle = fg;
      ctx.strokeStyle = fg;
      ctx.textAlign = "center";

      // the syllable
      ctx.textBaseline = "middle";
      ctx.font = `${Math.round(FLAG_H * 0.42)}px "Noto Sans Devanagari", "Kohinoor Devanagari", "Devanagari Sangam MN", serif`;
      ctx.fillText(MANTRA[f.syl].gl, 0, FLAG_H * 0.4);

      // how it is said, underneath
      ctx.font = `600 ${Math.round(FLAG_H * 0.15)}px ${getComputedStyle(root).fontFamily}`;
      ctx.globalAlpha = grown * 0.85;
      ctx.fillText(MANTRA[f.syl].ro, 0, FLAG_H * 0.66);
      ctx.globalAlpha = grown;

      // the lotus hem: a row of little arcs along the bottom edge
      const hemY = FLAG_H * 0.8;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(-FLAG_W / 2 + 2, hemY);
      ctx.lineTo(FLAG_W / 2 - 2, hemY);
      ctx.stroke();
      const petals = 5;
      const pw = (FLAG_W - 6) / petals;
      for (let k = 0; k < petals; k++) {
        const px = -FLAG_W / 2 + 3 + pw * (k + 0.5);
        ctx.beginPath();
        ctx.arc(px, hemY, pw * 0.44, 0, Math.PI);
        ctx.stroke();
      }
      ctx.restore();

      // the edge, so the cloth reads against the paper
      ctx.globalAlpha = grown * 0.35;
      ctx.strokeStyle = "#2b1d12";
      ctx.lineWidth = 0.8;
      ctx.stroke();
      ctx.restore();
    };

    const render = (t: number, grow: number) => {
      ctx.clearRect(0, 0, W, H);

      // the string first, so the flags hang off it
      ctx.globalAlpha = 0.5;
      ctx.strokeStyle = ink;
      ctx.lineWidth = 0.9;
      ctx.beginPath();
      for (let i = 0; i <= 60; i++) {
        const s = i / 60;
        if (s > grow) break;
        const x = s * W;
        const y = stringY(s, t);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      for (const f of flags) {
        const g = Math.min(1, Math.max(0, (grow - f.s) * 6));
        if (g > 0) drawFlag(f, t, g);
      }

    };

    const start = () => {
      readColors();
      layout();

      if (reduce) {
        render(0, 1);
        return;
      }

      let t0 = 0;
      let visible = false;
      new IntersectionObserver((e) => (visible = e[0].isIntersecting), { threshold: 0 }).observe(root);

      const loop = (now: number) => {
        if (!t0) t0 = now;
        const ms = now - t0;
        if (visible) render(ms / 1000, Math.min(1, ms / HANG_MS));
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    };

    new ResizeObserver(() => layout()).observe(root);
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", readColors);
    start();
  }
</script>
