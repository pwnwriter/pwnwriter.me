<span class="accent-editor">
  <button class="accent-phrase" type="button" aria-expanded="true" aria-controls="accent-tools" aria-label="Style tinkerer at heart">tinkerer at heart</button>
  <span class="accent-tools" id="accent-tools" role="group" aria-label="Text style">
    <label class="font-picker"><span class="sr-only">Accent font</span><select aria-label="Accent font"><option value="Caveat">Caveat</option><option value="Hanken">Sans</option><option value="Georgia">Serif</option></select></label>
    <span class="tool-divider" aria-hidden="true"></span>
    <button type="button" class="weight-tool" aria-label="Bold accent" aria-pressed="true"><b>B</b></button>
    <button type="button" class="italic-tool" aria-label="Italic accent" aria-pressed="false"><i>I</i></button>
    <span class="tool-divider" aria-hidden="true"></span>
    <span class="palette"><button class="palette-trigger" type="button" aria-label="Accent color" aria-expanded="false"><span class="current-color" aria-hidden="true"></span><span aria-hidden="true">⌄</span></button><span class="color-options" role="group" aria-label="Choose accent color" hidden><span class="palette-label">Style</span><span class="swatches"><button type="button" data-color="ink" aria-label="Ink" aria-pressed="false"></button><button type="button" data-color="blue" aria-label="Soft blue" aria-pressed="true"></button><button type="button" data-color="red" aria-label="Red" aria-pressed="false"></button><button type="button" data-color="gradient" aria-label="Gradient" aria-pressed="false"></button></span></span></span>
  </span>
</span>
<script>
const editor=document.querySelector<HTMLElement>('.accent-editor');
if(editor){
  const phrase=editor.querySelector<HTMLButtonElement>('.accent-phrase')!;
  const toolbar=editor.querySelector<HTMLElement>('.accent-tools')!;
  const palette=editor.querySelector<HTMLElement>('.color-options')!;
  const paletteTrigger=editor.querySelector<HTMLButtonElement>('.palette-trigger')!;
  const setOpen=(open:boolean)=>{toolbar.hidden=!open;phrase.setAttribute('aria-expanded',String(open));if(!open){palette.hidden=true;paletteTrigger.setAttribute('aria-expanded','false');}};
  phrase.addEventListener('click',()=>setOpen(toolbar.hidden));
  editor.querySelector('select')!.addEventListener('change',event=>{phrase.style.fontFamily=(event.target as HTMLSelectElement).value;});
  editor.querySelector<HTMLButtonElement>('.weight-tool')!.addEventListener('click',event=>{const button=event.currentTarget as HTMLButtonElement;const active=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(active));phrase.style.fontWeight=active?'700':'400';});
  editor.querySelector<HTMLButtonElement>('.italic-tool')!.addEventListener('click',event=>{const button=event.currentTarget as HTMLButtonElement;const active=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(active));phrase.style.fontStyle=active?'italic':'normal';});
  paletteTrigger.addEventListener('click',()=>{palette.hidden=!palette.hidden;paletteTrigger.setAttribute('aria-expanded',String(!palette.hidden));});
  editor.querySelectorAll<HTMLButtonElement>('[data-color]').forEach(button=>button.addEventListener('click',()=>{const color=button.dataset.color!;editor.dataset.color=color;editor.querySelectorAll('[data-color]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));palette.hidden=true;paletteTrigger.setAttribute('aria-expanded','false');}));
  editor.addEventListener('keydown',event=>{if(event.key==='Escape'){event.stopPropagation();setOpen(false);phrase.focus();}if(event.key==='ArrowDown'&&event.target===phrase){event.preventDefault();setOpen(true);editor.querySelector('select')!.focus();}});
}
</script>
<style>
.accent-editor{position:relative;display:inline-block;white-space:nowrap;--accent-color:#627d91;}
.accent-phrase{font-family:Caveat,cursive;font-size:1.16em;font-weight:700;color:var(--accent-color);background:none;border:0;border-radius:3px;padding:0 .12em;line-height:1.2;transform:rotate(-2deg);cursor:pointer;}
.accent-phrase:hover,.accent-phrase[aria-expanded="true"]{outline:1px solid #90a4bd;outline-offset:3px;background:#e8edf340;}
.accent-phrase[aria-expanded="true"]::before,.accent-phrase[aria-expanded="true"]::after{content:'';position:absolute;width:5px;height:5px;border:1px solid #90a4bd;background:var(--surface);top:-6px;}.accent-phrase::before{left:-6px;}.accent-phrase::after{right:-6px;}
.accent-tools{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:4px;padding:4px 6px;border:1px solid #dedfe5;border-radius:10px;background:#fbfbfc;box-shadow:0 2px 3px #00000012,0 10px 30px #20243908;z-index:10;font:11px/1.3 var(--font-sans);letter-spacing:0;color:#45464e;}
.accent-tools select{max-width:70px;border:0;background:transparent;color:inherit;font-size:11px;padding:2px;cursor:pointer;}
.accent-tools button{border:0;background:transparent;padding:0;border-radius:6px;display:grid;place-items:center;width:22px;height:22px;}
.accent-tools button:hover{background:#ededf0;}.accent-tools button[aria-pressed="true"]{background:#eeeef1;}
.weight-tool,.italic-tool{font-family:Georgia,serif;font-size:15px!important;}.tool-divider{height:17px;width:1px;background:#e1e1e7;}
.palette{position:relative;}.accent-tools .palette-trigger{display:flex;align-items:center;justify-content:center;width:31px;gap:4px;}.current-color{width:11px;height:11px;border-radius:50%;background:linear-gradient(135deg,#b9cfdf,var(--accent-color));box-shadow:inset 1px 1px 2px #fff9,0 1px 2px #4455;}
.color-options{position:absolute;top:calc(100% + 12px);right:-8px;background:#fbfbfc;border:1px solid #dedfe5;border-radius:13px;box-shadow:0 12px 30px #20243912;padding:10px 12px;}.palette-label{display:block;color:#96979f;font-size:11px;margin-bottom:8px;}.swatches{display:flex;gap:12px;}.accent-tools .swatches button{width:22px;height:22px;border-radius:50%;border:1px solid #0001;}.swatches button[data-color="ink"]{background:#26272c;}.swatches button[data-color="blue"]{background:linear-gradient(135deg,#b9cfdf,#627d91);}.swatches button[data-color="red"]{background:#c5293d;}.swatches button[data-color="gradient"]{background:linear-gradient(135deg,#4e35ef,#36a8cb,#7bdfa6);}.swatches button[aria-pressed="true"]{outline:1px solid #9da0b0;outline-offset:3px;}
.accent-editor[data-color="ink"]{--accent-color:#26272c;}.accent-editor[data-color="red"]{--accent-color:#c5293d;}.accent-editor[data-color="gradient"] .accent-phrase{background:linear-gradient(100deg,#4e35ef,#3688aa,#558a6c);background-clip:text;color:transparent;}.accent-editor[data-color="gradient"] .current-color{background:linear-gradient(135deg,#4e35ef,#36a8cb,#7bdfa6);}
@media(max-width:430px){.accent-tools{left:auto;right:-5px;transform:none;}.accent-tools select{max-width:75px;}}
</style>

<style is:global>
.hero-copy .intro:has(.accent-phrase[aria-expanded="true"]){padding-bottom:44px;}
.hero-copy .intro:has(.color-options:not([hidden])){padding-bottom:120px;}
</style>
