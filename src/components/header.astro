---
import Wrapper from '~/components/wrapper.astro';

const { title } = Astro.props;
let path = Astro.url.pathname;
if (path.charAt(path.length - 1) == '/') {
	path = path.slice(0, -1);
}
let subpaths = path.split('/').slice(0, -1);
let isHome = path == '';

let subpathList = subpaths.reduce(
	(acc, subpath, i) => [
		...acc,
		{
			text: subpath == '' ? '~' : subpath,
			link: subpaths.slice(0, i + 1).join('/') || '/',
		},
	],
	[] as { text: string; link: string }[],
);

const nav = [
	{ text: 'notes', href: '/notes' },
	{ text: 'projects', href: '/projects' },
	{ text: 'stuff', href: '/stuff' },
];
---

<header class="site-header sticky top-0 z-20">
	<Wrapper>
		<nav class="site-nav" aria-label="site">
			<ul id="breadcrumbs" class="crumbs">
				{
					!isHome &&
						subpathList.map((subpath) => (
							<>
								<li class="shrink-0">
									<a href={subpath.link}>{subpath.text}</a>
								</li>
								<span class="sep shrink-0" aria-hidden="true">›</span>
							</>
						))
				}
				<li class="crumb-title min-w-0 shrink">
					<a href="#" title={title} aria-current="page">{title}</a>
				</li>
			</ul>

			<ul class="links">
				{
					nav.map(({ text, href }) => (
						<li>
							<a
								href={href}
								aria-current={path.startsWith(href) ? 'true' : undefined}
							>
								{text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</Wrapper>
</header>

<style>
	.site-header {
		background: var(--background);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 3.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	.crumbs,
	.links {
		display: flex;
		align-items: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.crumbs {
		flex: 1;
		min-width: 0;
		gap: 0.5rem;
		color: var(--f-mute);
		text-transform: lowercase;
	}

	.links {
		flex: none;
		gap: 1.4rem;
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.site-nav a {
		color: var(--f-mute);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.site-nav a:hover,
	.site-nav a[aria-current] {
		color: var(--f-high);
	}

	.sep {
		color: color-mix(in srgb, var(--f-low) 35%, transparent);
	}

	/* the current-page crumb can be a long post title. it's the flex child that
	   shrinks, so it ellipsizes to give the section chip room. */
	.crumb-title a {
		display: block;
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>

<style is:global>
	/* global because the section chip is created at runtime, outside astro's
	   style scoping. once you're inside an article the trail (~ › notes › title
	   › section) takes the whole row and the nav steps aside. */
	.site-nav:has(.has-active-section) .links {
		display: none;
	}

	/* small screens: the trail collapses to the home crumb so the nav fits */
	@media (max-width: 600px) {
		.site-nav .links {
			gap: 1rem;
		}

		#breadcrumbs > .sep,
		#breadcrumbs > li:not(:first-child):not(.crumb-section) {
			display: none;
		}
	}
</style>
