---
const path = Astro.url.pathname;
const items = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Notes', href: '/notes' },
  { label: 'Now', href: '/now' },
];
---
<header class="site-header shell">
  <nav aria-label="Main navigation">
    {items.map(item => <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href) || (item.href === '/now' && path.startsWith('/syndications'))) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</header>
