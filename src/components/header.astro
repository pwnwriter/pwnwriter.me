---
import Link from '~/components/link.astro';
import Wrapper from '~/components/wrapper.astro';

const { title } = Astro.props;
let path = Astro.url.pathname;
if (path.charAt(path.length - 1) == '/') {
	path = path.slice(0, -1);
}
let subpaths = path.split('/').slice(0, -1);
let isHome = path == '/';

let subpathList = subpaths.reduce(
	(acc, subpath, i) => [
		...acc,
		{
			text: subpath == '' ? '~' : subpath,
			link: subpaths.slice(0, i + 1).join('/') || '/',
		},
	],
	[] as { text: string; link: string }[],
);
---

<header class="site-header sticky top-0 z-20 mt-8 py-2">
	<nav class="relative">
		<div
			class="absolute -top-4 left-0 h-14 w-8 bg-gradient-to-r from-background"
		>
		</div>
		<div
			class="absolute -top-4 right-0 h-14 w-8 bg-gradient-to-l from-background"
		>
		</div>
		<div class="overflow-x-auto py-2">
			<Wrapper>
				<ul
					id="breadcrumbs"
					class="flex min-w-0 items-center gap-2"
				>
					{
						!isHome &&
							subpathList.map((subpath) => (
								<>
									<li class="shrink-0">
										<Link href={subpath.link} scheme="f-low">
											{subpath.text}
										</Link>
									</li>
									<span class="shrink-0">›</span>
								</>
							))
					}
					<li class="crumb-title min-w-0 shrink">
						<Link href="#" title={title}>
							{title}
						</Link>
					</li>
				</ul>
			</Wrapper>
		</div>
	</nav>
</header>

<style>
	/* frosted glass: content ghosts through the sticky header as you scroll,
	   pairing with the viewport edge blur. */
	.site-header {
		background: color-mix(in srgb, var(--background) 66%, transparent);
		backdrop-filter: blur(12px) saturate(1.35);
		-webkit-backdrop-filter: blur(12px) saturate(1.35);
		border-bottom: 1px solid color-mix(in srgb, var(--f-low) 7%, transparent);
	}

	/* the crumb-overflow fades should melt from the glass, not a solid slab */
	.site-header nav > div:first-of-type,
	.site-header nav > div:nth-of-type(2) {
		background-image: none;
	}

	@supports not (backdrop-filter: blur(1px)) {
		.site-header {
			background: var(--background);
		}
	}

	/* the current-page crumb can be a long post title. it's the flex child that
	   shrinks, so it ellipsizes to give the section chip room — no overlap, full
	   title on hover. */
	.site-header :global(#breadcrumbs .crumb-title) {
		min-width: 0;
	}

	.site-header :global(#breadcrumbs .crumb-title a) {
		display: block;
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
