<span class="name-note"><button type="button" class="name-trigger" aria-expanded="false" aria-controls="name-card">Nabeen</button></span>
<template id="name-card-template"><div class="name-card" id="name-card" popover="manual" role="dialog" aria-label="The names I go by">
  <header><button class="name-close" type="button" aria-label="Close name card">×</button></header>
  <div class="name-origin"><span class="devanagari" lang="ne">नवीन</span><div><span class="origin-label">Nepali · Sanskrit roots</span><p>new, fresh, young</p></div></div>
  <dl><div><dt>Nabin</dt><dd>On paper</dd></div><div><dt>Nabeen</dt><dd>What I go by</dd></div><div><dt>pwnwriter</dt><dd>Code &amp; writing</dd></div></dl>

</div></template>
<script>
const template=document.querySelector<HTMLTemplateElement>('#name-card-template')!;
document.body.append(template.content);
const trigger=document.querySelector<HTMLButtonElement>('.name-trigger')!;
const card=document.querySelector<HTMLElement>('#name-card')!;
let pinned=false,closeTimer:ReturnType<typeof setTimeout>|undefined;
function position(){const rect=trigger.getBoundingClientRect();const width=Math.min(250,innerWidth-32);card.style.width=`${width}px`;card.style.left=`${Math.max(16,Math.min(rect.left-14,innerWidth-width-16))}px`;const height=card.offsetHeight;card.style.top=`${rect.bottom+12+height>innerHeight-16?Math.max(16,rect.top-height-12):rect.bottom+12}px`;}
function open(){clearTimeout(closeTimer);if(!card.matches(':popover-open'))card.showPopover();position();trigger.setAttribute('aria-expanded','true');}
function close(){clearTimeout(closeTimer);pinned=false;if(card.matches(':popover-open'))card.hidePopover();trigger.setAttribute('aria-expanded','false');}
function later(){clearTimeout(closeTimer);closeTimer=setTimeout(()=>{if(!pinned&&!card.contains(document.activeElement)&&document.activeElement!==trigger)close();},160);}
trigger.addEventListener('pointerenter',event=>{if(event.pointerType!=='touch')open();});trigger.addEventListener('pointerleave',later);
trigger.addEventListener('focus',open);trigger.addEventListener('blur',later);
trigger.addEventListener('click',()=>{if(pinned){close();return;}pinned=true;open();});
card.addEventListener('pointerenter',()=>clearTimeout(closeTimer));card.addEventListener('pointerleave',later);card.addEventListener('focusout',later);
card.querySelector('button')!.addEventListener('click',()=>{close();trigger.focus();close();});
document.addEventListener('pointerdown',event=>{if(!card.contains(event.target as Node)&&event.target!==trigger)close();});
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&card.matches(':popover-open')){event.preventDefault();event.stopPropagation();close();trigger.focus();close();}if(event.key==='ArrowDown'&&event.target===trigger){event.preventDefault();pinned=true;open();card.querySelector<HTMLButtonElement>('button')!.focus();}});
window.addEventListener('resize',()=>{if(card.matches(':popover-open'))position();});window.addEventListener('scroll',()=>{if(card.matches(':popover-open'))position();},{passive:true});
</script>
<style>
.name-note{display:inline;}.name-trigger{border:0;border-bottom:1px dotted #b8bac3;border-radius:0;background:none;padding:0;color:inherit;font:inherit;line-height:1.2;cursor:pointer;}.name-trigger:hover,.name-trigger[aria-expanded="true"]{color:#566e84;border-color:#879bb0;}
.name-card{position:fixed;inset:auto;margin:0;padding:16px;border:1px solid #dcdee5;border-radius:14px;background:#fafafc;color:var(--f-high);box-shadow:0 2px 4px #25273804,0 12px 30px #25273813;overflow:visible;}.name-card:popover-open{animation:name-arrive .16s ease-out;}.name-card::backdrop{background:transparent;pointer-events:none;}.name-card header{height:0;margin:0;}.name-close{position:absolute;top:6px;right:6px;display:grid;place-items:center;border:0;background:none;color:#9a9ca8;font:17px/1 var(--font-sans);padding:0;width:22px;height:22px;cursor:pointer;}.name-close:hover{color:#566e84;}
.name-origin{display:flex;align-items:center;gap:12px;padding:2px 8px 13px 0;}.devanagari{font-family:'Kohinoor Devanagari','Devanagari Sangam MN',serif;font-size:28px;color:#6c7f90;line-height:1.2;}.origin-label{font:9px/1.5 var(--font-sans);color:#9498a5;}.name-origin p{font:12px/1.4 var(--font-sans);margin:3px 0 0;color:var(--f-low);}
.name-card dl{margin:0;padding-top:12px;border-top:1px solid #e6e7ed;display:grid;gap:7px;}.name-card dl>div{display:grid;grid-template-columns:65px 1fr;gap:9px;}.name-card dt{font:500 12px/1.5 var(--font-sans);color:var(--f-high);}.name-card dd{margin:0;font:12px/1.5 var(--font-sans);color:#858995;}@keyframes name-arrive{from{opacity:0;translate:0 -3px}to{opacity:1;translate:0 0}}@media(prefers-reduced-motion:reduce){.name-card:popover-open{animation:none}}
</style>
