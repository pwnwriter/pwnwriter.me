<div
	class="prose prose-custom max-w-none prose-figcaption:mt-3 prose-figcaption:text-xs"
>
	<slot />
</div>

<script>
	const icon = (d: string) =>
		`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
	const copyIcon = icon('<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>');
	const checkIcon = icon('<polyline points="20 6 9 17 4 12"/>');

	function addCopyButtons() {
		document.querySelectorAll<HTMLElement>('pre > code').forEach((code) => {
			const pre = code.parentElement!;
			if (pre.querySelector('.copy-btn')) return;

			const btn = Object.assign(document.createElement('button'), {
				className: 'copy-btn',
				ariaLabel: 'Copy code',
				innerHTML: copyIcon,
			});

			btn.addEventListener('click', () => {
				navigator.clipboard.writeText(code.textContent ?? '');
				btn.innerHTML = checkIcon;
				btn.classList.add('copied');
				setTimeout(() => { btn.innerHTML = copyIcon; btn.classList.remove('copied'); }, 1500);
			});

			pre.appendChild(btn);
		});
	}

	function escapeRegExp(value: string) {
		return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	}

	function getTerms(query: string) {
		return query
			.toLowerCase()
			.split(/\s+/)
			.map((term) => term.trim())
			.filter((term) => term.length > 1);
	}

	function clearSearchHighlights(root: ParentNode = document) {
		root.querySelectorAll('mark.search-hit').forEach((mark) => {
			mark.replaceWith(document.createTextNode(mark.textContent ?? ''));
		});
	}

	function highlightSearchTerms() {
		const query = new URLSearchParams(window.location.search).get('q') ?? '';
		const terms = getTerms(query);
		const scope = document.querySelector<HTMLElement>('.writing-note');
		if (!scope) return;

		clearSearchHighlights(scope);
		if (!terms.length) return;

		const pattern = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
		const walker = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT, {
			acceptNode(node) {
				const parent = node.parentElement;
				if (
					!parent ||
					parent.closest('mark, script, style, input, textarea, pre, code')
				) {
					return NodeFilter.FILTER_REJECT;
				}
				pattern.lastIndex = 0;
				return pattern.test(node.textContent ?? '')
					? NodeFilter.FILTER_ACCEPT
					: NodeFilter.FILTER_REJECT;
			},
		});

		const nodes: Text[] = [];
		while (walker.nextNode()) nodes.push(walker.currentNode as Text);

		nodes.forEach((node) => {
			const fragment = document.createDocumentFragment();
			const text = node.textContent ?? '';
			pattern.lastIndex = 0;
			let lastIndex = 0;

			for (const match of text.matchAll(pattern)) {
				const index = match.index ?? 0;
				if (index > lastIndex) {
					fragment.append(document.createTextNode(text.slice(lastIndex, index)));
				}

				const mark = document.createElement('mark');
				mark.className = 'search-hit';
				mark.textContent = match[0];
				fragment.append(mark);
				lastIndex = index + match[0].length;
			}

			if (lastIndex < text.length) {
				fragment.append(document.createTextNode(text.slice(lastIndex)));
			}

			node.replaceWith(fragment);
		});

		document.querySelector<HTMLElement>('mark.search-hit')?.scrollIntoView({
			block: 'center',
			behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
				? 'auto'
				: 'smooth',
		});
	}

	addCopyButtons();
	highlightSearchTerms();
	document.addEventListener('astro:after-swap', addCopyButtons);
	document.addEventListener('astro:after-swap', highlightSearchTerms);
</script>

<style>
	.prose :global(p),
	.prose :global(blockquote > p) {
		@apply font-normal leading-[1.62] text-f-low;
	}

	.prose :global(blockquote > p::before),
	.prose :global(blockquote > p::after),
	.prose :global(code::before),
	.prose :global(code::after) {
		@apply hidden;
	}

	.prose :global(pre) {
		@apply relative mb-4 bg-b-med font-mono;
	}

	.prose :global(code) {
		@apply font-mono;
	}

	.prose :global(pre > code) {
		@apply bg-transparent p-0 text-[0.82rem] leading-relaxed;
	}

	.prose :global(.copy-btn) {
		@apply absolute right-2 top-2 flex items-center justify-center rounded p-1.5 text-f-low opacity-0 transition-opacity duration-150;
		background: var(--b-med);
	}

	.prose :global(pre:hover .copy-btn),
	.prose :global(.copy-btn:focus-visible),
	.prose :global(.copy-btn.copied) {
		@apply opacity-100;
	}

	.prose :global(.copy-btn:hover),
	.prose :global(.copy-btn.copied) {
		@apply text-accent;
	}

	.prose :global(.search-hit),
	:global(.writing-note h1 .search-hit) {
		border-radius: 0.2em;
		background: color-mix(in srgb, var(--accent) 30%, transparent);
		color: var(--f-high);
		padding: 0 0.08em;
	}
</style>
