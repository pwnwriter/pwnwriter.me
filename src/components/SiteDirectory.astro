---
import { getCollection } from "astro:content";
import { recognition } from "~/data/recognition";
import { photos } from "~/data/photos";
import { projects } from "~/data/projects";
const entries = [
 {title:'Home',description:'A short introduction.',href:'/',color:'blue',icon:'M3 11 12 3l9 8M5 10v11h5v-7h4v7h5V10'},
 {title:'Work',description:'Projects, demos, and open source.',href:'/work',color:'yellow',icon:'M8 7V4h8v3M3 8h18v12H3zM3 12l9 3 9-3M10 14h4'},
 {title:'Notes',description:'Security, Linux, Rust, and Nix.',href:'/notes',color:'green',icon:'M5 3h14v18H5zM8 7h8M8 11h8M8 15h5'},
 {title:'Now',description:'Life lately, and the memories before it.',href:'/now',color:'pink',icon:'M12 7v5l4 2M4 5v5h5M4 10a8 8 0 1 1 0 5'},
 {title:'Photographs',description:'Places, people, and moments kept.',href:'/work#photos',color:'blue',icon:'M3 5h18v15H3zM3 16l6-6 5 5 3-3 4 4M15 8h.01'},
 {title:'Recognition',description:'CTF wins, hackathons, and appreciation.',href:'/work#recognition',color:'yellow',icon:'M8 3h8v7a4 4 0 0 1-8 0zM8 5H4v3a4 4 0 0 0 4 4M16 5h4v3a4 4 0 0 1-4 4M12 14v6M8 21h8'},
 {title:'whoami card',description:'My profile, links, and guestbook.',href:'https://whoami.cards/pwnwriter',color:'purple',icon:'M3 5h18v15H3zM7 9h3v3H7zM13 9h5M13 13h5M7 16h11'},
 {title:'Say hello',description:'Leave me a private note on whoami.',href:'https://whoami.cards/pwnwriter/connect?via=link',color:'pink',icon:'M3 5h18v14H3zM3 6l9 7 9-7'},
 {title:'GitHub',description:'Code, contributions, and experiments.',href:'https://github.com/pwnwriter',color:'green',icon:'m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16'},
 {title:'X',description:'Find me as @pwnwriter.',href:'https://x.com/pwnwriter',color:'blue',icon:'M4 3h5l11 18h-5zM20 3 4 21'},
 {title:'LinkedIn',description:'The professional side.',href:'https://www.linkedin.com/in/pwnwriter',color:'purple',icon:'M5 9v12M5 4v.1M10 21V9h4v3c1-4 6-3 6 1v8'},
 {title:'Email',description:'hi@pwnwriter.me',href:'mailto:hi@pwnwriter.me',color:'yellow',icon:'M3 5h18v14H3zM3 6l9 7 9-7'},
 {title:'Tags',description:'Browse notes by topic.',href:'/notes/tags',color:'green',icon:'M3 3h8l10 10-8 8L3 11zM7 7h.01'},
 {title:'RSS',description:'Follow new writing in your reader.',href:'/rss.xml',color:'yellow',icon:'M4 4a16 16 0 0 1 16 16M4 11a9 9 0 0 1 9 9M4 19h.01'},
 {title:'Public key',description:'My OpenPGP key.',href:'https://github.com/pwnwriter.gpg',color:'blue',icon:'M14 10a5 5 0 1 0-2 2l8 8 2-2-2-2 2-2-2-2-2 2z'},
 {title:'Source',description:'The code behind this little website.',href:'https://github.com/pwnwriter/pwnwriter.me',color:'purple',icon:'m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16'},
 {title:'Site stats',description:'A quiet look at the visitors.',href:'https://cloud.umami.is/share/tNl4j2DN3BMN3xwq/pwnwriter.me',color:'green',icon:'M5 21V12M12 21V3M19 21V8'},
 ];
const posts=(await getCollection('posts')).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());
const memories=(await getCollection('syndications')).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());

const excerpt=(text:string)=>text.replace(/```[\s\S]*?```/g,' ').replace(/!?\[([^\]]*)\]\([^)]+\)/g,'$1').replace(/<[^>]*>|[#*_>`]/g,'').replace(/\s+/g,' ').trim().slice(0,150);
const groups=[
 {key:'work',title:'Work',description:'Things I build, ship, and learn from.',href:'/work',icon:entries[1].icon,items:projects.map(p=>({title:p.name,description:p.summary,href:`/work#${p.slug}`,image:p.cover?.kind==='image'?p.cover.src:p.cover?.kind==='video'?p.cover.poster:undefined}))},
 {key:'writing',title:'Writing',description:'Field notes on security, systems, and software.',href:'/notes',icon:entries[2].icon,items:posts.map(p=>({title:p.data.title,description:p.data.description??excerpt(p.body),href:`/notes/${p.slug}`,date:p.data.pubDate.toLocaleDateString('en-US',{month:'short',year:'numeric'}),keywords:p.data.tags.join(' ')}))},
 {key:'now',title:'Now',description:'Life lately, with a few memories kept.',href:'/now',icon:entries[3].icon,items:memories.map(p=>({title:p.data.title,description:excerpt(p.body),href:`/syndications/${p.slug}`,date:p.data.pubDate.toLocaleDateString('en-US',{month:'short',year:'numeric'})}))},
 {key:'photos',title:'Photographs',description:'Places, people, and moments.',href:'/work#photos',icon:entries[4].icon,items:photos.map(p=>({title:p.alt,description:p.year,href:'/work#photos',image:p.src}))},
 {key:'recognition',title:'Recognition',description:'A few things I am proud of.',href:'/work#recognition',icon:entries[5].icon,items:recognition.map(p=>({title:p.title,description:p.result,href:'/work#recognition',image:(p.photo??p.image)?.src}))},
 {key:'links',title:'Elsewhere',description:'Socials, whoami, and site links.',href:'https://whoami.cards/pwnwriter',icon:entries[6].icon,items:entries.slice(6).map(p=>({title:p.title,description:p.description,href:p.href}))},
];
---
<button class="directory-trigger" type="button" aria-haspopup="dialog"><svg class="jump-ghost" width="19" height="21" viewBox="0 0 24 26" fill="none" aria-hidden="true"><path d="M4 22V11a8 8 0 0 1 16 0v11l-3-2-2.5 2-2.5-2-2.5 2L7 20z" fill="#f9f9fc" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><ellipse cx="9" cy="12" rx="1.1" ry="1.5" fill="currentColor"/><ellipse cx="15" cy="12" rx="1.1" ry="1.5" fill="currentColor"/><path d="M10.5 16q1.5 1.5 3 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg><span>Jump to…</span><kbd>/</kbd></button>
<dialog class="directory-dialog" aria-labelledby="directory-title">
  <header class="directory-heading"><div class="preview-heading"><h2 id="directory-title">Jump somewhere</h2><p class="preview-subtitle">A few corners of this site.</p></div><button type="button" class="directory-close" aria-label="Close directory">×</button></header>
  <nav class="directory-results" id="directory-results" aria-label="Explore the site"></nav>
  <footer class="directory-search"><span class="search-slash" aria-hidden="true">/</span><input type="search" aria-label="Search the directory" placeholder="Try work, writing, or a topic…" aria-controls="directory-results" autocomplete="off" spellcheck="false"/><button type="button" class="directory-escape" aria-label="Close directory">esc</button></footer>
</dialog>
<script id="directory-preview-data" type="application/json" set:html={JSON.stringify(groups).replaceAll('<','\\u003c')} is:inline />
<script>
interface Entry {title:string;description:string;href:string;image?:string;date?:string;keywords?:string;}
interface Group {key:string;title:string;description:string;href:string;icon:string;items:Entry[];}
const groups:Group[]=JSON.parse(document.querySelector('#directory-preview-data')!.textContent!);
const dialog=document.querySelector<HTMLDialogElement>('.directory-dialog')!;
const trigger=document.querySelector<HTMLButtonElement>('.directory-trigger')!;
const input=dialog.querySelector<HTMLInputElement>('input')!;
const results=dialog.querySelector<HTMLElement>('.directory-results')!;
const heading=dialog.querySelector('#directory-title')!;
const subtitle=dialog.querySelector('.preview-subtitle')!;
let selected=0,visible:HTMLElement[]=[],previousFocus:HTMLElement|null=null,oldOverflow='';
function element<K extends keyof HTMLElementTagNameMap>(tag:K,className:string,text?:string){const node=document.createElement(tag);node.className=className;if(text)node.textContent=text;return node;}
function icon(path:string){const box=element('span','folder-icon');const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('viewBox','0 0 24 24');svg.setAttribute('fill','none');svg.setAttribute('stroke','currentColor');svg.setAttribute('stroke-width','1.5');svg.setAttribute('aria-hidden','true');const line=document.createElementNS('http://www.w3.org/2000/svg','path');line.setAttribute('d',path);svg.append(line);box.append(svg);return box;}
function highlight(){visible.forEach((item,i)=>item.classList.toggle('is-selected',i===selected));visible[selected]?.scrollIntoView({block:'nearest'});}
function link(entry:Entry,group?:Group){const a=element('a','directory-item preview-item');a.href=entry.href;if(entry.image){const thumb=element('span','preview-thumb');const img=document.createElement('img');img.src=entry.image;img.alt='';img.loading='lazy';thumb.append(img);a.append(thumb);}else if(group&&['work','links'].includes(group.key)){a.append(icon(group.icon));}const copy=element('span','directory-copy');const title=element('span','preview-title-line');title.append(element('span','directory-name',entry.title));if(entry.date)title.append(element('span','preview-date',entry.date));copy.append(title,element('span','directory-description',entry.description));a.append(copy);a.addEventListener('click',close);return a;}
function render(){
 const query=input.value.toLowerCase().trim();const aliases:Record<string,string>={notes:'writing',note:'writing',blog:'writing',projects:'work',project:'work',photographs:'photos',photo:'photos',links:'links',elsewhere:'links',memories:'now'};
 const group=groups.find(g=>g.key===(aliases[query]??query));results.replaceChildren();results.className='directory-results';selected=0;
 if(!query){heading.textContent='Jump somewhere';subtitle.textContent='A few corners of this site.';groups.forEach(g=>{const button=element('button','directory-item category-item');button.type='button';button.append(icon(g.icon));const copy=element('span','directory-copy');copy.append(element('span','directory-name',g.title),element('span','directory-description',g.description));button.append(copy,element('span','category-chevron','›'));button.addEventListener('click',()=>{input.value=g.key;render();input.focus();});results.append(button);});}
 else if(group){heading.textContent=group.title;subtitle.textContent=group.description;results.classList.add('is-preview',`preview-${group.key}`);const count=group.key==='work'||group.key==='photos'?6:4;group.items.slice(0,count).forEach(entry=>results.append(link(entry,group)));const more=element('a','preview-more',`All ${group.title.toLowerCase()} →`);more.href=group.href;more.addEventListener('click',close);results.append(more);}
 else{heading.textContent='Search';const words=query.split(/\s+/);const matches=[{title:'Home',description:'About Nabeen, security research and interfaces.',href:'/',keywords:'home about introduction'},...groups.flatMap(g=>g.items)].filter(entry=>words.every(word=>`${entry.title} ${entry.description} ${entry.keywords??''}`.toLowerCase().includes(word))).filter((entry,i,array)=>array.findIndex(other=>other.href===entry.href)===i);subtitle.textContent=matches.length?`${Math.min(matches.length,6)} results`:'Nothing found';matches.slice(0,6).forEach(entry=>results.append(link(entry)));if(!matches.length)results.append(element('p','directory-empty','Try work, writing, photos, or another topic.'));}
 visible=[...results.querySelectorAll<HTMLElement>('a,button')];highlight();
}
function open(){if(dialog.open)return;previousFocus=document.activeElement as HTMLElement;oldOverflow=document.body.style.overflow;document.body.style.overflow='hidden';input.value='';dialog.showModal();render();input.focus();}
function close(){if(dialog.open)dialog.close();}
trigger.addEventListener('click',open);dialog.querySelectorAll('.directory-close,.directory-escape').forEach(button=>button.addEventListener('click',close));
dialog.addEventListener('close',()=>{document.body.style.overflow=oldOverflow;previousFocus?.focus({preventScroll:true});});dialog.addEventListener('cancel',event=>{event.preventDefault();close();});
dialog.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();event.stopPropagation();close();}},true);
dialog.addEventListener('click',event=>{if(event.target===dialog){const rect=dialog.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)close();}});
input.addEventListener('input',render);input.addEventListener('keydown',event=>{if(['ArrowDown','ArrowUp'].includes(event.key)){event.preventDefault();if(visible.length){selected=(selected+(event.key==='ArrowDown'?1:-1)+visible.length)%visible.length;highlight();}}if(event.key==='Enter'&&visible[selected]){event.preventDefault();visible[selected].click();}});
document.addEventListener('keydown',event=>{const typing=event.composedPath().some(node=>node instanceof HTMLElement&&(node.isContentEditable||['INPUT','TEXTAREA','SELECT'].includes(node.tagName)));if(event.key!=='/'||event.metaKey||event.ctrlKey||event.altKey||event.isComposing||event.defaultPrevented||typing)return;if(document.querySelector('dialog[open]')&&!dialog.open)return;event.preventDefault();open();});
</script>
<style is:global>
.directory-trigger{display:flex;align-items:center;gap:9px;border:0;background:transparent;padding:5px 0;font:10px var(--font-mono);color:var(--f-low);}.directory-trigger:hover{color:var(--f-high);}.directory-trigger svg{width:14px;height:14px;}.directory-trigger kbd{font:10px var(--font-mono);border:1px solid var(--line);border-radius:3px;padding:2px 7px;margin-left:5px;color:var(--f-mute);}
.directory-dialog{width:min(450px,calc(100vw - 32px));max-height:min(570px,calc(100dvh - 48px));padding:0;border:1px solid #c8cad4;border-radius:10px;background:var(--background);color:var(--f-high);box-shadow:0 18px 60px #24273520;overflow:hidden;}
.directory-dialog[open]{display:flex;flex-direction:column;animation:directory-in .3s cubic-bezier(.2,.8,.2,1);}.directory-dialog::backdrop{background:#e8e9efd9;backdrop-filter:blur(5px);}
.directory-heading{order:0;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px 18px 10px;flex:none;}.directory-heading h2{font:10px var(--font-mono);color:var(--f-mute);margin:0;letter-spacing:.02em;}.index-count{display:inline-block;margin-left:9px;color:#969aa9;font-size:9px;}.directory-close{border:0;background:none;font-size:18px;color:var(--f-mute);width:24px;height:24px;padding:0;}
.directory-search{order:3;display:flex;align-items:center;gap:10px;border-top:1px solid var(--line);margin:0;padding:15px 18px;flex:none;color:var(--f-mute);}.directory-search>svg{width:15px;height:15px;}.directory-search input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--f-high);font:14px var(--font-sans);}.directory-search input::placeholder{color:#9295a2;}.directory-search input::-webkit-search-cancel-button{display:none;}.directory-escape{border:1px solid var(--line);border-radius:3px;background:var(--surface);padding:4px 5px;color:var(--f-mute);font:8px var(--font-mono);}
.directory-results{order:2;overflow-y:auto;overscroll-behavior:contain;min-height:0;scrollbar-width:thin;padding:5px 9px 9px;}.directory-item{position:relative;display:flex;align-items:center;gap:12px;padding:11px 10px;text-decoration:none;border-radius:4px;min-height:57px;border-bottom:1px solid #d7d8df66;}.directory-item:last-of-type{border-bottom:0;}.directory-item:hover,.directory-item.is-selected{background:#e4e5ed;}.directory-item.is-selected::before{content:'';position:absolute;left:0;top:22px;bottom:22px;width:2px;background:#737b96;}.directory-copy{display:flex;flex-direction:column;gap:4px;min-width:0;}.directory-name{font:11px/1.4 var(--font-mono);font-weight:400;}.directory-description{font:12px/1.4 var(--font-sans);color:var(--f-mute);}.directory-external{margin-left:auto;color:#9297a7;font-size:12px;}
.folder-icon{width:28px;height:28px;flex:none;display:grid;place-items:center;border:1px solid #cdd0db;background:#eceef3;border-radius:5px;color:#788098;}.folder-icon svg{width:15px;height:15px;}
.directory-empty{font-size:13px;color:var(--f-mute);padding:28px 15px;text-align:center;}@keyframes directory-in{from{opacity:0;transform:translateY(18px) scale(.975)}to{opacity:1;transform:translateY(0) scale(1)}}@media(max-width:480px){.directory-dialog{max-height:calc(100dvh - 32px);}.directory-item{padding:11px 9px;}.directory-description{font-size:11px;}}

.directory-trigger{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:20;min-width:210px;padding:13px 16px;border:1px solid #c8cad4;border-radius:12px;background:color-mix(in srgb,var(--surface) 94%,transparent);backdrop-filter:blur(12px);box-shadow:0 3px 0 #dfe0e7,0 8px 24px #24273512;font-size:11px;transition:box-shadow .2s,translate .2s;}
.directory-trigger kbd{margin-left:auto;}.directory-trigger:hover{translate:0 -2px;box-shadow:0 4px 0 #dfe0e7,0 12px 28px #24273520;}.directory-trigger:active{translate:0 1px;}
.directory-dialog{position:fixed;inset:auto 0 calc(24px + env(safe-area-inset-bottom));margin:0 auto;transform-origin:bottom center;}
.directory-dialog::backdrop{background:#e8e9ef99;backdrop-filter:blur(4px);animation:directory-backdrop .25s ease-out;}.directory-item{transition:background .16s ease,color .16s ease;}
@keyframes directory-backdrop{from{opacity:0}to{opacity:1}}
@media(max-width:480px){.directory-dialog{bottom:calc(12px + env(safe-area-inset-bottom));}}

.directory-trigger{border-radius:999px;padding:12px 15px;min-width:235px;gap:13px;box-shadow:0 2px 0 #dfe0e7,0 8px 24px #24273512;}
.directory-trigger .jump-ghost{width:18px;height:20px;color:#62697c;animation:jump-bob 4s ease-in-out infinite;}
.directory-trigger kbd{border:0;border-radius:9px;background:#e7e8ed;padding:5px 8px;}
@keyframes jump-bob{0%,80%,100%{transform:translateY(0)}90%{transform:translateY(-2px)}}

.directory-dialog{max-height:min(510px,calc(100dvh - 48px));width:min(480px,calc(100vw - 32px));}
.directory-heading{align-items:start;padding:17px 18px 13px;}.directory-heading h2{font:12px var(--font-mono);color:var(--f-high);}.preview-subtitle{font:12px/1.5 var(--font-sans);color:var(--f-mute);margin:6px 0 0;}
.category-item{width:100%;border:0;border-bottom:1px solid #d7d8df66;background:transparent;text-align:left;cursor:pointer;min-height:51px;padding-block:9px;}.category-chevron{margin-left:auto;color:#969cad;}.directory-results{max-height:370px;}.directory-description{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;}.directory-copy{flex:1;min-width:0;}.preview-title-line{display:flex;align-items:baseline;gap:12px;justify-content:space-between;}.preview-date{font:8px var(--font-mono);color:var(--f-mute);white-space:nowrap;}.preview-item{min-height:61px;}.is-preview .directory-description{-webkit-line-clamp:2;line-height:1.5;}.preview-more{display:block;padding:14px 10px 8px;font:9px var(--font-mono);color:var(--f-mute);text-decoration:none;}.preview-thumb{width:42px;height:38px;background:var(--b-med);border:1px solid var(--line);border-radius:5px;overflow:hidden;flex:none;}.preview-thumb img{width:100%;height:100%;object-fit:cover;}.preview-work{display:grid;grid-template-columns:1fr 1fr;gap:3px;}.preview-work .preview-item{gap:9px;padding:10px 8px;min-width:0;}.preview-work .directory-name{font-size:10px;}.preview-work .directory-description{font-size:11px;}.preview-work .preview-more{grid-column:1/-1;}.preview-photos{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px 12px;}.preview-photos .preview-item{display:block;padding:0;border:0;}.preview-photos .preview-thumb{width:100%;height:auto;aspect-ratio:1;display:block;}.preview-photos .directory-copy{display:none;}.preview-photos .preview-more{grid-column:1/-1;}.search-slash{font:14px var(--font-mono);color:#8e94a5;}@media(max-width:420px){.preview-work{grid-template-columns:1fr;}.preview-work .preview-item{min-height:55px;}.preview-date{font-size:7px;}}
</style>
