---
import { getCollection } from "astro:content";
import { recognition } from "~/data/recognition";
import { photos } from "~/data/photos";
import { projects } from "~/data/projects";
const entries = [
 {title:'Home',description:'A short introduction.',href:'/',color:'blue',icon:'M3 11 12 3l9 8M5 10v11h5v-7h4v7h5V10'},
 {title:'Work',description:'Projects, demos, and open source.',href:'/work',color:'yellow',icon:'M8 7V4h8v3M3 8h18v12H3zM3 12l9 3 9-3M10 14h4'},
 {title:'Notes',description:'Security, Linux, Rust, and Nix.',href:'/notes',color:'green',icon:'M5 3h14v18H5zM8 7h8M8 11h8M8 15h5'},
 {title:'Now',description:'Life lately, and the memories before it.',href:'/now',color:'pink',icon:'M12 7v5l4 2M4 5v5h5M4 10a8 8 0 1 1 0 5'},
 {title:'Photographs',description:'Places, people, and moments kept.',href:'/work#photos',color:'blue',icon:'M3 5h18v15H3zM3 16l6-6 5 5 3-3 4 4M15 8h.01'},
 {title:'Recognition',description:'CTF wins, hackathons, and appreciation.',href:'/work#recognition',color:'yellow',icon:'M8 3h8v7a4 4 0 0 1-8 0zM8 5H4v3a4 4 0 0 0 4 4M16 5h4v3a4 4 0 0 1-4 4M12 14v6M8 21h8'},
 {title:'whoami card',description:'My profile, links, and guestbook.',href:'https://whoami.cards/pwnwriter',color:'purple',icon:'M3 5h18v15H3zM7 9h3v3H7zM13 9h5M13 13h5M7 16h11'},
 {title:'Say hello',description:'Leave me a private note on whoami.',href:'https://whoami.cards/pwnwriter/connect?via=link',color:'pink',icon:'M3 5h18v14H3zM3 6l9 7 9-7'},
 {title:'GitHub',description:'Code, contributions, and experiments.',href:'https://github.com/pwnwriter',color:'green',icon:'m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16'},
 {title:'X',description:'Find me as @pwnwriter.',href:'https://x.com/pwnwriter',color:'blue',icon:'M4 3h5l11 18h-5zM20 3 4 21'},
 {title:'LinkedIn',description:'The professional side.',href:'https://www.linkedin.com/in/pwnwriter',color:'purple',icon:'M5 9v12M5 4v.1M10 21V9h4v3c1-4 6-3 6 1v8'},
 {title:'Email',description:'hi@pwnwriter.me',href:'mailto:hi@pwnwriter.me',color:'yellow',icon:'M3 5h18v14H3zM3 6l9 7 9-7'},
 {title:'Tags',description:'Browse notes by topic.',href:'/notes/tags',color:'green',icon:'M3 3h8l10 10-8 8L3 11zM7 7h.01'},
 {title:'RSS',description:'Follow new writing in your reader.',href:'/rss.xml',color:'yellow',icon:'M4 4a16 16 0 0 1 16 16M4 11a9 9 0 0 1 9 9M4 19h.01'},
 {title:'Public key',description:'My OpenPGP key.',href:'https://github.com/pwnwriter.gpg',color:'blue',icon:'M14 10a5 5 0 1 0-2 2l8 8 2-2-2-2 2-2-2-2-2 2z'},
 {title:'Source',description:'The code behind this little website.',href:'https://github.com/pwnwriter/pwnwriter.me',color:'purple',icon:'m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16'},
 {title:'Site stats',description:'A quiet look at the visitors.',href:'https://cloud.umami.is/share/tNl4j2DN3BMN3xwq/pwnwriter.me',color:'green',icon:'M5 21V12M12 21V3M19 21V8'},
 ];
const posts=(await getCollection('posts')).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());
const memories=(await getCollection('syndications')).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());

const excerpt=(text:string)=>text.replace(/```[\s\S]*?```/g,' ').replace(/!?\[([^\]]*)\]\([^)]+\)/g,'$1').replace(/<[^>]*>|[#*_>`]/g,'').replace(/\s+/g,' ').trim().slice(0,150);
const groups=[
 {key:'work',title:'Work',description:'Projects and experiments.',href:'/work',icon:entries[1].icon,items:projects.map(p=>({title:p.name,description:p.summary,href:`/work#${p.slug}`,image:p.cover?.kind==='image'?p.cover.src:p.cover?.kind==='video'?p.cover.poster:undefined}))},
 {key:'writing',title:'Writing',description:'Security, systems, and things learned.',href:'/notes',icon:entries[2].icon,items:posts.map(p=>({title:p.data.title,description:p.data.description??excerpt(p.body),href:`/notes/${p.slug}`,date:p.data.pubDate.toLocaleDateString('en-US',{month:'short',year:'numeric'}),keywords:p.data.tags.join(' ')}))},
 {key:'now',title:'Now',description:'Life lately.',href:'/now',icon:entries[3].icon,items:memories.map(p=>({title:p.data.title,description:excerpt(p.body),href:`/syndications/${p.slug}`,date:p.data.pubDate.toLocaleDateString('en-US',{month:'short',year:'numeric'})}))},
 {key:'photos',title:'Photographs',description:'Places and moments kept.',href:'/work#photos',icon:entries[4].icon,items:photos.map(p=>({title:p.alt,description:p.year,href:'/work#photos',image:p.src}))},
 {key:'recognition',title:'Recognition',description:'CTFs, hackathons, and milestones.',href:'/work#recognition',icon:entries[5].icon,items:recognition.map(p=>({title:p.title,description:p.result,href:'/work#recognition',image:(p.photo??p.image)?.src}))},
 {key:'links',title:'Elsewhere',description:'Find me around the internet.',href:'https://whoami.cards/pwnwriter',icon:entries[6].icon,items:entries.slice(6).map(p=>({title:p.title,description:p.description,href:p.href}))},
];
---
<button class="directory-trigger" type="button" aria-haspopup="dialog"><svg class="jump-ghost" width="19" height="21" viewBox="0 0 24 26" fill="none" aria-hidden="true"><path d="M4 22V11a8 8 0 0 1 16 0v11l-3-2-2.5 2-2.5-2-2.5 2L7 20z" fill="#f9f9fc" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><ellipse cx="9" cy="12" rx="1.1" ry="1.5" fill="currentColor"/><ellipse cx="15" cy="12" rx="1.1" ry="1.5" fill="currentColor"/><path d="M10.5 16q1.5 1.5 3 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg><span>Jump to…</span><kbd>/</kbd></button>
<dialog class="directory-dialog" aria-labelledby="directory-title">
  <header class="directory-heading"><div class="preview-heading"><h2 id="directory-title">Explore</h2><p class="preview-subtitle">Work, words, and a few moments.</p></div><button type="button" class="directory-close" aria-label="Close directory">×</button></header>
  <nav class="directory-results" id="directory-results" aria-label="Explore the site"></nav>
  <footer class="directory-search"><span class="search-slash" aria-hidden="true">/</span><input type="search" aria-label="Search the directory" placeholder="Search this little corner…" aria-controls="directory-results" autocomplete="off" spellcheck="false"/><button type="button" class="directory-escape" aria-label="Close directory">esc</button></footer>
</dialog>
<script id="directory-preview-data" type="application/json" set:html={JSON.stringify(groups).replaceAll('<','\\u003c')} is:inline />
<script>
interface Entry {title:string;description:string;href:string;image?:string;date?:string;keywords?:string;}
interface Group {key:string;title:string;description:string;href:string;icon:string;items:Entry[];}
const groups:Group[]=JSON.parse(document.querySelector('#directory-preview-data')!.textContent!);
const dialog=document.querySelector<HTMLDialogElement>('.directory-dialog')!;
const trigger=document.querySelector<HTMLButtonElement>('.directory-trigger')!;
const input=dialog.querySelector<HTMLInputElement>('input')!;
const results=dialog.querySelector<HTMLElement>('.directory-results')!;
const heading=dialog.querySelector('#directory-title')!;
const subtitle=dialog.querySelector('.preview-subtitle')!;
let selected=0,visible:HTMLElement[]=[],previousFocus:HTMLElement|null=null,oldOverflow='';
let closing=false,closeTimer:ReturnType<typeof setTimeout>|undefined;
let scrollX=0,scrollY=0,locked=false;
let bodyStyles={position:'',top:'',left:'',width:''};
const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');
function syncViewport(){
 if(!dialog.open)return;
 const viewport=window.visualViewport;
 dialog.style.setProperty('--directory-viewport-height',`${viewport?.height??innerHeight}px`);
 dialog.style.setProperty('--directory-keyboard-offset',`${Math.max(0,innerHeight-(viewport?.height??innerHeight)-(viewport?.offsetTop??0))}px`);
}
window.visualViewport?.addEventListener('resize',syncViewport);
window.visualViewport?.addEventListener('scroll',syncViewport);
window.addEventListener('resize',syncViewport);
function element<K extends keyof HTMLElementTagNameMap>(tag:K,className:string,text?:string){const node=document.createElement(tag);node.className=className;if(text)node.textContent=text;return node;}
function icon(path:string){const box=element('span','folder-icon');const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('viewBox','0 0 24 24');svg.setAttribute('fill','none');svg.setAttribute('stroke','currentColor');svg.setAttribute('stroke-width','1.5');svg.setAttribute('aria-hidden','true');const line=document.createElementNS('http://www.w3.org/2000/svg','path');line.setAttribute('d',path);svg.append(line);box.append(svg);return box;}
function highlight(scroll=true){
 visible.forEach((item,i)=>item.classList.toggle('is-selected',i===selected));
 const item=visible[selected];if(!item||!scroll)return;
 const bounds=results.getBoundingClientRect(),rect=item.getBoundingClientRect();
 if(rect.top<bounds.top)results.scrollTop+=rect.top-bounds.top;
 else if(rect.bottom>bounds.bottom)results.scrollTop+=rect.bottom-bounds.bottom;
}
function link(entry:Entry,group?:Group){const a=element('a','directory-item preview-item');a.href=entry.href;if(entry.image){const thumb=element('span','preview-thumb');const img=document.createElement('img');img.src=entry.image;img.alt='';img.loading='lazy';thumb.append(img);a.append(thumb);}else if(group&&['work','links'].includes(group.key)){a.append(icon(group.icon));}const copy=element('span','directory-copy');const title=element('span','preview-title-line');title.append(element('span','directory-name',entry.title));if(entry.date)title.append(element('span','preview-date',entry.date));copy.append(title,element('span','directory-description',entry.description));a.append(copy);a.addEventListener('click',close);return a;}
function render(){
 const query=input.value.toLowerCase().trim();const aliases:Record<string,string>={notes:'writing',note:'writing',blog:'writing',projects:'work',project:'work',photographs:'photos',photo:'photos',links:'links',elsewhere:'links',memories:'now'};
 const group=groups.find(g=>g.key===(aliases[query]??query));results.replaceChildren();results.className='directory-results';selected=0;
 if(!query){heading.textContent='Explore';subtitle.textContent='Work, words, and a few moments.';groups.forEach(g=>{const button=element('button','directory-item category-item');button.type='button';button.append(icon(g.icon));const copy=element('span','directory-copy');copy.append(element('span','directory-name',g.title),element('span','directory-description',g.description));button.append(copy,element('span','category-chevron','›'));button.addEventListener('click',()=>{input.value=g.key;render();input.focus({preventScroll:true});});results.append(button);});}
 else if(group){heading.textContent=group.title;subtitle.textContent=group.description;results.classList.add('is-preview',`preview-${group.key}`);const count=group.key==='work'||group.key==='photos'?6:4;group.items.slice(0,count).forEach(entry=>results.append(link(entry,group)));const more=element('a','preview-more',`All ${group.title.toLowerCase()} →`);more.href=group.href;more.addEventListener('click',close);results.append(more);}
 else{heading.textContent='Search';const words=query.split(/\s+/);const matches=[{title:'Home',description:'About Nabeen, security research and interfaces.',href:'/',keywords:'home about introduction'},...groups.flatMap(g=>g.items)].filter(entry=>words.every(word=>`${entry.title} ${entry.description} ${entry.keywords??''}`.toLowerCase().includes(word))).filter((entry,i,array)=>array.findIndex(other=>other.href===entry.href)===i);subtitle.textContent=matches.length?`${Math.min(matches.length,6)} results`:'Nothing found';matches.slice(0,6).forEach(entry=>results.append(link(entry)));if(!matches.length)results.append(element('p','directory-empty','Try work, writing, photos, or another topic.'));}
 visible=[...results.querySelectorAll<HTMLElement>('a,button')];visible.forEach((item,index)=>{item.addEventListener('pointerenter',()=>{selected=index;highlight(false);});item.addEventListener('focus',()=>{selected=index;highlight(false);});});highlight();
}
function open(){
 if(dialog.open){if(closing){clearTimeout(closeTimer);closing=false;dialog.classList.remove('is-closing');}input.focus({preventScroll:true});return;}
 previousFocus=document.activeElement as HTMLElement;scrollX=window.scrollX;scrollY=window.scrollY;
 oldOverflow=document.body.style.overflow;document.body.style.overflow='hidden';
 locked=matchMedia('(max-width:640px)').matches;
 if(locked){bodyStyles={position:document.body.style.position,top:document.body.style.top,left:document.body.style.left,width:document.body.style.width};Object.assign(document.body.style,{position:'fixed',top:`-${scrollY}px`,left:`-${scrollX}px`,width:'100%'});}
 input.value='';dialog.classList.remove('is-closing');dialog.showModal();syncViewport();render();input.focus({preventScroll:true});
}
function close(){
 if(!dialog.open||closing)return;
 if(reducedMotion.matches){dialog.close();return;}
 closing=true;dialog.classList.add('is-closing');
 closeTimer=setTimeout(()=>{if(dialog.open)dialog.close();},180);
}
trigger.addEventListener('click',open);dialog.querySelectorAll('.directory-close,.directory-escape').forEach(button=>button.addEventListener('click',close));
dialog.addEventListener('close',()=>{
 clearTimeout(closeTimer);closing=false;dialog.classList.remove('is-closing');
 document.body.style.overflow=oldOverflow;
 if(locked){Object.assign(document.body.style,bodyStyles);window.scrollTo({left:scrollX,top:scrollY,behavior:'instant'});locked=false;}
 previousFocus?.focus({preventScroll:true});
});dialog.addEventListener('cancel',event=>{event.preventDefault();close();});
dialog.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();event.stopPropagation();close();}},true);
dialog.addEventListener('click',event=>{if(event.target===dialog){const rect=dialog.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)close();}});
input.addEventListener('input',render);input.addEventListener('keydown',event=>{if(['ArrowDown','ArrowUp'].includes(event.key)){event.preventDefault();if(visible.length){selected=(selected+(event.key==='ArrowDown'?1:-1)+visible.length)%visible.length;highlight();}}if(event.key==='Enter'&&visible[selected]){event.preventDefault();visible[selected].click();}});
document.addEventListener('keydown',event=>{const typing=event.composedPath().some(node=>node instanceof HTMLElement&&(node.isContentEditable||['INPUT','TEXTAREA','SELECT'].includes(node.tagName)));if(event.key!=='/'||event.metaKey||event.ctrlKey||event.altKey||event.isComposing||event.defaultPrevented||typing)return;if(document.querySelector('dialog[open]')&&!dialog.open)return;event.preventDefault();open();});
</script>
<style is:global>
.directory-trigger{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:20;display:flex;align-items:center;gap:13px;min-width:235px;padding:12px 15px;border:1px solid #c8cad4;border-radius:999px;background:color-mix(in srgb,var(--surface) 94%,transparent);backdrop-filter:blur(12px);color:var(--f-low);font:11px var(--font-mono);box-shadow:0 2px 0 #dfe0e7,0 8px 24px #24273512;transition:box-shadow .2s,translate .2s;}
.directory-trigger:hover{translate:0 -2px;color:var(--f-high);box-shadow:0 3px 0 #dfe0e7,0 12px 28px #24273520;}.directory-trigger:active{translate:0 1px;}.directory-trigger .jump-ghost{width:18px;height:20px;color:#62697c;animation:jump-bob 4s ease-in-out infinite;}.directory-trigger kbd{margin-left:auto;border:0;border-radius:9px;background:#e7e8ed;padding:5px 8px;color:var(--f-mute);font:10px var(--font-mono);}
.directory-dialog{position:fixed;inset:auto 0 calc(24px + env(safe-area-inset-bottom));margin:0 auto;width:min(440px,calc(100vw - 32px));max-height:min(500px,calc(100dvh - 48px));padding:0;border:1px solid #d4d7e1;border-radius:18px;background:#f9f9fc;color:var(--f-high);box-shadow:0 4px 12px #25273808,0 24px 70px #25273825;overflow:hidden;transform-origin:bottom center;}
.directory-dialog[open]{display:flex;flex-direction:column;animation:directory-reveal .28s cubic-bezier(.16,1,.3,1);}.directory-dialog::backdrop{background:#e8e9ef99;backdrop-filter:blur(6px);animation:directory-backdrop .22s ease-out;}
.directory-heading{display:flex;align-items:start;justify-content:space-between;gap:12px;padding:20px 20px 14px;flex:none;}.directory-heading h2{margin:0;font:12px/1.4 var(--font-mono);color:#3c4050;letter-spacing:-.02em;}.preview-subtitle{font:12px/1.5 var(--font-sans);color:#9296a3;margin:6px 0 0;}.directory-close{display:grid;place-items:center;flex:none;width:25px;height:25px;padding:0;border:0;border-radius:7px;background:transparent;color:#8f95a3;font:21px/1 var(--font-sans);cursor:pointer;}.directory-close:hover{background:#eeeff4;color:#4e596f;}
.directory-results{overflow-y:auto;overscroll-behavior:contain;min-height:0;max-height:350px;scrollbar-width:thin;scrollbar-color:#cfd4df transparent;padding:2px 10px 10px;}
.directory-item{position:relative;display:flex;align-items:center;gap:12px;width:100%;min-height:55px;padding:9px 11px;margin:0;border:0;border-radius:10px;background:transparent;text-align:left;text-decoration:none;cursor:pointer;transition:background .15s,color .15s;}.directory-item.is-selected{background:#eceef5;}.directory-item.is-selected::before{display:none;}.directory-copy{display:flex;flex:1;flex-direction:column;gap:3px;min-width:0;}.directory-name{font:500 14px/1.35 var(--font-sans);color:#383e4d;}.directory-description{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;font:12px/1.4 var(--font-sans);color:#9296a3;}.category-chevron{margin-left:auto;color:#8e97ab;font:18px/1 var(--font-sans);opacity:0;transition:opacity .15s,translate .15s;}.is-selected .category-chevron{opacity:.8;translate:1px 0;}
.folder-icon{width:32px;height:32px;flex:none;display:grid;place-items:center;border:1px solid #dce0e9;border-radius:9px;background:#f0f2f7;color:#8491a7;transition:background .15s,border-color .15s;}.folder-icon svg{width:16px;height:16px;}.is-selected .folder-icon{background:#fafbfe;border-color:#d0d7e4;}
.directory-search{display:flex;align-items:center;gap:10px;flex:none;padding:14px 18px;margin:0;border-top:1px solid #e2e4ec;background:#f4f5f9;color:#959bab;}.search-slash{font:15px/1 var(--font-mono);color:#9ba4b6;}.directory-search input{min-width:0;flex:1;padding:0;border:0;outline:0;background:transparent;color:#414b60;font:14px/1.5 var(--font-sans);}.directory-search input::placeholder{color:#a0a5b2;}.directory-search input::-webkit-search-cancel-button{display:none;}.directory-escape{border:1px solid #dce0e9;border-radius:6px;background:#fafbfe;padding:5px 6px;color:#9097a6;font:8px var(--font-mono);cursor:pointer;}
.directory-empty{font:13px/1.5 var(--font-sans);color:var(--f-mute);padding:25px 15px;text-align:center;}.preview-title-line{display:flex;align-items:baseline;gap:12px;justify-content:space-between;}.preview-date{font:8px var(--font-mono);color:#979eac;white-space:nowrap;}.preview-item{min-height:62px;}.is-preview .directory-description{-webkit-line-clamp:2;line-height:1.5;}.preview-more{display:block;width:fit-content;padding:12px 11px 4px;font:10px var(--font-sans);color:#8591a5;text-decoration:none;}.preview-more:hover{color:#485f7d;}.preview-thumb{width:42px;height:38px;background:#eceef4;border:1px solid #e0e3eb;border-radius:7px;overflow:hidden;flex:none;}.preview-thumb img{width:100%;height:100%;object-fit:cover;}.preview-work{display:grid;grid-template-columns:1fr 1fr;gap:3px;}.preview-work .preview-item{gap:9px;padding:10px 8px;min-width:0;}.preview-work .directory-name{font-size:12px;}.preview-work .directory-description{font-size:11px;}.preview-work .preview-more{grid-column:1/-1;}.preview-photos{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px 12px;}.preview-photos .preview-item{display:block;padding:0;}.preview-photos .preview-thumb{width:100%;height:auto;aspect-ratio:1;display:block;}.preview-photos .directory-copy{display:none;}.preview-photos .preview-more{grid-column:1/-1;}
.directory-item:focus-visible,.directory-close:focus-visible,.directory-escape:focus-visible{outline:2px solid #a0adc6;outline-offset:-2px;}
.directory-dialog.is-closing[open]{animation:directory-dismiss .18s ease-in forwards;pointer-events:none;}.directory-dialog.is-closing::backdrop{animation:directory-backdrop-out .18s ease-in forwards;}
@keyframes directory-reveal{from{opacity:0;transform:perspective(1100px) translateY(18px) rotateX(4deg) scale(.97)}to{opacity:1;transform:perspective(1100px) translateY(0) rotateX(0) scale(1)}}@keyframes directory-dismiss{from{opacity:1;transform:translateY(0) scale(1)}to{opacity:0;transform:translateY(12px) scale(.98)}}@keyframes directory-backdrop{from{opacity:0}to{opacity:1}}@keyframes directory-backdrop-out{from{opacity:1}to{opacity:0}}@keyframes jump-bob{0%,80%,100%{transform:translateY(0)}90%{transform:translateY(-2px)}}
@media(max-width:640px){.directory-dialog{bottom:calc(var(--directory-keyboard-offset,0px) + 10px + env(safe-area-inset-bottom));max-height:calc(var(--directory-viewport-height,100dvh) - 24px - env(safe-area-inset-bottom));width:calc(100vw - 24px);border-radius:16px;}.directory-search{padding:12px 14px;}.directory-search input{font-size:16px;}.directory-results{flex:1 1 auto;max-height:none;-webkit-overflow-scrolling:touch;}.directory-heading{padding:17px 17px 12px;}body:has(.directory-dialog[open]) .directory-trigger{opacity:0;pointer-events:none;}}
@media(max-width:420px){.preview-work{grid-template-columns:1fr;}.preview-work .preview-item{min-height:55px;}.preview-date{font-size:7px;}}
@media(prefers-reduced-motion:reduce){.directory-dialog[open],.directory-dialog.is-closing[open],.directory-dialog::backdrop,.directory-dialog.is-closing::backdrop,.directory-trigger .jump-ghost{animation:none;}.directory-item,.category-chevron,.directory-trigger{transition:none;}}
</style>
